+static void Mt2009DigiQol_OnChat(const char* c_szName, const char* c_szChat)
+{
+	if (!s_bDigiChatLog || !c_szChat || !*c_szChat)
+		return;
+
+	CreateDirectoryA("logs", NULL);
+	const time_t now = time(NULL);
+	struct tm lt = *localtime(&now);
+	char szFile[64];
+	strftime(szFile, sizeof(szFile), "logs/czat_%Y-%m-%d.txt", &lt);
+	if (FILE* fp = fopen(szFile, "ab"))
+	{
+		char szTime[16];
+		strftime(szTime, sizeof(szTime), "%H:%M:%S", &lt);
+		const std::string text = DigiPlainText(c_szChat);
+		if (c_szName)
+			fprintf(fp, "[%s] [szept: %s] %s\r\n", szTime, c_szName, text.c_str());
+		else
+			fprintf(fp, "[%s] %s\r\n", szTime, text.c_str());
+		fclose(fp);
+	}
+}
+
+static PyObject* digiAppSetHideEffects(PyObject* poSelf, PyObject* poArgs)
+{
+	int iBuff, iSkill;
+	if (!PyTuple_GetInteger(poArgs, 0, &iBuff) || !PyTuple_GetInteger(poArgs, 1, &iSkill))
+		return Py_BuildException();
+	s_bDigiHideBuff = iBuff != 0;
+	s_bDigiHideSkill = iSkill != 0;
+	return Py_BuildNone();
+}
+
+static PyObject* digiAppSetChatLog(PyObject* poSelf, PyObject* poArgs)
+{
+	int iOn;
+	if (!PyTuple_GetInteger(poArgs, 0, &iOn))
+		return Py_BuildException();
+	s_bDigiChatLog = iOn != 0;
+	return Py_BuildNone();
+}
+
+static PyObject* digiChrmgrSetShopsVisible(PyObject* poSelf, PyObject* poArgs)
+{
+	int iVisible;
+	if (!PyTuple_GetInteger(poArgs, 0, &iVisible))
+		return Py_BuildException();
+
+	s_bDigiShopsHidden = iVisible == 0;	// ikashop entities: CPythonIkarusShop::RenderEntities
+
+	CPythonCharacterManager& rkChrMgr = CPythonCharacterManager::Instance();
+	CInstanceBase* pkMain = rkChrMgr.GetMainInstancePtr();
+	for (CPythonCharacterManager::CharacterIterator it = rkChrMgr.CharacterInstanceBegin(); it != rkChrMgr.CharacterInstanceEnd(); ++it)
+	{
+		CInstanceBase* pkInst = *it;
+		if (!pkInst || pkInst == pkMain || !pkInst->IsShop())
+			continue;
+		if (iVisible)
+			pkInst->Show();
+		else
+			pkInst->Hide();
+	}
+	return Py_BuildNone();
+}
+
+static void Mt2009DigiQol_AddFunctions(const char* c_szModule, PyMethodDef* pMethods)
+{
+	PyObject* poModule = PyImport_AddModule(c_szModule);	// borrowed; Py_InitModule later reuses it
+	if (!poModule)
+		return;
+	for (PyMethodDef* p = pMethods; p->ml_name; ++p)
+		PyModule_AddObject(poModule, p->ml_name, PyCFunction_New(p, NULL));
+}
+
+// UserInterface.cpp (RunMainScript's module init) declares this where it calls it.
+void Mt2009DigiQol_RegisterPython()
+{
+	static PyMethodDef s_appMethods[] =
+	{
+		{ "SetHideEffects",		digiAppSetHideEffects,		METH_VARARGS, NULL },
+		{ "SetChatLog",			digiAppSetChatLog,			METH_VARARGS, NULL },
+		{ NULL, NULL, 0, NULL },
+	};
+	static PyMethodDef s_chrmgrMethods[] =
+	{
+		{ "SetShopsVisible",	digiChrmgrSetShopsVisible,	METH_VARARGS, NULL },
+		{ NULL, NULL, 0, NULL },
+	};
+	Mt2009DigiQol_AddFunctions("app", s_appMethods);
+	Mt2009DigiQol_AddFunctions("chrmgr", s_chrmgrMethods);
+}
