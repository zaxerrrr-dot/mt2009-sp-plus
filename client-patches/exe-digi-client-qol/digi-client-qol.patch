+#ifdef ENABLE_DIGI_CLIENT_QOL
+	// The package's lists: the shaman's buffs on the target, and the warrior's, sura's, ninja's and shaman's skill auras.
+	const char* const c_aszDigiBuffEffects[] =
+	{
+		"pc/shaman/effect/3hosin_loop.mse",
