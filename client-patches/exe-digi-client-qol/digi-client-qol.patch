+	enum { DIGI_EFFECT_NONE, DIGI_EFFECT_BUFF, DIGI_EFFECT_SKILL };
+	bool s_bDigiHideBuff = false;
+	bool s_bDigiHideSkill = false;
+	bool s_bDigiChatLog = false;
+	bool s_bDigiShopsHidden = false;
+	std::map<std::string, int> s_mapDigiEffectKind;	// by file name (effect data may be reloaded at another address)
