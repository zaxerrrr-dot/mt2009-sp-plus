<?xml version="1.0" encoding="utf-8"?>
<!-- MT2009 PLUS: "Dodaj własny serwer VPS" - the same dialog as in MT2009-Aktualizator,
     in the colours of the patcher window. -->
<Window x:Class="N2_Patcher.VpsWindow" Title="Dodaj własny serwer VPS" Width="520" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="..\Resources\icon.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#FFEBC7B5" />
    <SolidColorBrush x:Key="Dim" Color="#FFB89C8C" />
    <SolidColorBrush x:Key="Gold" Color="#FFF0C040" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,3,0,3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF3A120C" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="CaretBrush" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="#FF9A5A2A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,3,4,3" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="MainButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FF632317" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Name="b" CornerRadius="2" BorderThickness="1" BorderBrush="#FF7A3A10">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FFFFD63A" Offset="0" />
                  <GradientStop Color="#FFE19F26" Offset="0.45" />
                  <GradientStop Color="#FFC5471A" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#FFFFEF6A" Offset="0" />
                      <GradientStop Color="#FFF0B43A" Offset="0.45" />
                      <GradientStop Color="#FFDA6A2A" Offset="1" />
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Name="b" CornerRadius="2" BorderThickness="1" BorderBrush="#FF9A5A2A" Background="#FF3A120C">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF5A1E12" />
                <Setter TargetName="b" Property="BorderBrush" Value="#FFF0C040" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderThickness="2" CornerRadius="3" Padding="18,10,18,18">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFD63A" Offset="0" />
        <GradientStop Color="#FFE3602A" Offset="0.5" />
        <GradientStop Color="#FFFFB030" Offset="1" />
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2E0D09" Offset="0" />
        <GradientStop Color="#FF1A0605" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <StackPanel>
      <Grid Background="#00FFFFFF" MouseLeftButtonDown="TitleMouseDown" Margin="0,0,0,8">
        <TextBlock Text="DODAJ WŁASNY SERWER VPS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
        <Image Name="btnClose" HorizontalAlignment="Right" VerticalAlignment="Center" Width="21" Height="21" Cursor="Hand" ToolTip="Zamknij" MouseLeftButtonDown="CloseClick">
          <Image.Style>
            <Style>
              <Setter Property="Image.Source" Value="..\Resources\btn_close.png" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Image.Source" Value="..\Resources\btn_close_hover.png" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Image.Style>
        </Image>
      </Grid>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" Margin="0,0,0,10" Text="Serwer pojawi się na liście serwerów w grze jako &quot;Online: &lt;nazwa&gt;&quot;. Zwykle wystarczy wpisać nazwę i IP - porty zmieniaj tylko wtedy, gdy właściciel serwera poda inne." />
      <Border BorderBrush="#FF6A3A1A" BorderThickness="1" Padding="10,4,10,6" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Miejsce na liście" Foreground="{StaticResource Gold}" FontWeight="Bold" Margin="0,0,0,2" />
          <RadioButton Name="radio1" GroupName="slot" Checked="SlotChanged" />
          <RadioButton Name="radio2" GroupName="slot" Checked="SlotChanged" />
        </StackPanel>
      </Border>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="34" />
          <RowDefinition Height="42" />
          <RowDefinition Height="34" />
          <RowDefinition Height="34" />
          <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Nazwa serwera *" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Name="txtName" Width="290" MaxLength="80" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Text="IP lub domena VPS *" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Name="txtHost" Width="290" MaxLength="253" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Text="Port logowania" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Name="txtAuth" Width="90" MaxLength="5" VerticalAlignment="Center" />
        <TextBlock Grid.Row="3" Text="Port kanału 1 (CH1)" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Name="txtChannel" Width="90" MaxLength="5" VerticalAlignment="Center" />
        <TextBlock Grid.Row="4" Text="Liczba kanałów" VerticalAlignment="Center" />
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton Name="channels1" GroupName="channels" Content="1" Margin="0,0,24,0" />
          <RadioButton Name="channels2" GroupName="channels" Content="2" />
        </StackPanel>
      </Grid>
      <TextBlock Foreground="{StaticResource Dim}" FontSize="12" Margin="0,4,0,16" Text="Domyślnie: logowanie 11000, CH1 13000, CH2 13010 (kanał 1 + 10)." />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Name="btnSave" Content="Zapisz" Style="{StaticResource MainButton}" Click="SaveClick" IsDefault="True" />
        <Button Grid.Column="2" Name="btnRemove" Content="Usuń z tego miejsca" Style="{StaticResource DarkButton}" Click="RemoveClick" />
        <Button Grid.Column="4" Content="Zamknij" Style="{StaticResource DarkButton}" Click="CloseButtonClick" IsCancel="True" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
