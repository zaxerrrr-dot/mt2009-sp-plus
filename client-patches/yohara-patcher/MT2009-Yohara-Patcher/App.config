<?xml version="1.0" encoding="utf-8"?>
<!--
  MT2009 PLUS - Yohara Patcher - ustawienia (plik obok programu: MT2009-Yohara-Patcher.exe.config).
  Plik jest opcjonalny: brak pliku albo brak klucza = wartość wbudowana w program (te same co tutaj).
  To NIE jest plik patchera 2.x (MT2009-Patcher.exe.config) - oba patchery mają osobne ustawienia.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Serwer aktualizacji Yohary (tylko on - nigdy GitHub ani serwer 2.x). -->
    <add key="MirrorUrl" value="http://141.94.100.53/aktualizacje/yohara/" />
    <!-- Kanał: pusty = domyślny kanał serwera (channels.json), albo "test" / "stable". -->
    <add key="Channel" value="" />
    <!-- true = patcher zamyka się po uruchomieniu gry. -->
    <add key="CloseOnClientStart" value="true" />
    <!-- Lewe przyciski: strona, Discord (pusty = przycisk ukryty). -->
    <add key="Homepage" value="https://metin2sp.pl" />
    <add key="Discord" value="https://discord.com/invite/vGE3T9gpm" />
    <add key="Vote4Coins" value="" />
    <!-- Gra i program zębatki w folderze klienta (brak pliku = zębatka ukryta). -->
    <add key="Start" value="metin2client.exe" />
    <add key="Config" value="config.exe" />
  </appSettings>
</configuration>
