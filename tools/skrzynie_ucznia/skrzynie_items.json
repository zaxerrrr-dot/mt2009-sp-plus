 "itemdesc": {
  "38103": "38103\tPrzekąska Appaloosa\tPrzedłuża życie twojego Appaloosa o 7 dni.",
  "56000": "56000\tAppaloosa\tPieczęć ta przywołuje twojego łagodnego kucyka Appaloosa. Obdarza swoich jeźdźców +10 szybkością ruchu.",
  "56001": "56001\tBilet Podróżniczy\tZwój teleportuje cię tam i z powrotem między dwoma wioskami twojego królestwa. Można go użyć 5 razy i jest dostępny od poziomu 10.",
  "76009": "76009\tZwój Boga Smoków\tZwiększa szansę na ulepszenie przedmiotu o 10% i przedmiot nie ulega zniszczeniu, gdy ulepszenie zawiedzie. W przypadku niepowodzenia jakość przedmiotu jest redukowana o 1 poziom. Niezdatny do handlu.",
  "76016": "76016\tZwój Błogosławieństwa\tUsuwa ryzyko zniszczenia przedmiotu podczas jego ulepszania. Jeżeli ulepszanie się nie powiedzie, to jakość przedmiotu jest redukowana o 1 poziom. Przedmiot niezdatny do handlu.",
  "76017": "76017\tMikstura Ataku +15\tZwiększa twoją szybkość ataku o 15% na okres 30 minut. Niezdatna do handlu.",
  "76018": "76018\tMikstura Ataku +20\tZwiększa twoją szybkość ataku o 20% na okres 30 minut. Niezdatna do handlu.",
  "76026": "76026\tZwój Egzorcyzmu\tUwalnia cię od klątwy złego ducha, jeśli nauka się nie powiedzie. Za pomocą tego zwoju możesz przeczytać w ciągu jednego dnia kolejny dokument umiejętności. Niezdatny do handlu.",
  "76034": "76034\tRada Pustelnika\tPodnosi szansę na pomyślne przeczytanie następnej Księgi Umiejętności (lub Kamienia Duchowego). Niezdatna do handlu.",
  "76035": "76035\tŻycie Boga Smoków\tZwiększa maksymalną ilość PŻ o 20% na 30 minut. Niezdatne do handlu.",
  "76036": "76036\tAtak Boga Smoków\tZwiększa twoją siłę ataku o 20% na 30 minut. Niezdatny do handlu.",
  "76037": "76037\tRękawica Złodzieja\tZwiększają o 50% twoją szansę na zdobycie przedmiotów. Po aktywowaniu nie można już zdezaktywować ich działania. Czas trwania: 7 dni. Niezdatne do handlu.",
  "76038": "76038\tMedal Szczęścia\tPodwaja szansę na zdobycie Yang. Czas trwania: 7 dni. Niezdatny do handlu."
 },
