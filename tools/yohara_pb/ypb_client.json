"itemdesc": {
"31108": "31108\tMały Kamień Przebudzenia\tKamień ten daje ci 2% szansy na wyprodukowanie przedmiotów wypełnionych mocą smoka!",
"31109": "31109\tDrobny Kam. Przebudzenia\tKamień ten daje ci 5% szansy na wyprodukowanie przedmiotów wypełnionych mocą smoka!",
"31110": "31110\tŁadny Kam. Przebudzenia\tKamień ten daje ci 10% szansy na wyprodukowanie przedmiotów wypełnionych mocą smoka!",
"31111": "31111\tZacny Kam. Przebudzenia\tKamień ten daje ci 15% szansy na wyprodukowanie przedmiotów wypełnionych mocą smoka!",
"31112": "31112\tSilny Kam. Przebudzenia\tKamień ten daje ci 25% szansy na wyprodukowanie przedmiotów wypełnionych mocą smoka!",
"31113": "31113\tDusza Przebudzenia\tMateriał do uszlachetnienia",
"31114": "31114\tZwykła Skóra\tMateriał do uszlachetnienia",
"31115": "31115\tKowadło\tMateriał do uszlachetnienia",
"31117": "31117\tCienka Przędza\tMateriał do uszlachetnienia",
"31120": "31120\tŚrodek Ścierny\tMateriał do uszlachetnienia",
"31121": "31121\tStal\tMateriał do uszlachetnienia",
"31149": "31149\tMocny Sznur\tMateriał do uszlachetnienia",
"31141": "31141\tSkrzynia Razadora (PB)\tTajemnicza skrzynia Razadora może zawierać materiały do uszlachetnienia oraz kamienie Przebudzenia.",
"31142": "31142\tSkrzynia Nemere (PB)\tTajemnicza skrzynia Nemere może zawierać materiały do uszlachetnienia oraz kamienie Przebudzenia.",
"31143": "31143\tSkrzynia Przebudzenia\tTajemnicza skrzynia Przebudzenia może zawierać materiały do uszlachetnienia oraz kamienie Przebudzenia.",
"31144": "31144\tLekarstwo Iluzji\tLekarstwo sporządzone z liści życia. Po zażyciu zostaną natychmiast regenerowane PŻ i PE.",
"31145": "31145\tLiście Życia\tSkładnik do produkcji lekarstwa iluzji.",
"31146": "31146\tKsiążka Przebudzenia\tPotrzebna, by wejść do lochu Przebudzenia.",
"31187": "31187\tZłota Zębatka (PB)\tAktywuje mechanizm ukryty w Steli Isfet.",
"31188": "31188\tKamień Maat (PB)\tMaat jest boginią sprawiedliwości i czuwa nad ładem i chaosem.",
"31189": "31189\tMroźny Klucz (PB)\tKlucz jest zimny jak lód. Otwiera dostęp na trzecie piętro Strażnicy Nemere. Mogą go użyć tylko szamani.",
"31190": "31190\tGwiazda Północy (PB)\tPieczęć z czystego lodu. Otwiera dostęp na szóste piętro Strażnicy Nemere.",
"31191": "31191\tKlucz Lod. Kwiatu (PB)\tLodowy klucz otwiera dostęp na dziewiąte piętro Strażnicy Nemere."
}
}
