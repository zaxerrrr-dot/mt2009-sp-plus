"itemdesc": {
"27591": "27591\tWędka Węglowa\tPrzy pomocy tej wysokiej jakości wędki z włókna węglowego złapiesz wyjątkowo grube ryby. Jest lepsza od zwykłej wędki (jak wędka +22). Działa 30 dni (czas płynie także poza grą), potem znika. Nie da się jej ulepszyć ani przekazać.",
"27621": "27621\tWędzisko\tMateriał do budowy Wędki Węglowej (u Rybaka). Ze Skrzyni Nimfy Wodnej.",
"27622": "27622\tPrzelotka\tMateriał do budowy Wędki Węglowej (u Rybaka). Ze Skrzyni Nimfy Wodnej.",
"27623": "27623\tRękojeść\tMateriał do budowy Wędki Węglowej (u Rybaka). Ze Skrzyni Nimfy Wodnej.",
"27624": "27624\tWłókno Węglowe\tMateriał do budowy Wędki Węglowej (u Rybaka). Ze Skrzyni Nimfy Wodnej.",
"27625": "27625\tSkrzynia Nimfy Wodnej\tSkrzynia z Królestwa Duchów Wodnych. Otwórz ją za pomocą Klucza Nimfy Wodnej.",
"27797": "27797\tZłoty Tuńczyk\tBardzo rzadka zdobycz. Jego łuski błyszczą niczym płynne złoto! Kliknij prawym przyciskiem: wypuść go, pokrój albo użyj jako przynęty.",
"27824": "27824\tWężogłów\tSłodkowodna ryba drapieżna występująca w tropikach.",
"27825": "27825\tSkaber\tRyba występująca tylko w wodach płynących.",
"27826": "27826\tKrab Królewski\tTen gatunek kraba zwany jest ze względu na swój rozmiar krabem gigantem.",
"27827": "27827\tRak Niebieski\tTen gatunek skorupiaka prowadzi nocny tryb życia, a dnie spędza w swojej kryjówce.",
"27854": "27854\tMartwy Wężogłów\tŚwietnie nadaje się do upieczenia nad ogniskiem.",
"27855": "27855\tMartwy Skaber\tŚwietnie nadaje się do upieczenia nad ogniskiem.",
"27856": "27856\tMartwy Krab Królewski\tŚwietnie nadaje się do upieczenia nad ogniskiem.",
"27857": "27857\tMartwy Rak Niebieski\tŚwietnie nadaje się do upieczenia nad ogniskiem.",
"27884": "27884\tPieczony Wężogłów\tZwiększa twoją odporność na ziemię o 10% na 10 minut.",
"27885": "27885\tPieczony Skaber\tZwiększa twoją odporność na lód o 10% na 10 minut.",
"27886": "27886\tPieczony Krab Królewski\tZwiększa twoją odporność na ciemność o 10% na 10 minut.",
"27887": "27887\tPieczony Rak Niebieski\tZwiększa otrzymywane doświadczenie o 100% na 30 minut.",
"55004": "55004\tKsięga Dzikiego Zwierza\tKsięga do trenowania zwierzaka (dziki zwierzak).",
"55005": "55005\tKsięga Dzielnego Zwierza\tKsięga do trenowania zwierzaka (dzielny zwierzak).",
"76033": "76033\tWino Kwiatu Brzoskwini+\tMikstura, która natychmiastowo regeneruje o 800 punktów twoje PŻ."
},
