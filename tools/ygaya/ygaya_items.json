"itemdesc": {
"95927": "95927\tGaya\tDrogocenna waluta Yohary. Oszlifuj 30 Kamyków u Statuy Wojownika w Porcie Nowego Kontynentu (z Kamieniem Duszy +0 do +3 i 15 000 Yang - szansa 70%), a otrzymasz 3 Gaya. Płacisz nią w Portowym Sklepie Gaya, u kowali zestawów, u Statuy Węży, Tajemniczego Ołtarza i Mistrza Chi. Nie można jej wymieniać z innymi graczami.",
"39063": "39063\tReset Sklepu Gaya\tResetuj Sklep Gaya jeszcze przed upływem 5 godzin i sprawdź nowe cenne przedmioty. Użyj w Portowym Sklepie Gaya (Statua Wojownika w Porcie Nowego Kontynentu).",
"39064": "39064\tRozszerzenie Sklepu Gaya\tDodaj do Sklepu Gaya kolejny slot na cenne oferty przedmiotów, rozpoczynając od pierwszego slotu w drugim rzędzie z lewej. Użyj w Portowym Sklepie Gaya (Statua Wojownika w Porcie Nowego Kontynentu).",
"39117": "39117\tKupon Zwierzaka Żywiołu\tGeneruje przy Statui Wojownika w porcie zwierzaka żywiołu twojego wyboru (2 kupony, 10 Gaya i 100 000 Yang za skrzynkę).",
"53581": "53581\tSkrzynka Żywiołaka Ognia\tTwój zwierzak, mały Żywiołak Ognia, podgrzewa skrzynkę tak długo, dopóki go z niej nie uwolnisz. Otwórz ją, aby otrzymać pieczęć: Mały Żywiołak Ognia (15 dni).",
"53582": "53582\tSkrzynka Żywiołaka Lodu\tTwój zwierzak, mały Żywiołak Lodu, mrozi skrzynkę tak długo, dopóki go z niej nie uwolnisz. Otwórz ją, aby otrzymać pieczęć: Mały Żywiołak Lodu (15 dni).",
"53583": "53583\tSkrz. Żywioł. Błyskawicy\tTwój zwierzak, mały Żywiołak Błyskawice, ładuje skrzynkę elektrycznie tak długo, dopóki go z niej nie uwolnisz. Otwórz ją, aby otrzymać pieczęć: Mały Żywiołak Błyskawicy (15 dni).",
"53584": "53584\tSkrzynka Żywioł. Wiatru\tTwój zwierzak, mały Żywiołak Wiatru, sprawia, że w skrzynce szaleje wichura tak długo, dopóki go z niej nie uwolnisz. Otwórz ją, aby otrzymać pieczęć: Mały Żywiołak Wiatru (15 dni).",
"53585": "53585\tSkrzynka Żywiołaka Ziemi\tTwój zwierzak, mały Żywiołak Ziemi, obciąża skrzynkę tak długo, dopóki go z niej nie uwolnisz. Otwórz ją, aby otrzymać pieczęć: Mały Żywiołak Ziemi (15 dni).",
"53586": "53586\tSkrzynka Żywiołaka Mroku\tTwój zwierzak, mały Żywiołak Mroku, sprawia, że ze skrzynka roztacza tak długo mrok, dopóki go z niej nie uwolnisz. Otwórz ją, aby otrzymać pieczęć: Mały Żywiołak Mroku (15 dni)."
},
