"itemdesc": {
"50641": "50641\tRuda Jadeitu Słońca\tMożna przerobić na obszarze gildii na jadeit słońca.",
"50642": "50642\tRuda Jadeitu Nocy\tMożna przerobić na obszarze gildii na jadeit nocy.",
"50643": "50643\tRuda Jadeitu Dymu\tMożna przerobić na obszarze gildii na jadeit dymu.",
"50644": "50644\tRuda Jadeitu Mgły\tMożna przerobić na obszarze gildii na jadeit mgły.",
"50663": "50663\tJadeit Dymu\tMateriał do produkcji akcesoriów z jadeitu dymu. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31228": "31228\tŁuska Argosa\tMateriał do produkcji akcesoriów z jadeitu dymu. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31233": "31233\tKamień Wężowy\tMateriał do ulepszania zbroi wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31234": "31234\tKamień Wężowy+\tMateriał do ulepszania zbroi wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31257": "31257\tWzór Wężowy\tMateriał do produkcji zbroi wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31258": "31258\tJedwab Wężowy\tMateriał do produkcji zbroi wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"70428": "70428\tPył Wężowy\tDodaje 1 minutę do licznika instancji. Materiał do ulepszania zbroi wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31236": "31236\tBiała Smocza Łuska\tMateriał do ulepszania broni wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31237": "31237\tKamień Duchowy Płn. W.\tMateriał do ulepszania broni wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31242": "31242\tKamień Broni Płn. Wiatru\tMateriał do ulepszania broni wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31243": "31243\tKamień Broni Płn. W+\tMateriał do ulepszania broni wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31244": "31244\tKamień Rękawic Płn. W.\tMateriał do ulepszania rękawic wężowych. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31259": "31259\tKowadło Płn. Wiatru\tMateriał do ulepszania broni wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31263": "31263\tKamień Szlif. Płn. W.\tMateriał do ulepszania broni wężowej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31239": "31239\tPołyskująca Biała Perła\tWspaniały skarb z wnętrza połyskującej muszli. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31240": "31240\tPołyskująca Nieb. Perła\tWspaniały skarb z wnętrza połyskującej muszli. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31241": "31241\tPołyskująca Krwawa Perła\tWspaniały skarb z wnętrza połyskującej muszli. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"31238": "31238\tPołyskująca Muszla\tWewnątrz tej wspaniałej muszli może ukrywać się połyskująca perła.",
"95735": "95735\tPiorunowe Zioło\tZioło zmienione przez moc Sunga Mahi. Wymagane do sporządzania piorunowych eliksirów. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"95736": "95736\tKwiat Północnego Wiatru\tZioło zmienione przez moc Sunga Mahi. Wymagane do sporządzania eliksirów północnego wiatru. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"50737": "50737\tZiemne Pnącze\tZioło zmienione przez moc Sunga Mahi. Wymagane do sporządzania eliksirów ziemi. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"50739": "50739\tPusty Eliksir Mocy\tPusta butelka, wymagana do sporządzenia eliksirów mocy. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"50740": "50740\tPusty Eliksir Odp.\tPusta butelka, wymagana do sporządzenia eliksirów odporności. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"83065": "83065\tLosowa Skrzynia Skarbów\tW tej tajemniczej skrzyni skrywa się jeszcze jedna szkatułka! Z zewnątrz nie można jednak rozpoznać, jaka to jest szkatułka.",
"83066": "83066\tLos. Klucz do Skrz. Sk.\tTen tajemniczy klucz zamienia się przy zastosowaniu w inny klucz do skrzyni skarbów! Wcześniej nie można jednak rozpoznać, w jaki klucz się zamieni.",
"83067": "83067\tSkrzynia z Bransoletką\tTa mocno zamknięta skrzynia zawiera bransoletkę. Aby ją otworzyć, potrzebny jest idealny klucz.",
"83054": "83054\tIdealny Klucz\tZnakomicie wykuty klucz z magicznego kryształu. Potrzebny do otworzenia idealnej skrzyni.",
"70410": "70410\tZamarznięty Klucz\tKlucz wymagany, by wejść do Głębi Północnego Wiatru.",
"50527": "50527\tMikstura Talentu\tPotrzebna, by udoskonalić 9. umiejętność od G1 do P - każdy stopień wymaga jednej udanej próby (szansa ok. 30%, Rada Pustelnika ją zwiększa). Zużywa punkty rangi (nieudana próba mniej), nie działa przy randze -19 000 i niższej. Można jej używać co 8-12 godzin (Zwój Egzorcyzmu skraca czas oczekiwania).",
"50336": "50336\tKsięga Misji (W.Płn.W.)\tZawiera misję w Wąwozie Północnego Wiatru, za którą otrzymasz nagrodę, jeśli ją pomyślnie ukończysz. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"72740": "72740\tLicencja Najemnika\tUżywając tej licencji możesz rekrutować najemnika. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"49991": "49991\tOgnista Runa Aury (10)\tMateriał do ulepszania szaty aury. Udaj się do Theowahdana, aby ulepszyć swoją szatę aury. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"49992": "49992\tOgnista Runa Aury (50)\tMateriał do ulepszania szaty aury. Udaj się do Theowahdana, aby ulepszyć swoją szatę aury. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"49993": "49993\tOgnista Runa Aury (100)\tMateriał do ulepszania szaty aury. Udaj się do Theowahdana, aby ulepszyć swoją szatę aury. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"70401": "70401\tSztandar Czaszki\tPod tym sztandarem możesz wejść do Piekielnej Wieży Sunga Mahi. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55003": "55003\tKsięga Młodego Zwierza\tZa pomocą następujących przedmiotów możesz podnieść poziom swojego zwierzaka (dziki zwierzak): 10x Księga Młodego Zwierza, 10x Worek Z Pajęczymi Jajami , 10x Biała Wstęga+, 10x Shuriken, 10x Ozdobna Spinka Do Włosów, 5x Czarny Uniform+, 5x Kawałek Lodu+. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55050": "55050\tJazda (Zwinne Kopyta)\tZwiększa szybkość ruchu, gdy podróżujesz na nim przez krótki czas. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55051": "55051\tJazda Konna (PD)\tZwiększa bonus PD podczas podróży (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55052": "55052\tJazda (Gwałt. Wichura)\tZwiększa szybkość ataku, gdy podróżujesz na nim przez krótki czas. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55053": "55053\tJazda (Bezszelest. Chód)\tAktywuje \"Bezszelestny Chód\", jeśli NIE podróżujesz na koniu. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55054": "55054\tJazda (Nieśmiertelność)\tStajesz się przez 3 sek. niezwyciężony, jeśli twoje PŻ spadną poniżej 30%. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55055": "55055\tJazda (Brak Odrzutu)\tGdy zaatakujesz potwora, nie zostanie odepchnięty przez krótki czas. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55056": "55056\tJazda Konna (losowo)\tNadaje losową umiejętność konną. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55057": "55057\tJazda Konna (Wojownik)\tSiła w walce z wojownikiem (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55058": "55058\tJazda Konna (Ninja)\tSiła w walce z ninja (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55059": "55059\tJazda Konna (Sura)\tSiła w walce z sura (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55060": "55060\tJazda Konna (Szaman)\tSiła w walce z szamanem (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55061": "55061\tJazda Konna (Likan)\tSiła w walce z Likanami (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55062": "55062\tJazda (umiej. konne)\tPotężne umiejętności sprawiają, że twój koń jest pożyteczniejszy. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55063": "55063\tJazda (W. SungMa. SIŁA)\tZwiększa wolę SungMa (SIŁA) podczas walki na grzbiecie konia. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55064": "55064\tJazda (W. SungMa. WIT)\tZwiększa wolę SungMa (WIT) podczas walki na grzbiecie konia. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55065": "55065\tJazda (W. SungMa. ODP)\tZwiększa wolę SungMa (ODP) podczas walki na grzbiecie konia. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55066": "55066\tJazda (W. SungMa. INT)\tZwiększa wolę SungMa (INT) podczas walki na grzbiecie konia. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)",
"55067": "55067\tJazda Konna (Precyzja)\tZwiększa precyzję podczas jazdy konnej. (Na razie bez zastosowania - przyjdzie z kolejną aktualizacją Yohary.)"
}
}
