  "old": "static void Mt2009YSetsRoll(LPITEM item, int iKind)\n{\n\tDWORD dwExtra = item->GetYExtra() & 0xFF;\n",
  "new": "static void Mt2009YSetsRoll(LPITEM item, int iKind)\n{\n\tDWORD dwExtra = item->GetYExtra() & 0xFF;\n\tif (iKind == YSETS_HOOD_KIND) // MT2009_PLUS_SERPENT_HOOD_V1 (roll): the hood's one line\n\t{\n\t\tconst int iOpt = number(0, s_iYSetsHoodCount - 1);\n\t\tconst int iRow = number(0, s_aYSetsHood[iOpt].bRows - 1);\n\t\titem->SetYExtra(dwExtra | ((DWORD) ((iOpt + 1) | (iRow << 4)) << 8));\n\t\treturn;\n\t}\n"
 },
 {
  "file": "item.cpp",
  "marker": "MT2009_PLUS_SERPENT_HOOD_V1 (points)",
  "old": "\tif (!owner || !item->GetYExtra() || !Mt2009YSetsRandomFamily(item->GetVnum(), iKind, iLevel))\n\t\treturn;\n",
  "new": "\tif (!owner || !item->GetYExtra() || !Mt2009YSetsRandomFamily(item->GetVnum(), iKind, iLevel))\n\t\treturn;\n\tif (iKind == YSETS_HOOD_KIND) // MT2009_PLUS_SERPENT_HOOD_V1 (points): the hood's one line at its refine level\n\t{\n\t\tconst BYTE b = (item->GetYExtra() >> 8) & 0xFF;\n\t\tconst int iOpt = (b & 0x0F) - 1;\n\t\tconst int iRow = b >> 4;\n\t\tif (iOpt >= 0 && iOpt < s_iYSetsHoodCount && iRow < s_aYSetsHood[iOpt].bRows)\n\t\t{\n\t\t\tconst int iValue = s_aYSetsHood[iOpt].asValue[iRow][iLevel];\n\t\t\towner->PointChange(s_aYSetsHood[iOpt].bPoint, bAdd ? iValue : -iValue);\n\t\t}\n\t\treturn;\n\t}\n"
 }
