			pc.remove_item(b.jade, 10)
			pc.remove_item(c.plates, b.plates)
			if b.extra then
				pc.remove_item(b.extra, b.extra_n)
			end
			pc.remove_item(c.gaya, b.gaya)
			pc.change_money(-c.craft_fee)
			if number(1, 100) <= c.craft_pct then
				pc.give_item2(b.vnum, 1)
				say("Uda³o siê! Oto "..item_name(b.vnum)..".")
			else
				say("Nie uda³o siê. Materia³y przepad³y.")
