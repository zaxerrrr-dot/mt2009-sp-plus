		when 72339.use begin
			local c = yohara_mapy4.cfg()
			local list = c.metins[pc.get_map_index()]
			if list == nil or pc.in_dungeon() then
				syschat("Kamieñ Metin z Yohara dzia³a tylko na mapach Yohary z Wol¹ SungMa.")
				return
			end
			if pc.get_conqueror_level() < 1 then
				syschat("Kamieñ Metin z Yohara wymaga 1. Poziomu Czempiona.")
				return
			end
			if pc.count_item(c.stone) < 1 then
				return
			end
			local vid = spawn_mob(list[number(1, table.getn(list))], pc.get_x() * 100 + 300, pc.get_y() * 100, 0, false)
			if vid == nil or vid == 0 then
				syschat("Tutaj nie da siê przywo³aæ Metina. Spróbuj w innym miejscu.")
