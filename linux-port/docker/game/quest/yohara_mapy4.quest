			say_reward("Ka¿da: "..c.craft_fee_text.." Yang, szansa "..c.craft_pct.."%. Gdy siê nie uda, przedmioty przepadaj¹.")
			local s = select(item_name(14580), item_name(14590), item_name(14600), item_name(14610), "Nie teraz")
			if s < 1 or s > table.getn(c.bracelets) then
