-- cp1250; ¿aden napis nie koñczy siê polsk¹ liter¹ (qc).
quest yohara_mapy4 begin
	state start begin
		function cfg()
			return {
				min_level = 120,
				port = {1280 + 405, 5632 + 480},              -- Town.txt portu (368)
				shelter = {9984 + 80, 12032 + 640},           -- Town.txt Schronienia Pó³nocnego Wiatru (393)
			}
		end

		when login with pc.get_map_index() == 389 begin
			local c = yohara_mapy4.cfg()
			if pc.is_gm() or pc.is_playerbot() then
				return
			end
			if pc.get_level() < c.min_level then
				syschat("Ziemie Yohary s¹ dostêpne od poziomu "..c.min_level..". Wracasz do Portu Nowego Kontynentu.")
				pc.warp(c.port[1] * 100, c.port[2] * 100)
			end
		end

		when 20808.chat."Schronienie Pó³nocnego Wiatru" with pc.get_map_index() == 389 begin
			local c = yohara_mapy4.cfg()
			say_title(mob_name(20808)..":")
			say("Pilnujê wejœcia do Schronienia Pó³nocnego Wiatru.")
			say("Nikogo nie wpuszczam lekkomyœlnie - tam jest")
			say("niebezpiecznie. Jeœli jesteœ gotów, przeprowadzê ciê.")
			if select("WejdŸ do Schronienia", "Nie teraz") ~= 1 then
				return
			end
			if pc.get_level() < c.min_level and not pc.is_gm() then
				say("Wróæ, gdy osi¹gniesz poziom "..c.min_level..".")
				return
			end
			if not pc.can_warp() or pc.is_busy() then
				say("Poczekaj chwilê po handlu lub rozmowie.")
				return
			end
			pc.warp(c.shelter[1] * 100, c.shelter[2] * 100)
		end
	end
end
