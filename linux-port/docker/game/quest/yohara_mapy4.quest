			end
			local vid = spawn_mob(list[number(1, table.getn(list))], pc.get_x() * 100 + 300, pc.get_y() * 100, 0, false)
			if vid == nil or vid == 0 then
				syschat("Tutaj nie da siê przywo³aæ Metina. Spróbuj w innym miejscu.")
