-- MT2009_PLUS_TELEPORT_RING_GLOBAL_V1: Pierscien Teleportacji (70058) as on the
-- global servers (the owner, 23 October; pl-wiki "Pierscien Teleportacji"):
--  * usable from level 30 (the item's own level limit too);
--  * no Yang fee - the wiki names none; the ring itself is the price (Sklep
--    Gaya, 819 Gaya: quest/ygaya.quest, row II);
--  * one teleport per 30 minutes PER RING: the last use is written into the
--    ring's socket 0 (get_global_time()), the pause is 1800 s (the item
--    proto's value 1 too). Of several rings in the bag the one clicked
--    is used if it is ready, else the first ready one; only that ring's clock
--    starts. Its tooltip shows what is left (client root uitooltip.py, same
--    marker); the message says it too when no ring is ready;
--  * the wiki's places, our map indexes, landing on each map's Town.txt
--    (pc.teleport, as the Teleporter does; every point checked walkable in
--    server_attr): Wioska I (1/21/41 by kingdom), Wioska II (3/23/43),
--    Dolina Seungryong 64, Pustynia Yongbi 63, Gora Sohan 61, Doyyumhwan 62,
--    Loch Pajakow 1 / Kuahklo Dong 104, Grota Wygnancow 72; from level 90
--    Przyladek Smoczego Ognia 301, Nefrytowa Zatoka 303, Zbocze Gautama 302,
--    Gromiste Gory 304; Swiatynia Ochao 209 from level 95 (its guard's own
--    floor, temple_of_the_ochao.quest); Grota Wygnancow 2 (73) listed as
--    locked, open only while standing in Grota Wygnancow (72); Dongan (373)
--    only for a Champion (Poziom Czempiona 1+). No Arezzo map;
--  * not from a dungeon instance, a war, duel, OX, wedding or GM map.
-- The ring is not used up. Not 70058.use: special_item_group.txt puts the
-- ring in the quest group 10031 ("Group ... Vnum 10031, Type Quest"), so
-- every ring has SIGVnum 10031 and its use goes to CQuestManager::SIGUse(10031)
-- - a handler under 70058/use is never looked at (found by Mur4s, 22 Sept).
-- Bots never come through here: they recall home and travel to these places
-- with the ring through TransitionPlayerBotMap, without the 30-minute pause
-- and one ring each (MT2009_PLUS_BOT_RING_TRAVEL_V1, playerbot_travel.h).
-- MT2009_PLUS_TELEPORT_RING_GLOBAL_V2 (the owner, 23 October): Grota Wygnancow
-- lands at the grotto's entrance, not inside it - Town.txt of map 72 is in
-- the grotto and skipped Koe-Pung's (20093) level 75 + Krwisty Kamien
-- (30190/30191) check (check_trans_ticket.quest). The place is the cave mouth
-- in Dolina Seungryong (64, map_n_threeway, base 256000 665600) a few steps
-- north of Koe-Pung (npc.txt 282 1455): cell 284 1450, walkable with 2 m of
-- free ground around it in server_attr. The other dungeon-like places keep
-- Town.txt: Loch Pajakow 1 (104) has no entry check, Swiatynia Ochao (209)
-- asks only level 95 (the ring's own limit for it), Grota Wygnancow 2 (73)
-- only from inside 72.
-- Polish letters as cp1250 escapes (decimal).
quest teleport_ring begin
    state start begin
        function ring_vnum()
            return 70058
        end

        function min_level()
            return 30
        end

        -- seconds between two uses of one ring (the item proto's value 1 says
        -- 1800 too); the client tooltip counts with the same 1800
        function pause()
            return 1800
        end

        -- seconds left on the selected ring
        function left_selected(pause)
            local last = item.get_socket(0)
            if last == nil or last <= 0 then
                return 0
            end
            local left = last + pause - get_global_time()
            if left < 0 or left > pause then
                return 0
            end
            return left
        end

        function time_text(left)
            local m = math.floor(left / 60)
            local s = math.mod(left, 60)
            if m > 0 then
                return string.format("%d min %d s", m, s)
            end
            return string.format("%d s", s)
        end

        -- the ring to use: the clicked one (id) if ready, else the first ready
        -- ring in the bag; returns its id (0: none) and the shortest wait
        function pick_ring(clicked, pause)
            local ids = {pc.get_sig_items(10031)}
            local first_ready = 0
            local soonest = pause
            for i = 1, table.getn(ids) do
                if item.select(ids[i]) and item.get_vnum() == teleport_ring.ring_vnum() then
                    local left = teleport_ring.left_selected(pause)
                    if left == 0 then
                        if ids[i] == clicked then
                            return clicked, 0
                        end
                        if first_ready == 0 then
                            first_ready = ids[i]
                        end
                    elseif left < soonest then
                        soonest = left
                    end
                end
            end
            if first_ready ~= 0 then
                return first_ready, 0
            end
            return 0, soonest
        end

        -- no teleport out of these
        function blocked_from(idx)
            if idx >= 10000 then
                return true -- a dungeon instance
            end
            if idx == 110 or idx == 111 then
                return guild.get_any_war() ~= 0
            end
            return idx == 81 or idx == 112 or idx == 113
                or idx == 181 or idx == 182 or idx == 183 or idx == 200 or idx == 250
        end

        -- the list: {map, name, why it is locked or nil}
        function places()
            local e = pc.get_empire()
            local lv = pc.get_level()
            local v1 = ({"Yongan", "Joan", "Pyungmoo"})[e] or "Yongan"
            local v2 = ({"Jayang", "Bokjung", "Bakra"})[e] or "Jayang"
            local l = {
                {get_player_map1_index(), "Wioska I ("..v1..")"},
                {get_player_map2_index(), "Wioska II ("..v2..")"},
                {64, "Dolina Seungryong"},
                {63, "Pustynia Yongbi"},
                {61, "G\243ra Sohan"},
                {62, "Doyyumhwan"},
                {104, "Loch Paj\185k\243w 1 (Kuahklo Dong)"},
                {72, "Grota Wygna\241c\243w (wej\156cie)"},
            }
            if lv >= 90 then
                table.insert(l, {301, "Przyl\185dek Smoczego Ognia"})
                table.insert(l, {303, "Nefrytowa Zatoka"})
                table.insert(l, {302, "Klif Gautama (Zbocze Gautama)"})
                table.insert(l, {304, "Gromiste G\243ry"})
            end
            if lv >= 95 then
                table.insert(l, {209, "\140wi\185tynia Ochao"})
            end
            if pc.get_map_index() == 72 then
                table.insert(l, {73, "Grota Wygna\241c\243w 2"})
            else
                table.insert(l, {73, "Grota Wygna\241c\243w 2 (zablokowane)",
                    "Grota Wygna\241c\243w 2 jest dost\234pna tylko z Groty Wygna\241c\243w."})
            end
            if pc.get_conqueror_level() >= 1 then
                table.insert(l, {373, "Dongan"})
            end
            return l
        end

        -- one page of the list (7 places); the chosen place or nil
        function choose(page, ready_text)
            local l = teleport_ring.places()
            local per = 7
            local pages = math.floor((table.getn(l) + per - 1) / per)
            if page > pages then
                page = pages
            end
            say_title(item_name(teleport_ring.ring_vnum()))
            say("Dok\185d chcesz si\234 przenie\156\230?")
            say(ready_text)
            local opts = {}
            local maps = {}
            local from = (page - 1) * per + 1
            local to = math.min(page * per, table.getn(l))
            for i = from, to do
                table.insert(opts, l[i][2])
                table.insert(maps, l[i])
            end
            local nxt, prv = 0, 0
            if page < pages then
                table.insert(opts, "Dalej")
                nxt = table.getn(opts)
            end
            if page > 1 then
                table.insert(opts, "Wstecz")
                prv = table.getn(opts)
            end
            table.insert(opts, "Anuluj")
            local x = select_table(opts)
            if x == nxt then
                return teleport_ring.choose(page + 1, ready_text)
            elseif x == prv then
                return teleport_ring.choose(page - 1, ready_text)
            elseif x >= 1 and x <= table.getn(maps) then
                return maps[x]
            end
            return nil
        end

        function warn(text)
            say_title(item_name(teleport_ring.ring_vnum()))
            say_split(text)
            say("")
        end

        when 10031.sig_use begin
            local clicked = item.get_id()
            local pause = teleport_ring.pause()
            sys_log(0, string.format("QUEST_ITEM: teleport_ring runs name=%s level=%d map=%d ring=%d", pc.get_name(), pc.get_level(), pc.get_map_index(), clicked))
            if pc.get_level() < teleport_ring.min_level() then
                teleport_ring.warn(string.format("Pier\156cienia mo\191esz u\191ywa\230 od %d poziomu.", teleport_ring.min_level()))
                return
            end
            if teleport_ring.blocked_from(pc.get_map_index()) then
                teleport_ring.warn("Tutaj pier\156cie\241 nie dzia\179a.")
                return
            end
            if not pc.can_warp() then
                teleport_ring.warn(translate.general.wait_after_exchange)
                return
            end
            local ring, wait_left = teleport_ring.pick_ring(clicked, pause)
            if ring == 0 then
                teleport_ring.warn("Pier\156cie\241 musi odpocz\185\230 po ostatniej teleportacji. Najbli\191szy b\234dzie gotowy za "..teleport_ring.time_text(wait_left)..".")
                return
            end
            local ready_text = "Pier\156cie\241 jest gotowy."
            if ring ~= clicked then
                ready_text = "Ten pier\156cie\241 odpoczywa - u\191yjesz innego, gotowego."
            end
            local place = teleport_ring.choose(1, ready_text)
            if place == nil then
                setskin(NOWINDOW)
                return
            end
            if place[3] ~= nil then
                teleport_ring.warn(place[3])
                return
            end
            -- everything again after the window: the trade, the map, the bag
            if not pc.can_warp() or pc.is_dead() or teleport_ring.blocked_from(pc.get_map_index()) then
                teleport_ring.warn(translate.general.wait_after_exchange)
                return
            end
            if place[1] == 73 and pc.get_map_index() ~= 72 then
                teleport_ring.warn("Grota Wygna\241c\243w 2 jest dost\234pna tylko z Groty Wygna\241c\243w.")
                return
            end
            local again = teleport_ring.pick_ring(ring, pause)
            if again ~= ring or not item.select(ring) then
                teleport_ring.warn("Nie masz ju\191 gotowego pier\156cienia.")
                return
            end
            item.set_socket(0, get_global_time())
            sys_log(0, string.format("QUEST_ITEM: teleport_ring warp name=%s map=%d -> %d ring=%d", pc.get_name(), pc.get_map_index(), place[1], ring))
            -- MT2009_PLUS_TELEPORT_RING_GLOBAL_V2: to Koe-Pung's cave mouth
            -- (Dolina Seungryong 284 1450), the entry check stays his
            if place[1] == 72 then
                pc.warp(256000 + 28400, 665600 + 145000)
                return
            end
            pc.teleport(place[1])
        end
    end
end
