				d.setf("level", 16)
				d.set_regen_file(c.path.."fd_f.txt")
				razador_szc.watch_target(8124, c.metin6[1], c.metin6[2]) -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
			end
		end

		-- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1 (the owner, 20 October: "popraw wszystkie dungi"; the pattern of
		-- MT2009_PLUS_WUKONG_TARGETS_V1): the Ignator (SZC) and the Metin of Purgatory (SZC) tasks end with their kill
		-- events; a target that left without one (a kill the core gave no quest event, a target removed) held the
