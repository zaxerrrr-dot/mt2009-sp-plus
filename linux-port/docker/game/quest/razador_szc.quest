		-- MT2009_PLUS_DUNGEON_TARGET_RESPAWN_V1 (the owner, 20 October: "jak nie jest dotkniêty, to respi siê nowy czy coœ, bo to za du¿e u³atwienie, jak same siê bêd¹ zbija³y"):
		-- the task ends only by its kill - the target gone comes back at its place (same race, same unique); one
		-- alive but untouched is left be (the 90 s close is gone).
		function spawn_watched()
			local lv = d.getf("level")
			local vid = d.spawn_mob(d.getf("tw_vnum"), d.getf("tw_x"), d.getf("tw_y"))
			if vid ~= 0 then
