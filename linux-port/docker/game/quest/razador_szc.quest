		end

		function clear_level()
			local c = razador_szc.cfg()
			d.setf("level", 0)
			d.clear_regen()
			d.purge_area(c.area[1], c.area[2], c.area[3], c.area[4])
		end

		function remove_door(n)
			d.kill_unique("door"..n)
			d.kill_unique("idoor"..n)
		end

		function finish(text)
			d.setf("closed", 1)
			d.setf("mt2009_keep_until", 0)
			if text then
				d.notice(text)
			end
			d.exit_all()
		end

		function init()
