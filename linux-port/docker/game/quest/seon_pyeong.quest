-- Seon-Pyeong (20091) beside the Grotto of Exile's entrance in Orc Valley.
-- MT2009_PLUS_SEONPYEONG_GF_V1 (the owner, 17 October; as on the official server and the pl-wiki "Wytwarzanie
-- Broni / Zbroi / Butow"): a +9 piece dragged onto him becomes its level-80 successor, always (100%), and keeps its
-- stones and bonuses - item_proto refined_vnum / refine_set (char_item.cpp: BLACKSMITH2_MOB takes only the elite
-- refine sets, the Blacksmith and the scrolls none of them):
--   * weapons of level 65 +9, refine_proto 501: 2x Zwoj Blogoslawienstwa, 1x Broszura Szermierki, 100 000 Yang;
--   * body armours of level 66 +9 and the boots of level 47..59 +9, refine_proto 530: 3x Smocza Luska,
--     4x Smoczy Szpon, 200 000 Yang.
-- MT2009_PLUS_SEONPYEONG_GF_V2 (the owner, 17 October; the pl-wiki pages "Runiczny Miecz", "Cyjanitowe Ostrze" ...):
--   * weapons of level 80 +9 into the 87-105 ones, refine_proto 716: 3x Broszura Szermierki, 2x Zwoj Blogoslawienstwa,
--     100x Odlamek Energii, 5 000 000 Yang;
--   * weapons of level 87 +9 into the cyanite ones (105-115), refine_proto 717: 3x Ksiega Prawdy, 2x Zwoj
--     Blogoslawienstwa, 2x Dusza Prawdy, 2 000 000 Yang (constants.cpp IsEliteRefine: 501, 530, 716, 717).
-- MT2009_PLUS_ARMOR105_V1 (the owner, 17 October; the pl-wiki "Wytwarzanie Zbroi" - Seon-Pyeong, level 110): the
--   level-105 body armours +9 into the cyanite ones (110-120) - the same refine_proto 717 (mod/32_zbroje_105.sql).
-- MT2009_PLUS_SEONPYEONG_ELITE_V1 (22 October 2026): since the owner's sheet (refine_global.sql) these steps are its
--   fixed recipes 39900-39903 (tools/refineglobal ELITE; IsEliteRefine, server-patches/seonpyeong), Partyzana+9 ->
--   Pogromca Nieb. Smoka among the weapons 65 -> 80.
-- His cube window (NerrVoVy's cube.seon_pyeong.txt, the boots of cube.buty.txt) is gone. The text without diacritics.
-- MT2009_PLUS_SEONPYEONG_FIX_V1 (the owner, 22 October: "after OK nothing happens"): as on the global servers the piece
--   goes through his refine window - dragged onto him, or now picked from the talk: "Przekuj przedmiot +9" lists the
--   bag's pieces with one of his recipes (pc.seonpyeong_cells) and opens the same refine window for the one chosen
--   (pc.seonpyeong_refine, server-patches/seonpyeong); "Przepisy" shows what he takes.
quest seon_pyeong begin
	state start begin
		function recipes()
			say_title(mob_name(20091)..":")
			say_reward("Bron 65 > 80: 2x "..item_name(25040)..",")
			say_reward("1x "..item_name(70031)..", 100 000 Yang")
			say_reward("Zbroja i buty > 80: 3x "..item_name(71123)..",")
			say_reward("4x "..item_name(71129)..", 200 000 Yang")
			say_reward("Bron 80 > 87: 3x "..item_name(70031)..",")
			say_reward("2x "..item_name(25040)..", 100x "..item_name(51001)..", 5 000 000 Yang")
			say_reward("Bron 87 > Cyjanit: 3x "..item_name(30623)..",")
			say_reward("2x "..item_name(25040)..", 2x "..item_name(30624)..", 2 000 000 Yang")
			say_reward("Zbroja 105 > Cyjanit: to samo co bron 87")
			say("")
			say("Ogniste Buty i Buty Oceanu szyje Kawuco")
			say("na Przyladku Smoczego Ognia.")
		end

		function pick()
			local cells = pc.seonpyeong_cells()
			local n = table.getn(cells)
			say_title(mob_name(20091)..":")
			if n == 0 then
				say("Nie masz w plecaku broni, zbroi ani butow +9,")
				say("ktore moge przekuc. Zalozonego przedmiotu")
				say("nie przyjme - zdejmij go najpierw.")
				return
			end
			if n > 12 then
				n = 12
			end
			say("Ktory przedmiot mam przekuc? Mozesz go tez")
			say("po prostu przeciagnac na mnie.")
			local names = {}
			for i = 1, n do
				item.select_cell(cells[i])
				names[i] = item_name(item.get_vnum())
			end
			names[n + 1] = "Zamknij"
			local s = select_table(names)
			if s == nil or s < 1 or s > n then
				return
			end
			if not pc.seonpyeong_refine(cells[s]) then
				say_title(mob_name(20091)..":")
				say("Tego przedmiotu teraz nie przekuje.")
				say("Podejdz blizej i sprobuj jeszcze raz.")
			end
		end

		when 20091.chat."Wytwarzanie Ekwipunku" begin
			say_title(mob_name(20091)..":")
			say("Przekuwam bron, zbroje i buty ulepszone na +9")
			say("w legendarny ekwipunek. Ulepszenie zawsze sie")
			say("udaje, kamienie i bonusy zostaja.")
			say("Wybierz przedmiot albo przeciagnij go na mnie.")
			local s = select("Przekuj przedmiot +9", "Przepisy", "Zamknij")
			if s == 1 then
				seon_pyeong.pick()
			elseif s == 2 then
				seon_pyeong.recipes()
			end
		end
	end
end
