-- MT2009_PLUS_BUFFI_V1: Buffi, the support shaman of Ameria Project (server-patches/buffi/README.md,
-- playerbot_buffi.cpp) - Ameria's quest __buffi__ and the rest of its Buffi data around it:
--   Kamieñ Duchowy Buffi (61031) - a buffi skill (164-167) from G1 to P, Ameria's rules (= Kamieñ Duchowy:
--     punkty rangi 1000 + 500 za stopieñ, przy ujemnej podwójnie, nieudana próba 1/3-1/2) with our wait between two
--     tries (12 h, Zwój Egzorcyzmu at once), as Kamieñ Duchowy+ of the quest riposty;
--   Buffi (7 dni) 61025 and Zwój Imienia Buffi 61030 for a new character, once (Ameria's starter chest 66002).
-- MT2009_PLUS_BUFFI_V2 (the owner, 21 October 2026): M1 -> G1 are the shaman's own skill books dragged onto the buffi
-- skill in the Buffi window (playerbot_buffi.cpp, "/buffi read"); the General Store's offer of the books 61035-61038
-- and of Kamieñ Duchowy Buffi is gone - the stone drops from Metins and bosses (Zaczarowany Las and up).
-- The seals and the name scroll are the core's (playerbot_buffi.cpp, the window root/uibuffi.py); the books are the
-- engine's skill books (server-patches/buffi (learnable)). Off (m2_buffi_off, .env M2_BUFFI=0): nothing here.
-- MT2009_PLUS_BUFFI_V3 (the owner's list of 22 October 2026, 5): Buffi from the character's level 55. The starter gift
-- is now Buffi for good (61026) + Zwój Imienia Buffi (61030), once, on reaching level 55 - or at the login of a
-- character already 55+ that never got it (its own flag "gift55"; the old 7-day gift of a new character is gone, a
-- character that got it keeps it). Never for the bots. Kamieñ Duchowy Buffi also from level 55.
-- cp1250; no string ends with a Polish letter (qc).
quest buffi begin
	state start begin
		function name(vnum)
			local names = {
				[164] = "B³ogos³awieñstwo Buffi", [165] = "Pomoc Smoka Buffi",
				[166] = "Szybkoœæ Buffi", [167] = "Zwiêkszenie Ataku Buffi",
			}
			return names[vnum] or "Buffi"
		end

		function grade(level)
			if level >= 40 then
				return "P"
			elseif level >= 30 then
				return "G" .. (level - 29)
			elseif level >= 20 then
				return "M" .. (level - 19)
			end
			return "" .. level
		end

		-- MT2009_PLUS_BUFFI_V3: the gift of level 55 (Buffi for good + Zwój Imienia Buffi), once a character
		function gift55()
			if pc.getqf("gift55") != 0 or pc.get_level() < 55 or pc.is_playerbot() then
				return
			end
			pc.setqf("gift55", 1)
			pc.give_item2(61026, 1)
			pc.give_item2(61030, 1)
			syschat("Otrzymujesz Buffi (na zawsze) i Zwój Imienia Buffi za 55 poziom. Okno Buffi otwiera klawisz P.")
		end

		when levelup with pc.get_level() >= 55 and pc.getqf("gift55") == 0 and
				game.get_event_flag("m2_buffi_off") == 0 and not pc.is_playerbot() begin
			buffi.gift55()
		end

		when login with pc.get_level() >= 55 and pc.getqf("gift55") == 0 and
				game.get_event_flag("m2_buffi_off") == 0 and not pc.is_playerbot() begin
			buffi.gift55()
		end

		when 61031.use begin
			local STONE = 61031
			say_title("Kamieñ Duchowy Buffi")
			if game.get_event_flag("m2_buffi_off") != 0 then
				say("Buffi jest wy³¹czony na tym serwerze.")
				return
			end
			if pc.get_level() < 55 then
				say("Buffi dostêpna od 55 poziomu.")
				return
			end
			if pc.get_skill_group() == 0 then
				say("Najpierw wybierz drogê umiejêtnoœci (Szkolenie).")
				return
			end
			local vnums, names = {}, {}
			for v = 164, 167 do
				local lv = pc.get_skill_level(v)
				if lv >= 30 and lv < 40 then
					table.insert(vnums, v)
					table.insert(names, string.format("%s (%s)", buffi.name(v), buffi.grade(lv)))
				end
			end
			if table.getn(vnums) == 0 then
				say("Kamieñ Duchowy Buffi trenuje umiejêtnoœci Buffi")
				say("od stopnia G1 do P. ¯adna z nich nie jest teraz")
				say("na stopniu G1-G10. Od M1 do G1 - zwyk³e Ksiêgi")
				say("Umiejêtnoœci szamana przeci¹gniête w oknie Buffi")
				say("(klawisz P) na jej umiejêtnoœæ.")
				return
			end
			local now = get_time()
			if now < pc.getqf("next_time") and not pc.is_skill_book_no_delay() then
				say("Twój duch musi jeszcze odpocz¹æ po ostatnim treningu.")
				say_reward(string.format("Nastêpna próba za: %s.", second_to_smart_time(pc.getqf("next_time") - now)))
				say("Zwój Egzorcyzmu pozwala spróbowaæ od razu.")
				return
			end
			say("Któr¹ umiejêtnoœæ Buffi chcesz trenowaæ?")
			table.insert(names, "Anuluj")
			local s = select_table(names)
			if s == table.getn(names) then
				return
			end
			local vnum = vnums[s]
			local level = pc.get_skill_level(vnum)
			local alignment = pc.get_real_alignment()
			local need = 1000 + 500 * (level - 30)
			say_title(string.format("%s: %s -> %s", buffi.name(vnum), buffi.grade(level), buffi.grade(level + 1)))
			if alignment < -19000 + need then
				say("Twoja ranga jest zbyt niska, by trenowaæ z Kamieniem")
				say("Duchowym Buffi.")
				return
			end
			if alignment < 0 then
				need = need * 2
				say_reward(string.format("Przy ujemnej randze trening kosztuje %d punktów rangi.", need))
			else
				say_reward(string.format("Trening kosztuje %d punktów rangi.", need))
				if alignment < need then
					say("Masz za ma³o punktów rangi - ranga spadnie poni¿ej zera.")
				end
			end
			say("Nieudana próba zabiera od 1/3 do 1/2 tych punktów.")
			say("Nastêpna próba mo¿liwa po 12 godzinach.")
			if select("Trenuj", "Anuluj") != 1 then
				return
			end
			-- again after the dialog: the bag, the wait, the skill
			if pc.count_item(STONE) < 1 or pc.get_skill_level(vnum) != level then
				return
			end
			if get_time() < pc.getqf("next_time") then
				if not pc.is_skill_book_no_delay() then
					return
				end
				pc.remove_skill_book_no_delay()
			end
			pc.setqf("next_time", get_time() + 12 * 3600)
			pc.remove_item(STONE, 1)
			say_title(buffi.name(vnum))
			if pc.learn_grand_master_skill(vnum) then
				pc.change_alignment(-need)
				say_reward("Trening siê uda³!")
				say(string.format("%s: teraz %s.", buffi.name(vnum), buffi.grade(pc.get_skill_level(vnum))))
				say_reward(string.format("Zu¿yto %d punktów rangi.", need))
			else
				local lost = number(math.floor(need / 3), math.floor(need / 2))
				pc.change_alignment(-lost)
				say_reward("Trening siê nie uda³...")
				say("Spróbuj ponownie póŸniej.")
				say_reward(string.format("Zu¿yto %d punktów rangi.", lost))
			end
		end
	end
end
