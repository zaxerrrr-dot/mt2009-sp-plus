-- MT2009_PLUS_YOHARA_PB_V1 / MT2009_PLUS_YOHARA_ILUZJA_V1: Przebudzeni bossowie - P³askowy¿ Iluzji i wejœcie do lochów
-- Przebudzenia (w³aœciciel, 14.10.2026: "Razador (PB) i Nemere (PB) - dodaæ wg wiki"; "dodaæ P³askowy¿ Iluzji jako hub
-- lochów PB, dodaæ Beran PB i Jotun PB"; pl-wiki "P³askowy¿ Iluzji", "Statua Przebudzenia", "Statua Iluzji", "Handlarka
-- Iluzji", "Ksi¹¿ka Przebudzenia", "Codzienna misja: Œwiat Iluzji", "Lekarstwo Iluzji"; Owsap v6.2.6
-- labyrinth_dungeon.quest):
--   * Statua Iluzji (20470) w Yongan (540,500), Joan (688,748) i Pyungmoo (342,800) - komórki z wiki: przenosi na
--     P³askowy¿ Iluzji (397, od poziomu 110); Codzienna misja "Œwiat Iluzji" (od poziomu 110): zabij Razadora i
--     Nemere (zwyk³e lochy; zwyk³ego Jotuna Thryma tu nie ma) i wróæ - nagroda: Ksi¹¿ka Przebudzenia (31146); znowu
--     24 godziny po ukoñczeniu; okno wytwarzania kamieni przebudzenia (cube.yohara_iluzja.txt: kamieñ + Dusza
--     Przebudzenia = nastêpny kamieñ).
--   * P³askowy¿ Iluzji (397, metin2_map_labyrinth): bez potworów, od poziomu 110 (ni¿ej - do wioski). Statua
--     Przebudzenia (20471, 153,89): cztery lochy - Grota Wygnañców 2 (PB) (398, quest beran_pb), Twierdza Czerwonego
--     Smoka (PB) (369, razador_pb), Stra¿nica Nemere (PB) (370, nemere_pb), Zaklêty Las (PB) (371, jotun_pb) - od
--     poziomu 110, tylko w grupie, otwiera przywódca, ka¿dy cz³onek musi mieæ Ksi¹¿kê Przebudzenia (zabierana przy
--     wejœciu do nowej wyprawy); do Stra¿nicy Nemere (PB) w grupie musi byæ Ninja i Szaman. 60 minut; po ukoñczeniu lub
--     po czasie ka¿dy wraca na P³askowy¿ Iluzji. "Wróæ do lochu" - do trwaj¹cej wyprawy. Statua Fabryki Broni (20473)
--     i Statua Kowala Zbroi (20474): okna wytwarzania ekwipunku Smoka Mroku; Handlarka Iluzji (20469): sklep;
--     Teleporter (9012): quest map_warp. Statuy Szczeliny Czasu nie ma (lochów Szczeliny Czasu nie dodajemy).
--   * Baek-Go (20018): Lekarstwo Iluzji (31144) za 20 Liœci ¯ycia (31145) - wiki.
-- Mapy lochów s¹ na rdzeniu Yohary (game3): boty tam nie wchodz¹ - licz¹ siê ludzie z grupy (GM mo¿e wejœæ sam).
-- cp1250; ¿aden napis nie koñczy siê polsk¹ liter¹ (qc).
quest przebudzeni_bossowie begin
	state start begin
		function cfg()
			return {
				min_level = 110, ticket = 31146, near = 30, keep = 3600 + 300,
				villages = {[1] = true, [21] = true, [41] = true},
				-- P³askowy¿ Iluzji: the map, the entry (world units / 100: base 3072, 17920 + local 125,125) and the
				-- landing beside Statua Przebudzenia (local 150,95) - the way back from every dungeon
				plateau = 397, entry = {3072 + 125, 17920 + 125}, landing = {3072 + 150, 17920 + 95},
				dungeons = {
					{map = 398, name = "Grota Wygnañców 2 (PB)", boss = 4410, entry = {0 + 877, 19712 + 722}},
					{map = 369, name = "Twierdza Czerwonego Smoka (PB)", boss = 4411,
					 entry = {1536 + 342, 19712 + 584}},
					{map = 370, name = "Stra¿nica Nemere (PB)", boss = 4412,
					 entry = {2304 + 171, 19712 + 270}, need_jobs = true},
					{map = 371, name = "Zaklêty Las (PB)", boss = 4413, entry = {3328 + 478, 19712 + 970}},
				},
				mission_cd = 24 * 3600, leaves = 31145, leaves_count = 20, medicine = 31144,
			}
		end

		function in_village()
			return przebudzeni_bossowie.cfg().villages[pc.get_map_index()] ~= nil
		end

		function on_plateau()
			return pc.get_map_index() == przebudzeni_bossowie.cfg().plateau
		end

		function bot_leads()
			local lp = party.get_leader_pid()
			if lp == nil or lp == 0 or lp == pc.get_player_id() then
				return false
			end
			local bot = false
			local pids = {party.get_member_pids()}
			for i, pid in next, pids, nil do
				if pid == lp then
					q.begin_other_pc_block(pid)
					bot = pc.get_player_id() == pid and pc.is_playerbot()
					q.end_other_pc_block()
				end
			end
			return bot
		end

		function enter(dg)
			local c = przebudzeni_bossowie.cfg()
			say_title(mob_name(20471)..":")
			if not pc.is_gm() and game.get_event_flag("mt2009_dungeons_closed") > 0 then
				say("Lochy s¹ dziœ zamkniête. Wróæ póŸniej.")
				return
			end
			if not pc.is_gm() and not party.is_party() then
				say("Do Lochów Przebudzenia wchodzi siê tylko w grupie.")
				return
			end
			if party.is_party() and not party.is_leader() and not przebudzeni_bossowie.bot_leads() then
				say("Tylko przywódca grupy mo¿e otworzyæ loch.")
				return
			end
			if not pc.can_warp() or pc.is_busy() then
				say("Poczekaj chwilê po handlu lub rozmowie.")
				return
			end
			local me = pc.get_player_id()
			local humans = {me}
			local bad = {}
			local ninja, shaman = pc.get_job() == 1, pc.get_job() == 3
			local function check(name)
				if pc.get_level() < c.min_level then
					table.insert(bad, name.." (poziom)")
				elseif pc.count_item(c.ticket) < 1 then
					table.insert(bad, name.." (Ksi¹¿ka Przebudzenia)")
				end
			end
			if not pc.is_gm() then
				check(pc.get_name())
			end
			local far = 0
			if party.is_party() then
				local lmap, lx, ly = pc.get_map_index(), pc.get_x(), pc.get_y()
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					if pid ~= me then
						q.begin_other_pc_block(pid)
						if pc.get_player_id() == pid and not pc.is_playerbot() then
							local dx, dy = pc.get_x() - lx, pc.get_y() - ly
							if pc.get_map_index() == lmap and dx * dx + dy * dy <= c.near * c.near and pc.can_warp() then
								table.insert(humans, pid)
								ninja = ninja or pc.get_job() == 1
								shaman = shaman or pc.get_job() == 3
								if not pc.is_gm() then
									check(pc.get_name())
								end
							else
								far = far + 1
							end
						end
						q.end_other_pc_block()
					end
				end
			end
			if far > 0 then
				say("Cz³onek grupy jest za daleko. Zbierzcie siê przy mnie.")
				return
			end
			if table.getn(bad) > 0 then
				say("Nie spe³niaj¹ warunków:")
				for i, n in next, bad, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if not pc.is_gm() and table.getn(humans) < 2 then
				say("Sam nie przetrwasz w tym lochu - potrzebujesz")
				say("co najmniej jednego towarzysza z grupy.")
				return
			end
			if dg.need_jobs and not pc.is_gm() and not (ninja and shaman) then
				say("W grupie musi byæ co najmniej jeden Ninja i jeden")
				say("Szaman - bez nich nie przejdziecie Stra¿nicy Nemere.")
				return
			end
			if table.getn(humans) > 8 then
				say("Do lochu wchodzi najwy¿ej 8 osób.")
				return
			end
			-- each one's way back: P³askowy¿ Iluzji beside Statua Przebudzenia (pl-wiki: "ca³a grupa zostaje
			-- teleportowana z powrotem na P³askowy¿ Iluzji")
			for i, pid in ipairs(humans) do
				q.begin_other_pc_block(pid)
				if pc.get_player_id() == pid then
					pc.setf("przebudzeni_bossowie", "ret_map", c.plateau)
					pc.setf("przebudzeni_bossowie", "ret_x", c.landing[1])
					pc.setf("przebudzeni_bossowie", "ret_y", c.landing[2])
				end
				q.end_other_pc_block()
			end
			if d.new_jump_pids(dg.map, dg.entry[1] * 100, dg.entry[2] * 100, humans) < 0 then
				say("Loch nie przyjmie was teraz. Spróbuj za chwilê.")
			end
		end

		-- P³askowy¿ Iluzji: level 110 (wiki: "Wejœcie mo¿liwe od poziomu 110")
		when login with przebudzeni_bossowie.on_plateau() begin
			local c = przebudzeni_bossowie.cfg()
			if pc.is_playerbot() then
				warp_to_village()
				return
			end
			if pc.get_level() < c.min_level and not pc.is_gm() then
				syschat("P³askowy¿ Iluzji przyjmuje wojowników od poziomu "..c.min_level..".")
				warp_to_village()
			end
		end

		-- Statua Iluzji: the way to P³askowy¿ Iluzji
		when 20470.chat."P³askowy¿ Iluzji" with przebudzeni_bossowie.in_village() begin
			local c = przebudzeni_bossowie.cfg()
			say_title(mob_name(20470)..":")
			if pc.get_level() < c.min_level then
				say("P³askowy¿ Iluzji otwiera siê przed wojownikami od")
				say("poziomu "..c.min_level..".")
				return
			end
			say("Moja moc przeniesie ciê na P³askowy¿ Iluzji. Tam")
			say("Statua Przebudzenia otworzy przed twoj¹ grup¹,")
			say("Lochy Przebudzenia, a statuy kowali wykuj¹ dla")
			say("ciebie ekwipunek Smoka Mroku.")
			if select("Przenieœ mnie", "Nie teraz") ~= 1 then
				return
			end
			if not pc.can_warp() or pc.is_busy() then
				say_title(mob_name(20470)..":")
				say("Poczekaj chwilê po handlu lub rozmowie.")
				return
			end
			pc.warp(c.entry[1] * 100, c.entry[2] * 100, c.plateau)
		end

		-- Statua Iluzji: the awakening stones (the cube window - the wiki: only here)
		when 20470.chat."Kamienie Przebudzenia" with przebudzeni_bossowie.in_village() begin
			say_title(mob_name(20470)..":")
			say("Po³¹cz kamienie przebudzenia z Dusz¹ Przebudzenia,")
			say("a otrzymasz lepszy kamieñ:")
			say("    5 Ma³ych + Dusza = Drobny (45%)")
			say("    3 Drobne + Dusza = £adny (35%)")
			say("    2 £adne + Dusza = Zacny (30%)")
			say("    Zacny + Dusza = Silny (25%)")
			if select("Otwórz okno wytwarzania", "Anuluj") == 1 then
				setskin(NOWINDOW)
				command("cube open")
			end
		end

		-- Statua Iluzji: Codzienna misja "Œwiat Iluzji"
		when 20470.chat."Codzienna misja: Œwiat Iluzji" with przebudzeni_bossowie.in_village() begin
			local c = przebudzeni_bossowie.cfg()
			local now = get_global_time()
			say_title(mob_name(20470)..":")
			if pc.get_level() < c.min_level then
				say("Œwiat Iluzji otwiera siê przed wojownikami od")
				say("poziomu "..c.min_level..".")
				return
			end
			local st = pc.getqf("m_start")
			if st > 0 then
				local r, n = pc.getqf("m_razador"), pc.getqf("m_nemere")
				if r == 1 and n == 1 then
					say("Pokona³eœ Razadora i Nemere. Oto twoja nagroda:")
					say_item_vnum(c.ticket)
					pc.setqf("m_start", 0)
					pc.setqf("m_razador", 0)
					pc.setqf("m_nemere", 0)
					pc.setqf("m_done", now)
					pc.give_item2(c.ticket, 1)
					return
				end
				say("Misja trwa. Pokonaj obu bossów i wróæ do mnie:")
				say((r == 1 and "    [x] " or "    [ ] ")..mob_name(6091).." (Czyœciec Ognia)")
				say((n == 1 and "    [x] " or "    [ ] ")..mob_name(6191).." (Lodowa Kraina)")
				if select("Dobrze", "Porzuæ misjê teraz") == 2 then
					pc.setqf("m_start", 0)
					pc.setqf("m_razador", 0)
					pc.setqf("m_nemere", 0)
				end
				return
			end
			local left = pc.getqf("m_done") + c.mission_cd - now
			if left > 0 then
				say("Misjê mo¿esz powtórzyæ za "..math.floor(left / 3600).." h "..math.floor(math.mod(left, 3600) / 60).." min.")
				return
			end
			say("Lochy Przebudzenia wpuszczaj¹ tylko tych, którzy")
			say("nios¹ Ksi¹¿kê Przebudzenia. Udowodnij swoj¹ si³ê:")
			say("pokonaj Razadora w Czyœæcu Ognia i Nemere w Lodowej")
			say("Krainie, a dostaniesz Ksi¹¿kê.")
			say_reward("Nagroda: Ksi¹¿ka Przebudzenia. Misjê mo¿na")
			say_reward("powtarzaæ co 24 godziny.")
			if select("Przyjmij misjê teraz", "Nie teraz") == 1 then
				pc.setqf("m_start", now)
				pc.setqf("m_razador", 0)
				pc.setqf("m_nemere", 0)
			end
		end

		when 6091.kill or 6091.party_kill with pc.getqf("m_start") > 0 and pc.getqf("m_razador") == 0 begin
			pc.setqf("m_razador", 1)
			syschat("Codzienna misja Œwiat Iluzji: Razador pokonany.")
		end

		when 6191.kill or 6191.party_kill with pc.getqf("m_start") > 0 and pc.getqf("m_nemere") == 0 begin
			pc.setqf("m_nemere", 1)
			syschat("Codzienna misja Œwiat Iluzji: Nemere pokonany.")
		end

		-- Statua Przebudzenia (P³askowy¿ Iluzji): the four dungeons
		when 20471.chat."Lochy Przebudzenia" with przebudzeni_bossowie.on_plateau() begin
			local c = przebudzeni_bossowie.cfg()
			say_title(mob_name(20471)..":")
			say("Dziêki mojej mocy wejdziesz do Lochów Przebudzenia.")
			say("Masz 60 minut, by je ukoñczyæ. Po ukoñczeniu lub po")
			say("up³ywie czasu wrócisz na P³askowy¿ Iluzji - innego")
			say("wyjœcia nie ma.")
			say_reward("Od poziomu "..c.min_level..", tylko w grupie. Ka¿dy musi")
			say_reward("mieæ Ksi¹¿kê Przebudzenia (zabieran¹ przy wejœciu).")
			say_orange("Do Stra¿nicy Nemere (PB): Ninja i Szaman w grupie.")
			local opts = {}
			for i, dg in ipairs(c.dungeons) do
				table.insert(opts, dg.name)
			end
			local back = 0
			local now = get_global_time()
			local idx = pc.getf("przebudzeni_bossowie", "idx")
			-- an expedition still running (the instance lives on the Yohara core): d.find asks that core, which warps
			-- the player back if the instance is still there
			if idx > 0 and now - pc.getf("przebudzeni_bossowie", "entry") < c.keep then
				table.insert(opts, "Wróæ do lochu")
				back = table.getn(opts)
			end
			table.insert(opts, "Nie teraz")
			local s = select_table(opts)
			if s == back then
				local dg = nil
				for i, x in ipairs(c.dungeons) do
					if math.floor(idx / 10000) == x.map then
						dg = x
					end
				end
				if dg and d.find(idx, dg.entry[1] * 100, dg.entry[2] * 100, pc.get_player_id()) then
					pc.warp(dg.entry[1] * 100, dg.entry[2] * 100, idx)
				else
					say_title(mob_name(20471)..":")
					say("Jeœli wyprawa wci¹¿ trwa, moc statui zaraz ciê zabierze.")
				end
				return
			end
			local dg = c.dungeons[s]
			if not dg then
				return
			end
			przebudzeni_bossowie.enter(dg)
		end

		-- Statua Fabryki Broni / Statua Kowala Zbroi (P³askowy¿ Iluzji): the Dark Dragon gear (the cube window;
		-- the wiki: drag an item onto the statue or talk)
		when 20473.chat."Wytwarzanie broni" with przebudzeni_bossowie.on_plateau() begin
			say_title(mob_name(20473)..":")
			say("Wykujê dla ciebie broñ Smoka Mroku (od 96 poziomu):")
			say("10 Kowade³, 5 planów broni, 5 Œrodków Œciernych,")
			say("5 Stali, kamieñ przebudzenia i 2 500 000 Yang.")
			say("Kamieñ decyduje o szansie: Ma³y 2%, Drobny 5%,")
			say("£adny 10%, Zacny 15%, Silny 25%.")
			if select("Otwórz okno wytwarzania", "Anuluj") == 1 then
				setskin(NOWINDOW)
				command("cube open")
			end
		end

		when 20474.chat."Wytwarzanie zbroi i he³mów" with przebudzeni_bossowie.on_plateau() begin
			say_title(mob_name(20474)..":")
			say("Wykujê dla ciebie zbrojê albo he³m smoka (od 96")
			say("poziomu): 10 Zwyk³ych Skór, 5 planów, 5 Cienkich")
			say("Przêdz, 5 Oznak S³awy (zbroja) albo 5 Stali (he³m),")
			say("kamieñ przebudzenia i 2 500 000 Yang. Kamieñ decyduje")
			say("o szansie: Ma³y 2%, Drobny 5%, £adny 10%, Zacny 15%,")
			say("Silny 25%.")
			if select("Otwórz okno wytwarzania", "Anuluj") == 1 then
				setskin(NOWINDOW)
				command("cube open")
			end
		end

		when 20470.take or 20473.take or 20474.take begin
			if npc.get_race() == 20470 and not przebudzeni_bossowie.in_village() then
				return
			end
			if npc.get_race() ~= 20470 and not przebudzeni_bossowie.on_plateau() then
				return
			end
			setskin(NOWINDOW)
			command("cube open")
		end

		-- Handlarka Iluzji (P³askowy¿ Iluzji): her shop (world.shop 9551)
		when 20469.chat."Sklep" with przebudzeni_bossowie.on_plateau() begin
			setskin(NOWINDOW)
			npc.open_shop()
		end

		-- Baek-Go: Lekarstwo Iluzji
		when 20018.chat."Lekarstwo Iluzji" with pc.count_item(31145) > 0 begin
			local c = przebudzeni_bossowie.cfg()
			say_title(mob_name(20018)..":")
			say("Z 20 Liœci ¯ycia przygotujê ci Lekarstwo Iluzji -")
			say("od razu przywraca 500 P¯ i 500 PE.")
			say_item_vnum(c.medicine)
			local n = math.floor(pc.count_item(c.leaves) / c.leaves_count)
			if n < 1 then
				say_orange("Potrzebujê 20 Liœci ¯ycia (masz "..pc.count_item(c.leaves)..").")
				return
			end
			if select("Przygotuj (20 Liœci ¯ycia)", "Nie teraz") ~= 1 then
				return
			end
			if pc.count_item(c.leaves) < c.leaves_count then
				return
			end
			pc.remove_item(c.leaves, c.leaves_count)
			pc.give_item2(c.medicine, 1)
		end
	end
end
