-- Owsap: crack_skipia_dungeon.quest = awaken_skipia_dungeon.quest z wierszami "TR:"):
--   * w grocie: gdzie padnie Kapitan Yonghan (SZC) (4207 / 4208), pojawia siê Genera³ Yonghan (SZC) (4209 / 4210);
--     Krêty Klucz (SZC) (31160) zostawia tylko Genera³ po Kapitanie (SZC-110) - 4210 (wiki, tr-wiki, arkusz
--     w³aœciciela; Owsap daje klucz z ka¿dego);
--   * Duch Sura (SZC) (20510): przywódca, ca³a grupa przy nim, ka¿dy ma 3 Krête Klucze (SZC) - Œwi¹tynia Smoka (SZC);
--   * Beran-Setaou (SZC) (4400, b³yskawica, 122 poz.; przywo³uje Wojowników Setaou (SZC)) i cztery Metiny (8120-8123) -
--     dopóki stoi którykolwiek, smoka nie da siê zraniæ; po œmierci 20 000 000 Yang (tr-wiki).
-- Potwory nie daj¹ dropu, ale daj¹ wiêcej PD (wiki) - silnik nie upuszcza niczego na mapie 405 poza Yangami Berana
-- (server-patches/szczelina). 60 minut od wejœcia; po zwyciêstwie (minuta) lub po czasie wszyscy wracaj¹ na P³askowy¿
-- Iluzji (obok Statuy Szczeliny Czasu). Zegarek Kieszonkowy znika przy pierwszym wejœciu do nowej wyprawy. Panel lochów:
-- beran_szc. Boty nie wchodz¹ same - wyprawy botów
-- (MT2009_PLUS_BOT_YDG_V1) przez beran_szc_dgrun / beran_szc_dgrun_next.
-- GENERATED by tools/yohara_crack2/gen_ycrack2.py from beran_pb.quest - do not edit, rerun it.
-- cp1250; ¿aden napis nie koñczy siê polsk¹ liter¹ (qc).
quest beran_szc begin
	state start begin
		function cfg()
			return {
				map = 405, base_x = 0, base_y = 18176,
				entry = {877, 722}, ghost = {263, 180}, boss_room = {225, 173}, boss = {181, 173},
				stones = {{8120, 170, 160}, {8121, 190, 180}, {8122, 170, 182}, {8123, 192, 160}},
				path = "data/dungeon/beran_szc/",
				key = 31160, keys = 3, races = 9,
				limit = 3600, keep = 3600 + 300, ticket = 31147, end_sec = 60,
			}
		end

		function inside()
			local idx = pc.get_map_index()
			return idx >= 405 * 10000 and idx < 406 * 10000 and pc.in_dungeon()
		end

		function out()
			local m, x, y = pc.getf("szczelina_czasu", "ret_map"), pc.getf("szczelina_czasu", "ret_x"),
				pc.getf("szczelina_czasu", "ret_y")
			if m > 0 then
				pc.warp(x * 100, y * 100, m)
			else
				warp_to_village()
			end
		end

		function finish(text)
			d.setf("closed", 1)
			d.setf("mt2009_keep_until", 0)
			if text then
				d.notice(text)
			end
			d.exit_all()
		end

		function init()
			local c = beran_szc.cfg()
			d.setf("init", 1)
			d.setf("start", get_global_time())
			d.setf("mt2009_keep_until", get_global_time() + c.keep)
			d.setf("level", 0)
			d.regen_file(c.path.."npc.txt")
			d.set_regen_file(c.path.."regen.txt")
			d.notice("Grota Wygnañców 2 (SZC): masz 60 minut. Zdob¹dŸcie Krête Klucze (SZC) i odszukajcie Ducha Sura.")
			d.notice("Potwory Szczeliny Czasu nie daj¹ dropu, ale daj¹ wiêcej PD.")
			server_timer("beran_szc_tick", 60, d.get_map_index())
		end

		-- the temple: Beran-Setaou (SZC) with his guard (group 4212 - its leader's VID) and the four stones
		function temple()
			local c = beran_szc.cfg()
			d.setf("level", 2)
			d.clear_regen()
			d.kill_all()
			d.jump_all(c.base_x + c.boss_room[1], c.base_y + c.boss_room[2])
			d.set_regen_file(c.path.."boss.txt")
			for i, s in ipairs(c.stones) do
				d.set_unique("stone"..i, d.spawn_mob(s[1], s[2], s[3]))
			end
			local vid = d.spawn_group(4212, c.boss[1], c.boss[2], 5, true, 1)
			d.set_unique("beran", vid)
			if vid > 0 then
				for r = 0, c.races - 1 do
					d.set_damage_from_race(r, vid)
				end
			end
			d.notice("Œwi¹tynia Smoka (SZC): Beran-Setaou (SZC) czerpie moc z czterech Metinów.")
			d.notice("Dopóki stoi choæ jeden z nich, smoka nie da siê zraniæ.")
			clear_server_timer("beran_szc_watch", d.get_map_index()) -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
			server_timer("beran_szc_watch", 15, d.get_map_index())
		end

		-- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1 (the owner, 20 October: "popraw wszystkie dungi"): the dragon's shield
		-- fell only when a Metin's kill event came, so a last Metin that left without one (a kill the core gave no
		-- quest event, a Metin removed) kept Beran-Setaou (SZC) unhurtable until the hour ran out. The four are
		-- looked at every 15 s too (beran_szc_watch).
		-- MT2009_PLUS_DUNGEON_TARGET_RESPAWN_V1 (the owner, 20 October: "jak nie jest dotkniêty, to respi siê nowy czy coœ, bo to za du¿e u³atwienie, jak same siê bêd¹ zbija³y"):
		-- the shield falls only by the four kills (sk<i> = 1 at the kill event); a Metin not alive whose kill
		-- never counted comes back at its place (same race, same unique).
		function stones_left()
			local left = 0
			for i = 1, 4 do
				if d.getf("sk"..i) == 0 then
					left = left + 1
				end
			end
			return left
		end

		function stone_down(vid)
			for i = 1, 4 do
				if d.getf("sk"..i) == 0 and d.get_unique_vid("stone"..i) == vid then
					d.setf("sk"..i, 1)
				end
			end
		end

		function respawn_stones()
			local c = beran_szc.cfg()
			local n = 0
			for i = 1, 4 do
				if d.getf("sk"..i) == 0 and d.is_unique_dead("stone"..i) then
					local st = c.stones[i]
					d.set_unique("stone"..i, d.spawn_mob(st[1], st[2], st[3]))
					n = n + 1
				end
			end
			if n > 0 then
				d.notice("Zaginione Metiny pojawiaj¹ siê ponownie ("..n..").")
			end
		end

		function shield_off()
			if d.getf("shield_off") == 1 then
				return
			end
			d.setf("shield_off", 1)
			local vid = d.get_unique_vid("beran")
			if vid > 0 then
				d.reset_damage_from_race(vid)
			end
			d.notice("Ostatni Metin pad³ - Beran-Setaou (SZC) straci³ swoj¹ tarczê!")
		end

		when beran_szc_watch.server_timer begin
			if not d.select(get_server_timer_arg()) or d.getf("closed") == 1 or d.getf("level") ~= 2 or d.getf("shield_off") == 1 then
				return
			end
			beran_szc.respawn_stones() -- MT2009_PLUS_DUNGEON_TARGET_RESPAWN_V1
			server_timer("beran_szc_watch", 15, get_server_timer_arg())
		end

		when login with beran_szc.inside() begin
			local c = beran_szc.cfg()
			local idx = pc.get_map_index()
			if pc.is_playerbot() then
				return
			end
			local m = pc.getf("szczelina_czasu", "ret_map")
			if m > 0 then
				pc.set_warp_location(m, pc.getf("szczelina_czasu", "ret_x"), pc.getf("szczelina_czasu", "ret_y"))
			end
			if d.getf("closed") == 1 then
				syschat("Grota Wygnañców 2 (SZC): ta wyprawa ju¿ siê skoñczy³a.")
				beran_szc.out()
				return
			end
			if pc.getf("szczelina_czasu", "idx") ~= idx then
				if not pc.is_gm() then
					if pc.count_item(c.ticket) < 1 then
						syschat("Grota Wygnañców 2 (SZC): potrzebujesz Zegarka Kieszonkowego.")
						beran_szc.out()
						return
					end
					pc.remove_item(c.ticket, 1)
				end
				pc.setf("szczelina_czasu", "idx", idx)
				pc.setf("szczelina_czasu", "entry", get_global_time())
			end
			d.setf("entered", 1)
			if d.getf("init") == 0 then
				beran_szc.init()
			end
			if d.getf("level") == 2 and math.abs(pc.get_local_x() - c.boss_room[1]) > 80 then
				pc.warp((c.base_x + c.boss_room[1]) * 100, (c.base_y + c.boss_room[2]) * 100, idx)
			end
		end

		-- the time
		when beran_szc_tick.server_timer begin
			local c = beran_szc.cfg()
			if not d.select(get_server_timer_arg()) or d.getf("closed") == 1 then
				return
			end
			local left = d.getf("start") + c.limit - get_global_time()
			if left <= 0 then
				beran_szc.finish("Grota Wygnañców 2 (SZC): czas min¹³ - wracacie na P³askowy¿ Iluzji.")
				return
			end
			local m = math.floor((left + 30) / 60)
			if m == 45 or m == 30 or m == 15 or m == 5 or m == 1 then
				d.notice("Grota Wygnañców 2 (SZC): zosta³o "..m.." min. Po czasie grupa wróci na P³askowy¿ Iluzji.")
			end
			server_timer("beran_szc_tick", 60, get_server_timer_arg())
		end

		-- MT2009_PLUS_YOHARA_CRACK2_V1 (the keys): the pl-wiki "Genera³ Yonghan (SZC)" / "Kapitan Yonghan (SZC-110)", the tr-wiki
		-- "ZC: General Yonghan (110)" and the owner's sheet - a General Yonghan (SZC) appears where a Captain fell
		-- (SZC-116 4207 -> 4209, SZC-110 4208 -> 4210); only 4210 leaves a Krêty Klucz (SZC) (Owsap: every Yonghan)
		when 4207.kill with beran_szc.inside() and d.getf("level") == 0 begin
			d.spawn_mob(4209, pc.get_local_x(), pc.get_local_y())
		end

		when 4208.kill with beran_szc.inside() and d.getf("level") == 0 begin
			d.spawn_mob(4210, pc.get_local_x(), pc.get_local_y())
		end

		when 4210.kill with beran_szc.inside() and d.getf("level") == 0 begin
			game.drop_item(beran_szc.cfg().key, 1)
		end

		-- Duch Sura (SZC): the way into Œwi¹tynia Smoka (SZC)
		when 20510.chat."Chcê zabiæ tego smoka!" with beran_szc.inside() and d.getf("closed") == 0 and d.getf("level") == 0 and npc.lock() begin
			local c = beran_szc.cfg()
			say_title(mob_name(20510)..":")
			if not pc.is_gm() and not party.is_party() then
				say("Do Œwi¹tyni Smoka wchodzi siê tylko w grupie.")
				npc.unlock()
				return
			end
			if party.is_party() and not party.is_leader() and not pc.is_gm() then
				say("Tylko przywódca grupy mo¿e otworzyæ portal.")
				npc.unlock()
				return
			end
			if party.is_party() and not d.all_near_to(pc.get_x(), pc.get_y()) then
				say("Cz³onek grupy jest za daleko. Zbierzcie siê przy mnie.")
				npc.unlock()
				return
			end
			say("Portal do Œwi¹tyni Smoka otworz¹ trzy Krête Klucze")
			say("(SZC) od ka¿dego z was.")
			say_item_vnum(c.key)
			if select("Tak, tak uczyñ.", "Nie, zostanê tutaj.") ~= 1 then
				npc.unlock()
				return
			end
			local pids = {pc.get_player_id()}
			if party.is_party() then
				pids = {party.get_member_pids()}
			end
			local missing = {}
			local members = {}
			for i, pid in next, pids, nil do
				q.begin_other_pc_block(pid)
				if pc.get_player_id() == pid and not pc.is_playerbot() and pc.get_map_index() == d.get_map_index() then
					table.insert(members, pid)
					if pc.count_item(c.key) < c.keys and not pc.is_gm() then
						table.insert(missing, pc.get_name())
					end
				end
				q.end_other_pc_block()
			end
			if table.getn(missing) > 0 then
				say_title(mob_name(20510)..":")
				say("Nie posiadasz wystarczaj¹cej iloœci kluczy! Aby")
				say("uaktywniæ portal, potrzebujê 3x")
				say_item_vnum(c.key)
				for i, n in next, missing, nil do say(color(1, 1, 0).."    "..n) end
				npc.unlock()
				return
			end
			for i, pid in next, members, nil do
				q.begin_other_pc_block(pid)
				if pc.get_player_id() == pid and not pc.is_gm() then
					pc.remove_item(c.key, c.keys)
				end
				q.end_other_pc_block()
			end
			npc.unlock()
			beran_szc.temple()
		end

		-- the temple's stones: one time in three a Yonghan troop where it fell (Owsap); the last one takes the dragon's
		-- shield away
		when 8120.kill or 8121.kill or 8122.kill or 8123.kill with beran_szc.inside() and d.getf("level") == 2 begin
			if number(1, 3) == 1 then
				local g = {4208, 4208, 4209, 4209, 4210}
				d.spawn_group(g[number(1, table.getn(g))], pc.get_local_x(), pc.get_local_y(), 1, true, 1)
			end
			beran_szc.stone_down(npc.get_vid()) -- MT2009_PLUS_DUNGEON_TARGET_RESPAWN_V1
			local left = beran_szc.stones_left() -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
			if left > 0 then
				d.notice("Metin pad³. Beran-Setaou (SZC) czerpie jeszcze moc z "..left..".")
				return
			end
			beran_szc.shield_off() -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1 (the shield's end moved there)
		end

		when 4400.kill with beran_szc.inside() and d.getf("level") == 2 and d.getf("closed") == 0 begin
			local c = beran_szc.cfg()
			d.setf("closed", 1)
			d.setf("won", 1) -- MT2009_PLUS_BOT_YDG_V1: the bots' runs read it
			d.update_ranking("beran_szc", get_global_time() - d.getf("start"))
			d.clear_regen()
			d.notice("Beran-Setaou (SZC) zosta³ pokonany!")
			d.notice("Wszyscy wojownicy wróc¹ na P³askowy¿ Iluzji za minutê.")
			server_timer("beran_szc_end", c.end_sec, d.get_map_index())
		end

		when beran_szc_end.server_timer begin
			if d.select(get_server_timer_arg()) then
				d.setf("mt2009_keep_until", 0)
				d.exit_all()
			end
		end

		-- MT2009_PLUS_BOT_YDG_V1: a bots' run (playerbot_dungeon_runs_ydg.h): the core makes the instance, marks it with
		-- the dungeon flag mt2009_dgrun (nothing a player can set) and asks for init() through this timer; the hour,
		-- the end and the way back stay the players' (beran_szc_tick, d.exit_all)
		when beran_szc_dgrun.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("mt2009_dgrun") == 1 and d.getf("init") == 0 then
					beran_szc.init()
				end
			end
		end

		-- MT2009_PLUS_BOT_YDG_V1: Duch Sura's way into the temple for a bots' run: the core has taken the keys of every
		-- member inside (each one's three, as the ghost does) and set bot_keys
		when beran_szc_dgrun_next.server_timer begin
			if not d.select(get_server_timer_arg()) then
				return
			end
			if d.getf("mt2009_dgrun") ~= 1 or d.getf("init") == 0 or d.getf("closed") == 1 or d.getf("level") ~= 0 then
				return
			end
			if d.getf("bot_keys") == 1 then
				beran_szc.temple()
			end
		end
	end
end
