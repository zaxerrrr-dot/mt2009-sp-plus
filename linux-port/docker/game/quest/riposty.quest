			say(string.format("Obra¿enia twojej umiejêtnoœci %s wzrastaj¹.", riposty.skill(vnum)))
			say("Znajdziesz go w oknie umiejêtnoœci (8. pole).")
		end

		when 50525.use begin
			local STONE = 50525
			say_title("Kamieñ Duchowy+")
