			if riposty.note(vnum) != "" then
				say(riposty.note(vnum))
			end
			say_reward("Poziom 1: 1,2%, M1: 12%, G1: 19,7%, P: 30%.")
			say("Rozwój: punkty umiejêtnoœci lub ksiêgi riposty (do M1),")
			say("ksiêgi (do G1), Kamieñ Duchowy+ (do P).")
			say("Chcesz opanowaæ tê ripostê?")
			if select("Naucz siê teraz", "Anuluj") != 1 then
				return
			end
			if pc.count_item(BOOK) < 1 then
				return
			end
			local r = pc.learn_passive_skill(vnum)
			say_title(riposty.name(vnum))
			if r != 0 then
				say(riposty.why(r))
				return
			end
			pc.remove_item(BOOK, 1)
			char_log(vnum, "RIPOSTA_LEARN", "50515")
			say_reward(string.format("W³adasz teraz umiejêtnoœci¹ %s!", riposty.name(vnum)))
			say(string.format("Obra¿enia od: %s (%s) ulegaj¹ redukcji.", riposty.skill(vnum), riposty.owner(vnum)))
			say("Znajdziesz j¹ w oknie umiejêtnoœci (7. pole) - plusem")
			say("dodajesz punkty umiejêtnoœci, ksiêg¹ riposty j¹ szkolisz.")
		end

		when 50514.use begin
			local BOOK = 50514
			say_title("Podrêcznik: Dopalacz")
			local have = pc.get_boost()
			if have != 0 then
				say(string.format("Znasz ju¿ dopalacz: %s (%s).", riposty.name(have), riposty.grade(pc.get_skill_level(have))))
				say("Zwój Zmiany Treningu usuwa ripostê i dopalacz.")
