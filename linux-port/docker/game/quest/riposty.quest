			return "Riposta: " .. riposty.skill(vnum)
		end

		function note(vnum)
			-- the names players mix up (zg³oszenie #8)
			if vnum == 225 or vnum == 240 then
				return "To umiejêtnoœæ Wojownika Mental - nie Duchowy Cios Sury BM."
			elseif vnum == 227 or vnum == 242 then
				return "To pierwsza umiejêtnoœæ Sury BM - nie Duchowy Cios ani Mroczna Sfera."
			end
			return ""
		end

		function grade(level)
			if level >= 40 then
				return "P"
			elseif level >= 30 then
				return "G" .. (level - 29)
			elseif level >= 20 then
				return "M" .. (level - 19)
			end
			return "" .. level
		end

		function why(code)
			if code == 1 then
				return "Najpierw ukoñcz Szkolenie - wybierz drogê umiejêtnoœci u nauczyciela swojej klasy."
			elseif code == 2 then
				return "Wymagany jest co najmniej 5. poziom postaci."
			elseif code == 3 then
				return "Znasz ju¿ tê umiejêtnoœæ - wystarczy j¹ rozwijaæ."
			elseif code == 4 then
				return "Dopalacza nauczysz siê, gdy rozwiniesz dowoln¹ ripostê do poziomu P."
			end
			return "Tej umiejêtnoœci nie mo¿esz siê nauczyæ."
		end

		function change_info()
			say("Riposta jest jedna. Aby wybraæ inn¹, u¿yj Zwoju Zmiany")
			say("Treningu (Item-Shop: Zwoje i ksiêgi) - usunie on")
			say("ripostê i dopalacz, a wydane na nie punkty umiejêtnoœci wróc¹.")
			say("Potem u¿yj Podrêcznika: Riposta jeszcze raz.")
		end

		when 50515.use begin
			local BOOK = 50515
			say_title("Podrêcznik: Riposta")
			local have = pc.get_riposte()
			if have != 0 then
				say(string.format("Znasz ju¿ ripostê: %s (%s),", riposty.name(have), riposty.grade(pc.get_skill_level(have))))
				say(string.format("przeciw umiejêtnoœci klasy %s.", riposty.owner(have)))
				riposty.change_info()
				return
			end
			if pc.get_skill_group() == 0 then
				say(riposty.why(1))
				return
			end
			if pc.get_level() < 5 then
				say(riposty.why(2))
				return
			end
			say("Ta prastara ksiêga pozwala wybraæ jedn¹ z oœmiu ripost.")
			say("Riposta zmniejsza obra¿enia, które otrzymujesz od jednej")
			say("umiejêtnoœci przeciwnika - obok nazwy jest klasa i droga,")
			say("która jej u¿ywa. Mo¿esz znaæ tylko jedn¹ ripostê.")
			local list = {}
			for v = 221, 228 do
				table.insert(list, string.format("%s (%s)", riposty.skill(v), riposty.owner(v)))
			end
			table.insert(list, "Anuluj")
			local s = select_table(list)
			if s == table.getn(list) then
				return
			end
			local vnum = 220 + s
			say_title(riposty.name(vnum))
			say("Zmniejsza obra¿enia otrzymywane od umiejêtnoœci:")
