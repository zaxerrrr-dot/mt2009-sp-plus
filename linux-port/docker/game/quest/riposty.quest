-- zmiana riposty jak na wiki: Zwój Zmiany Treningu (Item-Shop, "Zwoje i ksiêgi", 49 SM - apply.sh ripost_zwoj_632),
-- potem nowy Podrêcznik: Riposta.
-- cp1250; ¿aden napis nie koñczy siê polsk¹ liter¹ (qc).
quest riposty begin
	state start begin
		function skill(vnum)
			-- the attack skill of a riposte (221-228) / boost (236-243) and the class and path it belongs to (the wiki)
			local skills = {
				"Wir Miecza", "Zasadzka", "Uderzenie Palcem", "Strzelaj¹cy Smok", "Duchowe Uderzenie",
				"Ognista Strza³a", "Mroczne Uderzenie", "Przywo³anie B³yskawicy",
			}
			local i = vnum - 220
			if vnum >= 236 then
				i = vnum - 235
			end
			return skills[i] or ("umiejêtnoœæ " .. vnum)
		end

		function owner(vnum)
			local owners = {
				"Wojownik Body", "Ninja Dagger", "Sura WP", "Szaman Smok", "Wojownik Mental",
				"Ninja Archer", "Sura BM", "Szaman Healer",
			}
			local i = vnum - 220
			if vnum >= 236 then
				i = vnum - 235
