			end
			if pc.get_level() < 5 then
				say(riposty.why(2))
				return
			end
			say("Dopalacz zwiêksza obra¿enia zadawane jedn¹ umiejêtnoœci¹.")
			say("Ka¿da klasa i droga ma z góry ustalony dopalacz.")
			say(string.format("Twoja droga: %s - twój dopalacz to:", riposty.owner(vnum)))
			say_reward(riposty.name(vnum))
			if riposty.note(vnum) != "" then
				say(riposty.note(vnum))
			end
			say_reward("Poziom 1: 0,8%, M1: 8%, G1: 13,1%, P: 20%.")
			local r = pc.get_riposte()
			if r == 0 or pc.get_skill_level(r) < 40 then
				say(riposty.why(4))
