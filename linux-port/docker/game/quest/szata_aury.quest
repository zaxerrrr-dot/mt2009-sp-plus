				items = { {31137, 1}, {51001, 200}, {31135, 1} },   -- £adny Kamieñ Chaosu, Od³amek Energii, Wyj¹tkowy Barwnik
			}
		end

		when 60003.chat."Szata aury: przenieœ parametry" begin
			say_title(mob_name(60003)..":")
			say("Mogê przenieœæ na szatê aury parametry bransolety,")
			say("naszyjnika, kolczyków albo tarczy - te podstawowe")
			say("i te dodane. Im wy¿szy poziom szaty, tym wiêksza")
			say("jest czêœæ parametrów, któr¹ da (poziom 250 - 25%).")
			say("")
			say_reward("Przedmiot, z którego przeniesiesz parametry, zniknie.")
			say_reward("Szata nie mo¿e mieæ ju¿ przeniesionych parametrów -")
