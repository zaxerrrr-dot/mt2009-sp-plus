			say("8000 albo 16000 punktów - zale¿nie od jej rodzaju.")
			say("")
			say_reward("Na poziomie 49, 99, 149, 199 i 249 z pe³nym")
			say_reward("doœwiadczeniem szata czeka na ewolucjê.")
			say_reward("Biorê tylko tyle run, ile trzeba.")
			if select("Otwórz okno", "Anuluj") == 1 then
				setskin(NOWINDOW)
				game.open_aura(1)
			end
		end

		when 60003.chat."Szata aury: ewolucja" begin
			say_title(mob_name(60003)..":")
			say("Szatê ze szczytu jej rodzaju zmieniê w nastêpn¹:")
			say("Prosta - 10x Agat i 5 000 000 Yang,")
			say("Szlachetna - 10x Prosty Kamieñ Chaosu i 5 000 000 Yang,")
			say("B³yszcz¹ca - 10x £adny Kamieñ Chaosu i 5 000 000 Yang,")
			say("Wytworna - 10x Wspania³y Kamieñ Chaosu i 8 000 000 Yang,")
			say("Promienista - 20x Wspania³y Kamieñ Chaosu i 10 000 000 Yang.")
			say("")
			say_reward("Ewolucja zawsze siê udaje i daje +1 poziom,")
			say_reward("przeniesione parametry zostaj¹.")
			if select("Otwórz okno", "Anuluj") == 1 then
				setskin(NOWINDOW)
