		when 20018.chat."Szata Aury" begin
			local c = szata_aury.craft()
			say_title(mob_name(20018)..":")
			say("Mogê wytworzyæ dla ciebie "..item_name(c.result)..".")
			say("Przenosi ona parametry bi¿uterii, a u Theowahdana")
			say("rozwiniesz j¹ a¿ do poziomu 250.")
			say("")
			say_reward("Potrzebujê: 1x "..item_name(31137)..", 200x "..item_name(51001)..",")
