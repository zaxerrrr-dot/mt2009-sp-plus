-- MT2009_PLUS_BIOLOGIST_YOHARA_V1: Badanie Seona-Pyeonga (poz. 92) - pl-wiki "Misje Biologa" / "Badanie
-- Seona-Pyeonga" (the owner, 29 October 2026: "dodaj kolejne misje Biologa wed³ug wiki"). The package's
-- collect_quest_lv92 is an empty stub (state start, state run), while collect_quest_lv90 sets it to "run" at its
-- end - so every character that finished Notatki Przywódcy already stands in "run" here and its next login (or
-- level-up, or a talk with Seon-Pyeong) opens the mission. The state names start / run / __complete are the stub's
-- and the package's (__complete: /usunmisje, the panel's Biologist page).
--   Seon-Pyeong (20091, przy wejœciu do Groty Wygnañców) wants 10 Klejnotów Zawiœci (30251), one a hand-in, 60%
--   accepted (the wiki: "szansa stosunkowo niska", Owsap's 60), the wait between hand-ins the Biologist's own
--   (collect_data: the world's M2_BIOLOGIST_WAIT_HOURS; Spirala Czasu / Eliksir Poszukiwacza as on every row).
--   The gem: Podziemny Lod. Cz³owiek (1135) and Podziemny Lodowy Golem (1137) in the Grotto, 1 in 200 while the
--   mission waits for it (Owsap's rate), and 5 in Skrzynia Hydry (game/shipdefense).
--   Reward, chosen by the player (permanent, AFFECT_COLLECT): +51 Wartoœci Ataku (POINT_ATT_GRADE_BONUS, as lv60's
--   +50), +120 Obrony (POINT_DEF_GRADE_BONUS, as lv50's +60) or +1000 P¯ (POINT_MAX_HP). Then collect_quest_lv94.
-- cp1250; no string ends with a Polish letter (qc).
quest collect_quest_lv92 begin
	state start begin
		function intro()
			say_title(mob_name(20091)..":")
			say("Badam klejnoty, które powstaj¹ w lodzie Groty")
			say("Wygnañców. Najciekawsze s¹ Klejnoty Zawiœci -")
			say("ich blask zmienia siê pod wp³ywem emocji.")
			say("")
			say("Przynieœ mi 10 Klejnotów Zawiœci. Przynoœ je")
			say("pojedynczo - ka¿dy muszê dok³adnie zbadaæ,")
			say("a nie ka¿dy nadaje siê do badañ.")
			say_item_vnum(30251)
			say_reward("Klejnoty Zawiœci wypadaj¹ z Podziemnych Lod.")
			say_reward("Ludzi i Podziemnych Lodowych Golemów")
			say_reward("w Grocie Wygnañców (oraz ze Skrzyni Hydry).")
		end

		function rewards()
			return { { POINT_ATT_GRADE_BONUS, 51, "+51 Wartoœci Ataku" },
				 { POINT_DEF_GRADE_BONUS, 120, "+120 Obrony" },
				 { POINT_MAX_HP, 1000, "+1000 P¯ (maks.)" } }
		end
	end

	state run begin
		when login or levelup with pc.get_level() >= 92 begin
			set_state(information)
		end

		when 20091.chat."Badanie Seona-Pyeonga" with pc.get_level() >= 92 begin
			collect_quest_lv92.intro()
			pc.setqf("collect_count", 0)
			set_state(go_to_disciple)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20091)
			if v ~= 0 then
				target.vid("__TARGET__", v, mob_name(20091))
			end
			send_letter("Badanie Seona-Pyeonga")
		end

		when button or info begin
			say_title("Badanie Seona-Pyeonga")
			say("Seon-Pyeong, badacz przy wejœciu do Groty")
			say("Wygnañców w Dolinie Orków, szuka pomocy.")
			say("Porozmawiaj z nim.")
		end

		when __TARGET__.target.click or 20091.chat."Badanie Seona-Pyeonga" begin
			target.delete("__TARGET__")
			collect_quest_lv92.intro()
			pc.setqf("collect_count", 0)
			set_state(go_to_disciple)
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter("Badanie Seona-Pyeonga")
			-- MT2009_PLUS_SPIRALA_CZASU_V2: the research's wait as a clock in the letter at every login too (the
			-- stock collect_quest_lv30 does it), not only right after a hand-in; Spirala Czasu sets it again
			-- (q.set_clock_of) the moment it cuts the wait
			collect_data.send_delay()
		end

		when button or info begin
			say_title("Badanie Seona-Pyeonga")
			say("Przynieœ Seon-Pyeongowi 10 Klejnotów Zawiœci,")
			say("po jednym. Wypadaj¹ z Podziemnych Lod. Ludzi")
			say("i Podziemnych Lodowych Golemów w Grocie.")
			say_item_vnum(30251)
			say_reward(string.format("Przyjête klejnoty: %d / 10", pc.getqf("collect_count")))
			collect_data.say_delay()
		end

		when 1135.kill or 1137.kill begin
			if number(1, 200) == 1 then
				pc.give_item2(30251, 1)
			end
		end

		when 20091.chat."Oddaj Klejnot Zawiœci" with pc.count_item(30251) > 0 begin
			say_title(mob_name(20091)..":")
			if collect_data.is_wait() then
				say("Wci¹¿ badam poprzedni klejnot. Wróæ,")
				say("gdy skoñczê.")
				collect_data.say_delay()
				return
			end
			if pc.count_item(30251) < 1 then
				say("Nie masz przy sobie Klejnotu Zawiœci.")
				return
			end
			pc.remove_item(30251, 1)
			local show_wait = not collect_data.is_no_time_on_fail()
			local ok = collect_data.take_chance(60)
			local n = pc.getqf("collect_count")
			if ok then
				n = n + 1
				pc.setqf("collect_count", n)
				if n >= 10 then
					pc.setqf("collect_count", 0)
					collect_data.reset_time()
					set_state(__reward)
				end
			end
			say("Poka¿ mi go... Zobaczmy, co skrywa ten blask.")
			wait()
			say_title(mob_name(20091)..":")
			if not ok then
				say("Niestety, ten klejnot jest zmêtnia³y - nie")
				say("nadaje siê do badañ. Przynieœ mi inny.")
				if show_wait then
					collect_data.say_delay()
				end
				return
			end
			if n >= 10 then
				say("Wspaniale! Mam ju¿ wszystkie 10 Klejnotów")
				say("Zawiœci. W nagrodê przeka¿ê ci czêœæ mocy,")
				say("któr¹ z nich wydoby³em. Wybierz, co chcesz.")
				say("")
				say_reward("Porozmawiaj ze mn¹: Nagroda za badania")
				return
			end
			say("Doskona³y okaz! Dziêkujê.")
			say_reward(string.format("Brakuje jeszcze %d klejnotów.", 10 - n))
			collect_data.say_delay()
		end
	end

	state __reward begin
		when letter begin
			local v = find_npc_by_vnum(20091)
			if v ~= 0 then
				target.vid("__TARGET__", v, mob_name(20091))
			end
			send_letter("Badanie Seona-Pyeonga: nagroda")
		end

		when button or info begin
			say_title("Badanie Seona-Pyeonga")
			say("Seon-Pyeong ma ju¿ wszystkie Klejnoty Zawiœci.")
			say("Odbierz od niego nagrodê - jeden sta³y bonus")
			say("do wyboru.")
		end

		when __TARGET__.target.click or 20091.chat."Nagroda za badania" begin
			target.delete("__TARGET__")
			local r = collect_quest_lv92.rewards()
			say_title(mob_name(20091)..":")
			say("Dziêki tobie moje badania s¹ ukoñczone.")
			say("Wybierz jeden sta³y bonus:")
			local s = select(r[1][3], r[2][3], r[3][3], "Wybiorê póŸniej")
			if s == nil or s < 1 or s > 3 then
				return
			end
			pc.setqf("reward", s)
			set_state(__complete)
			affect.add_collect(r[s][1], r[s][2])
			say_title(mob_name(20091)..":")
			say("Moc klejnotów jest teraz twoja na zawsze.")
			say_reward("Sta³y bonus: "..r[s][3])
			set_quest_state("collect_quest_lv94", "run")
			clear_letter()
		end
	end

	state __complete begin
	end
end
