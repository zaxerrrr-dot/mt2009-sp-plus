-- MT2009_PLUS_NAJEMNICY_V1: Najemnicy - sta³a dru¿yna botów gracza (w³aœciciel, 8 listopada 2026,
-- /opt/metin2/cache/yohara/najemnicy-plan.md). Etap 1: list "Najemnicy" (od 80 poziomu, w panelu misji - dostêpny
-- wszêdzie, bez NPC) jest ca³ym interfejsem: tworzenie, lista, wezwanie i odwo³anie, skarbiec, ekwipunek (etap 2:
-- okno ekwipunku najemnika, "najemnicy okno <nr>"; zostaje te¿ "zabierz wszystko" i "daj" po numerze pola), gildia
-- i zwolnienie najemnika.
--
-- Ca³¹ pracê robi komenda serwera /najemnicy (playerbot_najemnicy.h, server-patches/najemnicy): przed menu
-- "najemnicy sync" ustawia flagi tego questa (unlocked, slots, tasks_view, count, summoned - bit na miejsce, price_h, off),
-- a lista i skarbiec s¹ czytane z bazy (mysql_direct_query, tylko odczyt, tylko wiersze tej postaci).
-- Odblokowanie: Kolekcjoner Najemników (6 zadañ; okno i oddawanie przedmiotów to osobny etap z ³atk¹ klienta).
-- Miejsca = ukoñczone zadania, które maj¹ ju¿ swój poziom: 1 + 80 -> 2, 2 + 85 -> 3, 3 + 90 -> 4, 4 + 95 -> 5,
-- 5 + 100 -> 6, 6 + 105 -> 7. Licznik: flaga najemnicy.tasks (podniesie j¹ quest Kolekcjonera) albo wiersz
-- player.najemnicy_unlock (GM: /najemnicy odblokuj|zadania <nick>, panel Seban); flaga zdarzenia
-- m2_najemnicy_free_unlock 1 = wszyscy 6/6 (testy). Bot (tak¿e sam najemnik) listu nie dostaje.
quest najemnicy begin
	state start begin
		when login with not pc.is_playerbot() and pc.get_level() >= 80 begin
			command("najemnicy sync")
			if pc.getqf("off") == 0 then
				send_letter("Najemnicy")
			end
		end

		when levelup with not pc.is_playerbot() and pc.get_level() >= 80 begin
			command("najemnicy sync")
			if pc.getqf("off") == 0 then
				send_letter("Najemnicy")
			end
		end

		when button or info begin
			-- mysql_direct_query: na mt2009 najpierw liczba wierszy, potem tabela (web_admin.quest).
			local function nj_query(q)
				if mysql_direct_query == nil then
					return {}
				end
				local a, b = mysql_direct_query(q)
				if type(a) == "table" then
					return a
				end
				if type(b) == "table" then
					return b
				end
				return {}
			end
			local function nj_yang(n)
				n = math.floor(tonumber(n) or 0)
				if n >= 1000000 then
					local kk = math.floor(n / 1000000)
					local rest = math.floor((n - kk * 1000000) / 1000)
					if rest > 0 then
						return tostring(kk) .. " kk " .. tostring(rest) .. " k"
					end
					return tostring(kk) .. " kk"
				end
				return tostring(n)
			end
			local classes = { [0] = "Wojownik", [1] = "Ninja", [2] = "Sura", [3] = "Szaman" }
			local paths = { [0] = { "Cia³o", "Mental" }, [1] = { "Skrytobójca", "£ucznik" }, [2] = { "Broñ - ostrze", "Czarna Magia" },
				[3] = { "Smok", "Leczenie" } }
			local function nj_label(row)
				local job = math.mod(tonumber(row.job) or 0, 4)
				local g = tonumber(row.skill_group) or 1
				if g ~= 2 then
					g = 1
				end
				return row.name .. " (" .. classes[job] .. " " .. paths[job][g] .. ")"
			end
			local function nj_rows()
				return nj_query("SELECT slot, name, job, skill_group FROM player.najemnicy WHERE owner_pid=" ..
					pc.get_player_id() .. " AND retired=0 ORDER BY slot")
			end
			local function nj_summoned(slot)
				local mask = pc.getqf("summoned")
				local bit = 1
				for i = 1, slot do
					bit = bit * 2
				end
				return math.mod(math.floor(mask / bit), 2) == 1
			end
			local function nj_balance()
				local r = nj_query("SELECT balance FROM player.najemnicy_vault WHERE owner_pid=" .. pc.get_player_id())
				if r[1] ~= nil and r[1].balance ~= nil then
					return tonumber(r[1].balance) or 0
				end
				return 0
			end
			-- Jeden najemnik z listy (albo "wszyscy"); 0 = rezygnacja.
			local function nj_pick(title, all)
				local rows = nj_rows()
				if table.getn(rows) == 0 then
					say_title(title)
					say("Nie masz jeszcze ¿adnego najemnika.")
					return 0, nil
				end
				local names = {}
				for i = 1, table.getn(rows) do
					local mark = ""
					if nj_summoned(tonumber(rows[i].slot)) then
						mark = " - wezwany"
					end
					table.insert(names, tostring(rows[i].slot) .. ". " .. nj_label(rows[i]) .. mark)
				end
				if all then
					table.insert(names, "Wszyscy")
				end
				table.insert(names, "Wstecz")
				say_title(title)
				say("Którego najemnika?")
				local c = select_table(names)
				if c > table.getn(rows) then
					if all and c == table.getn(rows) + 1 then
						return -1, nil
					end
					return 0, nil
				end
				return tonumber(rows[c].slot), rows[c]
			end

			command("najemnicy sync")
			say_title("Najemnicy")
			if pc.getqf("off") ~= 0 then
				say("Najemnicy s¹ teraz wy³¹czeni na tym serwerze.")
				return
			end
			if pc.getqf("unlocked") == 0 then
				say("Od 80 poziomu mo¿esz wynaj¹æ sta³¹ dru¿ynê:")
				say("najemników, którzy chodz¹ z tob¹, walcz¹,")
				say("i zdobywaj¹ doœwiadczenie w twojej grupie.")
				say("")
				say("Najemnicy nie s¹ jeszcze dla ciebie odblokowani.")
				say("Odblokowuje ich Kolekcjoner Najemników: ka¿de")
				say("z 6 zadañ daje kolejnego najemnika, gdy masz")
				say("ju¿ jego poziom (1 zadanie + 80 poz. = 2 miejsca,")
				say("2 + 85 = 3, 3 + 90 = 4, 4 + 95 = 5, 5 + 100 = 6,")
				say("6 + 105 = 7). Ukoñczone zadania: " .. pc.getqf("tasks_view") .. " z 6.")
				return
			end
			local slots = pc.getqf("slots")
			local count = pc.getqf("count")
			local price = pc.getqf("price_h")
			say("Najemnicy: " .. count .. " z " .. slots .. " miejsc. Zadania Kolekcjonera:")
			say(pc.getqf("tasks_view") .. " z 6 (ka¿de daje miejsce od swojego poziomu).")
			say("Skarbiec: " .. nj_yang(nj_balance()) .. " yang. Op³ata: " .. nj_yang(price) .. " yang")
			say("za godzinê za ka¿dego wezwanego najemnika.")
			local m = select("Lista najemników", "Stwórz najemnika", "Wezwij", "Odwo³aj", "Skarbiec",
				"Ekwipunek", "Gildia", "Zwolnij najemnika", "Zamknij")

			if m == 1 then
				local rows = nj_rows()
				say_title("Twoi najemnicy")
				if table.getn(rows) == 0 then
					say("Nie masz jeszcze ¿adnego najemnika.")
					return
				end
				for i = 1, table.getn(rows) do
					local mark = ""
					if nj_summoned(tonumber(rows[i].slot)) then
						mark = " - wezwany"
					end
					say(tostring(rows[i].slot) .. ". " .. nj_label(rows[i]) .. mark)
				end
				say("")
				say("Poziom = twój poziom, umiejêtnoœci = po³owa")
				say("twoich (liczona od M1), statystyki pod drogê.")

			elseif m == 2 then
				if count >= slots then
					say_title("Stwórz najemnika")
					say("Wszystkie miejsca s¹ zajête.")
					say("Wiêcej miejsc daj¹ zadania Kolekcjonera")
					say("Najemników razem z poziomem.")
					return
				end
				say_title("Stwórz najemnika")
				say("Jaka ma byæ jego klasa?")
				local c = select("Wojownik", "Ninja", "Sura", "Szaman", "Wstecz")
				if c == 5 then
					return
				end
				say_title("Stwórz najemnika")
				say("Kobieta czy mê¿czyzna?")
				local s = select("Mê¿czyzna", "Kobieta")
				-- player.job: 0 wojownik, 1 ninja, 2 sura, 3 szaman w p³ci, w jakiej klasa powsta³a, + 4 druga p³eæ.
				local male = { 0, 5, 2, 7 }
				local female = { 4, 1, 6, 3 }
				local race = male[c]
				if s == 2 then
					race = female[c]
				end
				say_title("Stwórz najemnika")
				say("Jaka droga?")
				local g = select(paths[c - 1][1], paths[c - 1][2])
				say_title("Stwórz najemnika")
				say("Jak ma siê nazywaæ?")
				say("Od 3 do 16 liter i cyfr, bez polskich znaków")
				say("i spacji. Imiê musi byæ wolne na serwerze.")
				local name = input()
				if name == nil or name == "" then
					return
				end
				command("najemnicy stworz " .. race .. " " .. g .. " " .. name)
				command("najemnicy sync")
				say_title("Stwórz najemnika")
				if pc.getqf("count") > count then
					say(name .. " jest twoim najemnikiem.")
					say("Wezwij go: list Najemnicy, Wezwij.")
				else
					say("Nie uda³o siê - powód jest na czacie.")
				end

			elseif m == 3 then
				local slot = nj_pick("Wezwij", true)
				if slot == 0 then
					return
				end
				if slot == -1 then
					command("najemnicy wezwij wszyscy")
				else
					command("najemnicy wezwij " .. slot)
				end
				say_title("Wezwij")
				say("Najemnicy przychodz¹ do ciebie i do³¹czaj¹ do")
				say("twojej grupy. Op³ata liczy siê co minutê ze")
				say("skarbca. Szczegó³y s¹ na czacie.")

			elseif m == 4 then
				local slot = nj_pick("Odwo³aj", true)
				if slot == 0 then
					return
				end
				if slot == -1 then
					command("najemnicy odwolaj wszyscy")
				else
					command("najemnicy odwolaj " .. slot)
				end

			elseif m == 5 then
				local balance = nj_balance()
				local summoned = 0
				for i = 1, 7 do
					if nj_summoned(i) then
						summoned = summoned + 1
					end
				end
				local per = summoned
				if per < 1 then
					per = 1
				end
				local minutes = 0
				if price > 0 then
					minutes = math.floor(balance * 60 / (price * per))
				end
				say_title("Skarbiec najemników")
				say("Stan: " .. nj_yang(balance) .. " yang.")
				say("Wezwanych teraz: " .. summoned .. ".")
				say("Wystarczy na: " .. math.floor(minutes / 60) .. " h " .. math.mod(minutes, 60) .. " min")
				say("(przy " .. per .. " najemnikach).")
				say("Ostrze¿enie przychodzi 10 minut przed koñcem,")
				say("a przy pustym skarbcu najemnicy odchodz¹.")
				if select("Wp³aæ yang", "Zamknij") == 1 then
					say_title("Wp³aæ yang")
					say("Ile yang wp³aciæ? Masz " .. nj_yang(pc.get_gold()) .. " yang.")
					say("Wpisz cyframi, np. 50000000 albo 50kk.")
					local amount = input()
					if amount == nil or amount == "" then
						return
					end
					command("najemnicy wplac " .. amount)
				end

			elseif m == 6 then
				local slot = nj_pick("Ekwipunek", false)
				if slot == 0 then
					return
				end
				-- MT2009_PLUS_NAJEMNICY_V2: okno ekwipunku najemnika (to samo okno, co u dawnego Towarzysza): komenda
				-- "najemnicy okno <nr>" otwiera je w kliencie; to samo daje klik na najemnika (przycisk "Ekwipunek").
				say_title("Ekwipunek najemnika")
				say("Najemnik musi byæ wezwany i staæ obok ciebie.")
				say("W oknie przeci¹gasz swoje rzeczy na jego sloty")
				say("i do jego plecaka (mikstury, rosy, kryszta³y")
				say("energii, rybki - u¿ywa ich sam). Jego drop")
				say("i nagrody lochów trafiaj¹ do jego plecaka.")
				say("Okno otworzysz te¿, klikaj¹c najemnika.")
				local e = select("Otwórz okno ekwipunku", "Zabierz wszystko", "Daj rzecz (numer pola)", "Wstecz")
				if e == 1 then
					command("najemnicy okno " .. slot)
				elseif e == 3 then
					say_title("Daj rzecz")
					say("Podaj numer pola w swoim ekwipunku:")
					say("1 to lewy górny róg pierwszej strony, dalej")
					say("rzêdami po 5 (pole 6 = drugi rz¹d), druga")
					say("strona zaczyna siê od 46.")
					local cell = input()
					if cell == nil or cell == "" then
						return
					end
					command("najemnicy daj " .. slot .. " " .. cell)
				elseif e == 2 then
					command("najemnicy zabierz " .. slot)
				end

			elseif m == 7 then
				local slot = nj_pick("Gildia", false)
				if slot == 0 then
					return
				end
				say_title("Gildia")
				say("Najemnik mo¿e byæ w twojej gildii (Balathor")
				say("wymaga, by dru¿yna by³a w gildii lidera). Tylko")
				say("w gildii idzie z tob¹ na wojnê gildii. Mo¿esz")
				say("go te¿ zaprosiæ zwyk³ym zaproszeniem do gildii.")
				local e = select("Do³¹cz do mojej gildii", "WyjdŸ z gildii", "Wstecz")
				if e == 1 then
					command("najemnicy gildia " .. slot)
				elseif e == 2 then
					command("najemnicy gildia_wyjdz " .. slot)
				end

			elseif m == 8 then
				local slot, row = nj_pick("Zwolnij najemnika", false)
				if slot == 0 or row == nil then
					return
				end
				say_title("Zwolnij najemnika")
				say("Na pewno zwolniæ " .. row.name .. "?")
				say("Odejdzie na dobre, a miejsce siê zwolni.")
				say("Jeœli jest wezwany, najpierw oddaje ci wszystkie")
				say("rzeczy (potrzebujesz miejsca w ekwipunku).")
				if select("Tak, zwolnij", "Nie") == 1 then
					command("najemnicy zwolnij " .. slot .. " tak")
				end
			end
		end
	end
end
