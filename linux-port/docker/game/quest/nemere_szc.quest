		end

		-- a random order of n spots: d flag <key>k = the spot of the k-th one
		function shuffle(n)
			local s = {}
			for i = 1, n do
				s[i] = i
			end
			for i = n, 2, -1 do
				local j = number(1, i)
				s[i], s[j] = s[j], s[i]
			end
			return s
		end

