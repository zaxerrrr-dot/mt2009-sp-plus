				{"Œroda (Chen-Si)", "data/dungeon/zodiac/days/3-wednesday.txt"},
				{"Czwartek (Wu-Wei)", "data/dungeon/zodiac/days/4-thursday.txt"},
				{"Pi¹tek (Shen-Yu)", "data/dungeon/zodiac/days/5-friday.txt"},
				{"Sobota (Xu-Hai)", "data/dungeon/zodiac/days/6-saturday.txt"},
			}
			say("Czy na pewno chcesz zregenerowaæ?")
			local option = select("Tak", "Nie")
			if option == 2 then return end
			if pc.get_map_index() == map_index then
