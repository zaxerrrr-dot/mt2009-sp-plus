		end

		when 20438.take begin
			local vnum = item.get_vnum()
			if pc.count_item(vnum) < 10 then
				say("Masz za ma³o insygniów.") --773
				return
			end
			local total = math.floor(pc.count_item(vnum)/10)
			local ITEM_COUNT_LIMIT = 200 --Change 200 by the ITEM_COUNT_LIMIT number your server uses
			if total > ITEM_COUNT_LIMIT then --Fix
				total = ITEM_COUNT_LIMIT
			end
			if vnum >= 33001 and vnum <= 33012 then
				local menu_red = select("Czerwone Pud³o Zodiaku", "Kwiat ¯ywio³u", "Close") --774, 775, 789
				if menu_red == 3 then return end
				if menu_red == 1 then
					if pc.count_item(vnum) < total*10 then
						say("Masz za ma³o insygniów.") --773
						return
					end
					pc.remove_item(vnum, total*10)
					pc.give_item2(33029, total)
					syschat(string.format("Otrzymujesz czerwone pud³a Zodiaku: %d", total)) --777
				elseif menu_red == 2 then
					if pc.count_item(vnum) < total*10 then
						say("Masz za ma³o insygniów.") --773
						return
					end
					syschat(string.format("Otrzymujesz kwiaty ¿ywio³u: %d", total)) --778
					pc.remove_item(vnum, total*10)
					pc.give_item2(95500, total)
				end
			elseif vnum >= 33013 and vnum <= 33022 then
				local menu_blue = select("Niebieskie Pud³o Zodiaku", "Kwiat ¯ywio³u", "Close") --779, 775, 789
				if menu_blue == 3 then return end
				if menu_blue == 1 then
					if pc.count_item(vnum) < total*10 then
						say("Masz za ma³o insygniów.") --773
						return
					end
					pc.remove_item(vnum, total*10)
					pc.give_item2(33030, total)
					syschat(string.format("Otrzymujesz niebieskie pud³a Zodiaku: %d", total)) --780
				elseif menu_blue == 2 then
					if pc.count_item(vnum) < total*10 then
						say("Masz za ma³o insygniów.") --773
						return
					end
					syschat(string.format("Otrzymujesz kwiaty ¿ywio³u: %d", total)) --778
					pc.remove_item(vnum, total*10)
					pc.give_item2(95500, total)
				end
			end
		end

		when 20438.chat."Zregeneruj portale" with pc.get_gm_level()== 5 begin
