			local days = select("Poniedzia³ek (Zi-Chou)", "Wtorek (Yin-Mao)", "Œroda (Chen-Si)", "Czwartek (Wu-Wei)", "Pi¹tek (Shen-Yu)", "Sobota (Xu-Hai)", "Niedziela (WSZYSTKIE)", "WyjdŸ ")
			if days == 8 then return end
			if days == 7 then
