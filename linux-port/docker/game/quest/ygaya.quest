-- MT2009_PLUS_GAYA_V1: Kamienie Gaya i pozosta³e funkcje Statuy Wojownika (decyzja w³aœciciela 14.10.2026,
-- cache/yohara/decyzje.md "14.10 ok. 8:10": Kamienie Gaya - dodaæ; Statua Wojownika - pozosta³e funkcje BEZ Tarczy
-- Potêpienia i BEZ peta Feniks Ocalenia). Wiki: "Gaya", "System Gaya", "Kamyki", "Statua Wojownika", "Portowy Sklep
-- Gaya", "Wytwarzanie Skrzyñ Zwierzaków"; liczby: Owsap gem_system.quest / gem_shop_table.txt / cube.txt.
--   * Gaya to przedmiot 95927 (nie do wymiany - wiki), tools/ygaya/gen_ygaya.py;
--   * szlifowanie Kamyków (95926) u Statuy Wojownika (20433) w Porcie Nowego Kontynentu (368): przeci¹gnij Kamyki
--     na statuê (albo rozmowa "Szlifowanie Kamyków") - 30 Kamyków, wybrany Kamieñ Duszy +0..+3 (okno wyboru
--     przedmiotu), 15 000 Yang; szansa 70%, sukces = 3 Gaya; gracz ma najwy¿ej 999 999 Gaya;
--   * Portowy Sklep Gaya: 3 rzêdy po 3 sloty, oferta ka¿dego gracza losowana z puli rzêdu (wiki "Asortyment
--     Sklepu", nasze przedmioty) co 5 godzin od pierwszego otwarcia; z ka¿dego slotu jeden zakup na ofertê;
--     rz¹d I i - w porcie - rz¹d III odblokowane, sloty 4/5/6 odblokowuje na sta³e 1/2/4 Rozszerzenia Sklepu Gaya
--     (39064); Reset Sklepu Gaya (39063) - nowa oferta od razu; sklep to okno klienta (root/uiygaya.py, uk³ad GF
--     gemshopwindow: 3x3 sloty z ikonami, ceny w Gaya, licznik, saldo, Rozszerzenie/Reset) -
--     MT2009_PLUS_GAYA_SHOP_WINDOW_V1;
--   * bez Skrzyñ ¯ywio³aków i Kuponów Zwierzaka ¯ywio³u (decyzja w³aœciciela 14.10.2026: pet tylko w ItemShopie);
--     uszlachetnianie od³amków zestawu przy statui to quest ysets (okno wytwarzania).
-- Bez Handlarza Gaya i Sklepu Gaya w wioskach (nie ma ich modeli w naszym kliencie) - tylko port.
-- cp1250; ¿aden napis nie koñczy siê polsk¹ liter¹ (qc).
quest ygaya begin
	state start begin
		function cfg()
			return {
				port = 368, gaya = 95927, kamyki = 95926, kamyki_n = 30, fee = 15000, fee_text = "15 000",
				pct = 70, give = 3, max = 999999,
				reset = 39063, ext = 39064, ext_need = {1, 2, 4},   -- sloty 4, 5, 6 (wiki "System Gaya")
				rotate = 18000,                                     -- 5 godzin
			}
		end

		-- the wiki's three columns ("Sloty 1-3", "4-6", "7-9") as {vnum, count, price}: Owsap's official vnums where
		-- we have the same item, else ours of the wiki's name; left out (not in our world): B³êkitna Mikstura,
		-- Rozszerzenie Ekwipunku, Karta Resetu, Szpula Kaszmiru, Œwiadectwo Zmiany, Torba Emocji,
		-- Zroszony M³ot, Modlitwa Egzorcyzmu, Skrzyneczki Losu, Szk³o Handlu, Buty Wiatru (1d), Lizak Potêgi,
		-- Karta Przetasowania, Anulacja Transmutacji, Zaczarowanie Przedmiotu+, Smoczy P³omieñ, Runy Wykuwania,
		-- Zaczaruj zwierzaka, Zielona Smocza Fasola
		-- Skrzyd³a Smoka (30630, 26 Gaya in rows I and II as the wiki) came with the level-100 helmets
		-- (MT2009_PLUS_HELM100_V1), appended at each pool's end so a stored offer index keeps its item
		function pool(row)
			if row == 1 then
				return {
					{76012, 3, 183}, {76012, 5, 305}, {71014, 3, 234}, {76018, 5, 390}, {71005, 1, 236},
					{76019, 1, 137}, {55001, 1, 229}, {71113, 1, 16}, {85001, 1, 1097}, {76007, 20, 284},
					{22010, 1, 34}, {71108, 3, 267}, {71001, 1, 392}, {71110, 1, 270}, {38100, 1, 519},
					{71151, 1, 644}, {76024, 1, 1067}, {76005, 1, 167}, {39038, 1, 237}, {76011, 1, 464},
					{30630, 1, 26},     -- Skrzyd³a Smoka (MT2009_PLUS_HELM100_V1)
				}
			elseif row == 2 then
				return {
					{76012, 5, 305}, {76018, 5, 390}, {76019, 1, 137}, {71113, 1, 16}, {76005, 1, 167},
					{39038, 1, 237}, {76011, 1, 464}, {55008, 1, 749}, {70058, 1, 817}, {70056, 3, 445},
					{71094, 1, 346}, {71001, 1, 392}, {71083, 1, 475}, {71103, 1, 539}, {71104, 1, 539},
					{71105, 1, 574}, {71106, 1, 604}, {71003, 1, 806}, {71033, 1, 410}, {85001, 1, 1097},
					{38101, 1, 1050}, {76010, 1, 171}, {76014, 1, 1263}, {76013, 1, 1963}, {72064, 1, 34},
					{22010, 1, 34}, {30630, 1, 26},     -- Skrzyd³a Smoka (MT2009_PLUS_HELM100_V1)
				}
			end
			return {
				{76005, 1, 167}, {39038, 1, 237}, {76018, 5, 390}, {71001, 1, 329}, {71113, 1, 16},
				{71107, 1, 520}, {55009, 1, 2167}, {55002, 1, 1297}, {76001, 1, 1154}, {71048, 1, 715},
				{71011, 1, 787}, {38102, 1, 1893}, {76006, 1, 347}, {76015, 1, 996}, {71151, 1, 644},
				{76024, 1, 1067}, {71108, 10, 890}, {76019, 1, 137}, {39015, 1, 1721}, {85001, 1, 1097},
				{76013, 1, 1963}, {76014, 1, 1263}, {76010, 1, 171}, {39068, 1, 172},
			}
		end

		function row_of(slot)
			return math.floor((slot - 1) / 3) + 1
		end

		function offer(slot)
			local p = ygaya.pool(ygaya.row_of(slot))
			local i = pc.getqf("s"..slot)
			if i < 1 or i > table.getn(p) then
				i = 1
			end
			return p[i]
		end

		function open_slot(slot)
			local row = ygaya.row_of(slot)
			if row ~= 2 then
				return true
			end
			return pc.getqf("u") >= slot - 3
		end

		-- a new offer when the 5 hours are over (the first opening starts the timer); three different things a row
		function refresh(force)
			local c = ygaya.cfg()
			local now = get_time()
			if not force and pc.getqf("t") > now then
				return
			end
			for row = 1, 3 do
				local n = table.getn(ygaya.pool(row))
				local taken = {}
				for k = 1, 3 do
					local i = number(1, n)
					while taken[i] do
						i = number(1, n)
					end
					taken[i] = true
					local slot = (row - 1) * 3 + k
					pc.setqf("s"..slot, i)
					pc.setqf("b"..slot, 0)
				end
			end
			pc.setqf("t", now + c.rotate)
		end

		-- MT2009_PLUS_GAYA_SHOP_WINDOW_V1: the shop is a window of the client (root/uiygaya.py, GF's gemshopwindow
		-- layout): the quest sends its state as "YGAYA" lines and gets the clicks through its "button" event and
		-- input() - a number: 1-9 buy, 11-19 unlock the slot, 20 reset the offer, 21 the state again
		function label(slot)
			local o = ygaya.offer(slot)
			local s = item_name(o[1])
			if o[2] > 1 then
				s = s.." x"..o[2]
			end
			return s.." ("..o[3].." Gaya)"
		end

		function send_state()
			local c = ygaya.cfg()
			ygaya.refresh(false)
			local left = pc.getqf("t") - get_time()
			if left < 0 then
				left = 0
			end
			cmdchat("YGAYA open "..q.getcurrentquestindex().." "..pc.count_item(c.gaya).." "..left.." "..pc.getqf("u").." "..pc.count_item(c.ext).." "..pc.count_item(c.reset))
			for slot = 1, 9 do
				local o = ygaya.offer(slot)
				local st = 0
				local need = 0
				if not ygaya.open_slot(slot) then
					st = 2
					need = c.ext_need[slot - 3]
				elseif pc.getqf("b"..slot) == 1 then
					st = 1
				end
				cmdchat("YGAYA slot "..slot.." "..st.." "..o[1].." "..o[2].." "..o[3].." "..need)
			end
			cmdchat("YGAYA show")
		end

		function buy(slot)
			local c = ygaya.cfg()
			local o = ygaya.offer(slot)
			if not ygaya.open_slot(slot) then
				return
			end
			if pc.getqf("b"..slot) == 1 then
				syschat("Ten slot ju¿ kupiono - poczekaj na now¹ ofertê.")
				return
			end
			if pc.count_item(c.gaya) < o[3] then
				syschat("Masz za ma³o Gaya (potrzeba "..o[3]..").")
				return
			end
			if not pc.enough_inventory(o[1]) then
				syschat("Zrób miejsce w ekwipunku.")
				return
			end
			pc.remove_item(c.gaya, o[3])
			pc.setqf("b"..slot, 1)
			pc.give_item2(o[1], o[2])
			syschat("Portowy Sklep Gaya - kupiono: "..ygaya.label(slot)..".")
		end

		function unlock(slot)
			local c = ygaya.cfg()
			if slot < 4 or slot > 6 or ygaya.open_slot(slot) then
				return
			end
			local need = c.ext_need[slot - 3]
			if pc.getqf("u") ~= slot - 4 then
				syschat("Sloty odblokowuje siê po kolei: najpierw slot "..(pc.getqf("u") + 4)..".")
				return
			end
			if pc.count_item(c.ext) < need then
				syschat("Masz za ma³o Rozszerzeñ Sklepu Gaya (potrzeba "..need..").")
				return
			end
			pc.remove_item(c.ext, need)
			pc.setqf("u", slot - 3)
			syschat("Portowy Sklep Gaya: slot "..slot.." jest odblokowany na sta³e.")
		end

		function reset_offer()
			local c = ygaya.cfg()
			if pc.count_item(c.reset) < 1 then
				syschat("Potrzebujesz przedmiotu: "..item_name(c.reset)..".")
				return
			end
			pc.remove_item(c.reset, 1)
			ygaya.refresh(true)
			syschat("Portowy Sklep Gaya: nowa oferta jest gotowa.")
		end

		function shop()
			pc.setqf("w", get_time())
			ygaya.send_state()
		end

		-- a click of the window: only in the port, within an hour of opening the shop at the statue
		function act(a)
			if pc.get_map_index() ~= 368 or get_time() - pc.getqf("w") > 3600 then
				cmdchat("YGAYA close")
				syschat("Sklep Gaya otworzysz przy Statui Wojownika w Porcie Nowego Kontynentu.")
				return
			end
			if a >= 1 and a <= 9 then
				ygaya.buy(a)
			elseif a >= 11 and a <= 19 then
				ygaya.unlock(a - 10)
			elseif a == 20 then
				ygaya.reset_offer()
			end
			ygaya.send_state()
		end

		function is_spirit_stone(v)
			if v < 28000 or v > 28343 then
				return false
			end
			return v - math.floor(v / 100) * 100 <= 43
		end

		function grind()
			local c = ygaya.cfg()
			say_title(mob_name(20433)..":")
			say("Potrzebujê "..c.kamyki_n.." Kamyków, "..c.fee_text.." Yang oraz")
			say("Kamienia Duszy +0, +1, +2 albo +3. Oszlifujê z nich")
			say(c.give.." drogocenne Gaya.")
			say("Szansa powodzenia: "..c.pct.."%. Kontynuowaæ?")
			if select("Tak", "Nie") ~= 1 then
				return
			end
			say_title(mob_name(20433)..":")
			if pc.count_item(c.kamyki) < c.kamyki_n then
				say("Zbierz wiêcej Kamyków - potrzebujê "..c.kamyki_n..".")
				return
			end
			if pc.get_money() < c.fee then
				say("Masz za ma³o Yang.")
				return
			end
			if pc.count_item(c.gaya) + c.give > c.max then
				say("Masz ju¿ najwiêcej Gaya, ile mo¿na mieæ (999 999).")
				return
			end
			-- MT2009_PLUS_GAYA_GRIND_V2 (w³aœciciel 14.10): lista Kamieni Duszy z ekwipunku zamiast select_item() -
			-- okno "Wska¿ przedmiot" zostawia³o w rogu ekranu napis "Wska¿ Kamieñ Duszy" na sta³e.
			local stones = {}
			local names = {}
			for v = 28000, 28343 do
				if table.getn(stones) < 8 and ygaya.is_spirit_stone(v) and pc.count_item(v) > 0 then
					table.insert(stones, v)
					-- MT2009_PLUS_GAYA_GRIND_V3 (bug list 15.10 #12): item_name() is the client tag "[ITEM value;N]" - its
				-- "]" closed the select's "[QUESTION ...]" early and the window showed the raw list; a choice
				-- takes plain text, so the name comes from item_proto (get_item_name, like minigame_rumi)
				local nm = get_item_name(v)
				if nm == nil or nm == "" then
					nm = "Kamieñ Duszy "..v
				end
				table.insert(names, nm.." ("..pc.count_item(v)..")")
				end
			end
			if table.getn(stones) == 0 then
				say("Nie masz Kamienia Duszy +0, +1, +2 ani +3.")
				return
			end
			say("Który Kamieñ Duszy oddajesz?")
			table.insert(names, "Nie teraz")
			local s = select_table(names)
			if s < 1 or s > table.getn(stones) then
				return
			end
			local stone = stones[s]
			-- checked again: the choice gave the player time
			if pc.count_item(stone) < 1 or pc.count_item(c.kamyki) < c.kamyki_n or pc.get_money() < c.fee then
				return
			end
			pc.remove_item(stone, 1)
			pc.remove_item(c.kamyki, c.kamyki_n)
			pc.change_money(-c.fee)
			say_title(mob_name(20433)..":")
			if number(1, 100) <= c.pct then
				pc.give_item2(c.gaya, c.give)
				say("Uda³o siê! Otrzymujesz "..c.give.." Gaya.")
			else
				say("Szlifowanie siê nie uda³o. Kamyki i Kamieñ Duszy")
				say("przepad³y.")
			end
		end

		when 20433.take with pc.get_map_index() == 368 and item.get_vnum() == 95926 begin
			ygaya.grind()
		end

		when 20433.chat."Szlifowanie Kamyków" with pc.get_map_index() == 368 begin
			local c = ygaya.cfg()
			say_title(mob_name(20433)..":")
			say("Z "..c.kamyki_n.." Kamyków, Kamienia Duszy (+0 do +3)")
			say("i "..c.fee_text.." Yang oszlifujê "..c.give.." drogocenne Gaya.")
			say("Szansa: "..c.pct.."%. Mo¿esz te¿ przeci¹gn¹æ Kamyki na mnie.")
			say("Masz "..pc.count_item(c.kamyki).." Kamyków i "..pc.count_item(c.gaya).." Gaya.")
			if select("Szlifuj", "Nie teraz") ~= 1 then
				return
			end
			ygaya.grind()
		end

		when 20433.chat."Portowy Sklep Gaya" with pc.get_map_index() == 368 begin
			-- MT2009_PLUS_GAYA_SHOP_V2 (w³aœciciel 14.10): bez okna rozmowy - inaczej klient zostawa³ w trybie
			-- rozmowy z NPC i chowa³ ca³e GUI (mapa, czat, pasek, EQ) a¿ do pierwszego zakupu.
			setskin(NOWINDOW)
			ygaya.shop()
		end

		when button begin
			local a = tonumber(input())
			if a ~= nil then
				ygaya.act(a)
			end
		end

		when 39063.use or 39064.use begin
			syschat("U¿yj go w Portowym Sklepie Gaya - Statua Wojownika w Porcie Nowego Kontynentu.")
		end
	end
end
