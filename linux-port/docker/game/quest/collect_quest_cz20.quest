-- MT2009_PLUS_BIOLOGIST_YOHARA_V1: Mroczne Paprocie (poz. 120, Poziom Czempiona 20) - pl-wiki "Misje Biologa" /
-- "Mroczne Paprocie" (the owner, 29 October 2026: "dodaj kolejne misje Biologa wed³ug wiki"). Opened by the end of
-- collect_quest_cz10 (Krysztaly Metin) (set_quest_state "run"), from level 120 and Poziom Czempiona 20.
--   Chaegirab (Dongan, 20810) wants 10 x Mroczna Paproc (31232), one a hand-in, 60% accepted (the wiki), the wait
--   between hand-ins the Biologist's own (collect_data: the world's M2_BIOLOGIST_WAIT_HOURS; Spirala Czasu / Eliksir
--   Poszukiwacza as on every row). The specimen (tools/ybiolog, yohara_biolog.sql):
--   every monster of Jaskinie Gnolli (the pl-wiki item page: "Wszystkie potwory w Jaskinia Gnolli": 6800-6820,
--   tools/yohara_dung4/ydung4_data.py), 1 in 100 while the mission waits; Plat. Skrzynia Skarbow (83055) has it too.
--   Reward: a random Wola SungMa +5 for good (the wiki: "Losowa Wola SungMa +5 na stale") - AFFECT_COLLECT on
--   POINT_SUNGMA_STR / HP / MOVE / IMMUNE = 184 / 185 / 186 / 187 (common/length.h, MT2009_PLUS_SUNGMA_V1: SILA, WIT,
--   ODP, INT; the engine counts an affect's Sung Ma in GetPoint, champion::MapRequirement).
-- The last Biologist mission of the wiki.
-- Texts: the official Polish ones (Owsap v6.2.6 client locale_quest 12527-12588). The state names are the package
-- Biologist's (__complete: /usunmisje, the panel's Biologist page).
-- cp1250; no string ends with a Polish letter (qc).
quest collect_quest_cz20 begin
	state start begin
		function intro()
			say_title(mob_name(20810)..":")
			say("Czy przypominasz sobie jeszcze Jaskinie Gnolli")
			say("znajduj¹ce siê w pobli¿u? Ostatnio potwory")
			say("staj¹ siê tam agresywniejsze. A to jest")
			say("niebezpieczne dla mieszkañców wioski.")
			say("")
			say("Wydaje mi siê, ¿e to zarodniki mrocznej paproci.")
			say("Nie wszystkie potwory toleruj¹ zarodniki tej")
			say("roœliny. Przynieœ mi nieuszkodzone sadzonki")
			say("mrocznej paproci.")
			say_item_vnum(31232)
			say_reward("Mroczn¹ Paproæ znajdziesz u potworów")
			say_reward("w Jaskiniach Gnolli.")
		end

		-- Wola SungMa: the point, its name
		function stats()
			return { { 184, "Wola SungMa (SI£A)" }, { 185, "Wola SungMa (WIT)" },
				 { 186, "Wola SungMa (ODP)" }, { 187, "Wola SungMa (INT)" } }
		end
	end

	state run begin
		when login or levelup with pc.get_level() >= 120 and pc.get_conqueror_level() >= 20 begin
			set_state(information)
		end

		when 20810.chat."Mroczne Paprocie" with pc.get_level() >= 120 and pc.get_conqueror_level() >= 20 begin
			collect_quest_cz20.intro()
			pc.setqf("collect_count", 0)
			set_state(go_to_disciple)
		end
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20810)
			if v ~= 0 then
				target.vid("__TARGET__", v, mob_name(20810))
			end
			send_letter("Mroczne Paprocie")
		end

		when button or info begin
			say_title("Mroczne Paprocie")
			say("Chaegirab ci¹gle jeszcze zajêty jest swoimi")
			say("badaniami. SprawdŸ w Dongan, czy potrzebuje")
			say("pomocy.")
		end

		when __TARGET__.target.click or 20810.chat."Mroczne Paprocie" begin
			target.delete("__TARGET__")
			collect_quest_cz20.intro()
			pc.setqf("collect_count", 0)
			set_state(go_to_disciple)
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter("Mroczne Paprocie")
		end

		when button or info begin
			say_title("Mroczne Paprocie")
			say("Zbierz dla Chaegiraba 10 sztuk:")
			say_item_vnum(31232)
			say("Mroczn¹ Paproæ znajdziesz u potworów")
			say("w Jaskiniach Gnolli.")
			say_reward(string.format("Przyjête: %d / 10", pc.getqf("collect_count")))
			collect_data.say_delay()
		end

		when kill with not npc.is_pc() begin
			local r = npc.get_race()
			if r >= 6800 and r <= 6820 and number(1, 100) == 1 then
				pc.give_item2(31232, 1)
			end
		end

		when 20810.chat."Oddaj paproæ do zbadania" with pc.count_item(31232) > 0 begin
			say_title(mob_name(20810)..":")
			if collect_data.is_wait() then
				say("Jestem w trakcie dok³adniejszej analizy")
				say("poprzedniej próbki. Wróæ do mnie trochê póŸniej!")
				say("Spirala Czasu mo¿e skróciæ czas oczekiwania.")
				collect_data.say_delay()
				return
			end
			if pc.count_item(31232) < 1 then
				say("Nie masz przy sobie Mrocznej Paproci.")
				return
			end
			pc.remove_item(31232, 1)
			local show_wait = not collect_data.is_no_time_on_fail()
			local ok = collect_data.take_chance(60)
			local n = pc.getqf("collect_count")
			if ok then
				n = n + 1
				pc.setqf("collect_count", n)
				if n >= 10 then
					pc.setqf("collect_count", 0)
					collect_data.reset_time()
					set_state(__reward)
				end
			end
			say("Uda³o ci siê znaleŸæ paproæ? Daj, sprawdzê szybko...")
			wait()
			say_title(mob_name(20810)..":")
			if not ok then
				say("Hmmm, ta paproæ jest niestety uszkodzona. Nie ma")
				say("na niej ju¿ ¿adnych zarodników. Przynieœ mi inn¹.")
				if show_wait then
					collect_data.say_delay()
				end
				return
			end
			if n >= 10 then
				say("Uda³o ci siê zebraæ dla mnie wszystkie")
				say("roœliny mrocznej paproci! Zas³u¿y³eœ na nagrodê!")
				say("")
				say_reward("Porozmawiaj ze mn¹: Nagroda za badania")
				return
			end
			say("Ta mroczna paproæ idealnie nadaje siê do moich badañ.")
			say_reward(string.format("Przynieœ mi jeszcze %d szt.", 10 - n))
			collect_data.say_delay()
		end
	end

	state __reward begin
		when letter begin
			local v = find_npc_by_vnum(20810)
			if v ~= 0 then
				target.vid("__TARGET__", v, mob_name(20810))
			end
			send_letter("Mroczne Paprocie: nagroda")
		end

		when button or info begin
			say_title("Mroczne Paprocie")
			say("Uda³o ci siê zebraæ wszystko. Wróæ szybko")
			say("do Chaegiraba w Dongan po nagrodê.")
		end

		when __TARGET__.target.click or 20810.chat."Nagroda za badania" begin
			target.delete("__TARGET__")
			local st = collect_quest_cz20.stats()
			local s = number(1, 4)
			pc.setqf("reward", s)
			set_state(__complete)
			affect.add_collect(st[s][1], 5)
			say_title(mob_name(20810)..":")
			say("Jedna z twoich mocy woli SungMa zostanie")
			say("ulepszona: SI£A, ODP, WIT lub INT.")
			say("")
			say_reward("Sta³y bonus: "..st[s][2].." +5")
			clear_letter()
		end
	end

	state __complete begin
	end
end
