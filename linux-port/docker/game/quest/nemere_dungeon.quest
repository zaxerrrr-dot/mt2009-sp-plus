-- MT2009_PLUS_DUNGEONS_V1 (nemere): Lodowa Kraina - loch Nemere, od poziomu 100 (MT2009_PLUS_RZNM_GLOBAL_LEVEL_V1, by³o 75),
-- tylko dla graczy. Przebieg jak w archiwum "Flame-and-Nemere-dungeon" (R4kan,
-- Nemere.cpp), napisany na lochach silnika (d.*) zamiast osobnego kodu C++:
-- stra¿nik Lodowej Krainy (20395, Góra Sohan, mapa 61) tworzy instancjê mapy 352
-- (metin2_map_n_snow_dungeon_01, rdzeñ game2, d.new_jump_pids przez P2P) i od razu
-- przenosi do niej gracza albo przywódcê z ludŸmi jego dru¿yny stoj¹cymi obok
-- (jedno ³adowanie, bez poczekalni; boty z dru¿yny wchodz¹ za nim). Kamienny lew (20397)
-- przy wejœciu zaczyna wyprawê:
--   1: zabij wszystkie potwory piêtra (MT2009_PLUS_RZNM_OFFICIAL_V2; by³o: 20),
--   2: potwory upuszczaj¹ Lodowy Klucz (30760, 2%), u¿yj go,
--   3: zabij wszystkie potwory piêtra,
--   4: zabij wszystkie potwory piêtra,
--   5: potwory upuszczaj¹ Kryszta³ Lodu (30761, 4%), oddaj po jednym piêciu pieczêciom (20398),
--   6: zniszcz Metin Mrozu (8058),
--   7: pokonaj czterech Szelów (6151),
--   8: potwory upuszczaj¹ Klucz Mrozu (30762, 2%), u¿yj go,
--   9: zniszcz Lodowy Filar (20399),
--  10: Nemere (6191, sam daje tylko yang); po jego œmierci wokó³ niego na ziemiê wypada 8-10 Skrzyñ Nemere
--      (MT2009_PLUS_RZNM_BOSS_DROP_V1; by³o 2-5, ka¿d¹ otwiera siê 3 razy) i dodatkowy ³up - raz na wyprawê,
--      po kolei na ludzi z dru¿yny w lochu, jak drop bossa w dru¿ynie; boty go nie podnosz¹
--      (MT2009_PLUS_DUNGEON_GROUND_LOOT_V1; wczeœniej trafia³ do toreb), a wszyscy wychodz¹ po 60 sekundach
--      (MT2009_PLUS_DUNGEON_BOSS_EXIT_60S_V1).
-- Ka¿dy etap przenosi dru¿ynê do nastêpnej komnaty (5 s, jak w archiwum).
-- Limit 60 minut (archiwum: 3600 s), ponowne wejœcie po godzinie od wejœcia.
-- MT2009_PLUS_BOT_DUNGEONS_ALL_V1: mapa lochu jest od teraz na rdzeniu game1, razem z botami
-- (m2-render-config) - gdzie ni¿ej mowa o game2, chodzi o rdzeñ, który hostuje mapê:
-- d.new_jump_pids tworzy instancjê na miejscu i przenosi do niej ludzi z dru¿yny, a boty
-- z dru¿yny gracza wchodz¹ za nim do tej samej instancji, walcz¹ przy nim i wychodz¹ z nim
-- (playerbot_party_dungeon.h). Op³ata, limit dzienny, poziom i odpoczynek s¹ tylko dla ludzi.
quest nemere_dungeon begin
	state start begin
		-- MT2009_PLUS_DUNGEON_NO_PLAYER_COOLDOWN_V1: the rest between expeditions is the bots' only (the owner, 5 October: "Usuñ
		-- równie¿ ca³kowicie limit czekania na dungi dla graczy, teraz czekaj¹ tylko boty"). A person
		-- never waits - the fee, the level and the day's count stay; a bot (pc.is_playerbot) still rests
		-- c.cooldown from its entry, so it does other things too. The entry flag itself is still
		-- written: the rejoin ("Wróæ do lochu") and the core's bot runs read it.
		function must_rest(now)
			if not pc.is_playerbot() then
				return false
			end
			return now - pc.getf("nemere_dungeon", "entry") < nemere_dungeon.cfg().cooldown
		end

		function cfg()
			return {
				map = 352,
				base_x = 5120, base_y = 1536, size_x = 1024, size_y = 768,
				entry = {171, 270},
				lion = {172, 261},
				exit_map = 61, exit_x = 3584 + 738, exit_y = 1536 + 119,
				-- MT2009_PLUS_RZNM_GLOBAL_LEVEL_V1 (the owner, 15 October): the official entry level again - pl-wiki
				-- "Wejscie od Lv 100", Owsap's NEED_LEVEL 100; the monsters are the official ones too (apply.sh). Was 75.
				min_level = 100,
				near = 30, -- MT2009_PLUS_DUNGEON_ONE_WARP_V1: party members within 30 cells of the leader go with him
				cooldown = 60 * 60,
				limit_min = 60,
				-- MT2009_PLUS_DUNGEON_FEE_V1: the price of a new expedition (each player, paid on entering it) and
				-- how many new expeditions a player may start a day (Polish midnight).
				fee = 7500000, fee_text = "7 500 000", -- MT2009_PLUS_AREZZO_BALANCE_V1: half of 15 000 000 (the owner, 5 October)
				daily = 5,
				-- [4] i [5]: 3 komorki na polnoc od pozycji z archiwum - tam server_attr z attr.atr klienta GF (2.0.28) ma sciane.
				rooms = {
					[2] = {422, 261}, [3] = {764, 264}, [4] = {175, 532}, [5] = {421, 535},
					[6] = {748, 540}, [7] = {305, 708}, [8] = {571, 701}, [9] = {851, 693},
					[10] = {927, 395},
				},
				seals = {{449,488},{455,445},{419,422},{382,444},{389,488}},
				metin6 = {747, 494},
				szel = {{302,678},{281,657},{303,635},{324,656}},
				pillar = {849, 660},
				boss = {927, 333},
				path = "data/dungeon/nemere_mt/",
				-- MT2009_PLUS_DUNGEON_DROP_V1: the quest items per mille of a kill (the
				-- owner, 29 September: at 49% one group gave ten crystals). A room holds
				-- 50-60 monsters (10-12 groups of 4-5, back after 60 s): a key ~50 kills,
				-- the five crystals ~125 kills, two to three rooms.
				-- MT2009_PLUS_RZNM_OFFICIAL_V2: the floors are the official ones again (zone_2 ~200 monsters,
				-- zone_5 ~270, zone_8 ~210); a kill gives the same as before (the rates were the owner's cut,
				-- not raised for the small rooms): ~4 keys and ~11 crystals a floor (the official: 3% a kill
				-- each, a key fits in 30% - ~2 good keys and ~8 crystals a floor).
				key_permille = 20,
				crystal_permille = 40,
				-- MT2009_PLUS_RZNM_BOSS_DROP_V1 (the owner, 15 October; pl-wiki, 17.3: 8-10 chests, each opened 3 times -
				-- ShipDefense_ChestKeep, ANTI_STACK in apply.sh): 8-10 (was 2-5) - one set a kill on the ground round the boss,
				-- owned in turn by the party's people (MT2009_PLUS_DUNGEON_GROUND_LOOT_V1, give_chests).
				chests_min = 8, chests_max = 10,
				-- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1: the steps that clear a room (spawn_room's count is the kills they
				-- ask; MT2009_PLUS_DUNGEON_TARGET_RESPAWN_V1: the room's regen file, to bring lost monsters back) and how
				-- often the watch looks.
				tw_waves = {[1] = "zone_1.txt", [3] = "zone_3.txt", [4] = "zone_4.txt"},
				target_watch = 15,
			}
		end

		-- MT2009_PLUS_DUNGEON_FEE_V1: the entry fee and the daily limit. Checked for everyone at the guard (with
		-- the level and the rest), paid on the first login into a new instance (every way in:
		-- the guard, the lobby, the lobby's own timer) - no money or no runs left there sends
		-- the player out. "Wróæ do lochu" into the same instance costs nothing. GMs are free.
		function today()
			return math.floor((get_global_time() + 7200) / 86400)
		end

		function runs_today()
			if pc.getf("nemere_dungeon", "day") ~= nemere_dungeon.today() then
				return 0
			end
			return pc.getf("nemere_dungeon", "runs")
		end

		function over_limit()
			local c = nemere_dungeon.cfg()
			return not pc.is_gm() and nemere_dungeon.runs_today() >= c.daily
		end

		function too_poor()
			local c = nemere_dungeon.cfg()
			return not pc.is_gm() and pc.get_money() < c.fee
		end

		-- MT2009_PLUS_DUNGEON_FEE_LEADER_V1: who pays (the owner, 5 October: "Za wejœcie na dungeon z botami
		-- (równie¿ z towarzyszem) p³aci tylko lider grupy. Jak boty id¹ same - p³ac¹ normalnie"). A person
		-- pays for himself alone, once, on his first login into the new instance - after the entry worked,
		-- never at the guard - and the guard checks the fee, the day's runs, the level and the rest of the
		-- people going in only: a bot of the party (the companion, a finder's bot, any bot the person
		-- invited) is never asked for the fee nor charged it, whether the person or the bot leads the
		-- party. A member counts as a person only when the quest's block really switched to him
		-- (pc.get_player_id() == pid, as devilcatacomb_zone asks): a block that stayed on the one talking
		-- would put the member on the list with the talker's own figures. Two people with bots: each person
		-- his own, as before. The bots' own runs (playerbot_dungeon_runs.h) pay in the core, as before.
		function pay_entry()
			local c = nemere_dungeon.cfg()
			if pc.is_gm() or pc.is_playerbot() then
				return true
			end
			if nemere_dungeon.over_limit() then
				syschat("Wykorzysta³eœ ju¿ dzisiejsze wyprawy do tego lochu ("..c.daily.."). Wróæ jutro.")
				return false
			end
			if pc.get_money() < c.fee then
				syschat("Wejœcie kosztuje "..c.fee_text.." Yang - nie masz tyle przy sobie.")
				return false
			end
			pc.change_money(-c.fee)
			local day = nemere_dungeon.today()
			if pc.getf("nemere_dungeon", "day") ~= day then
				pc.setf("nemere_dungeon", "day", day)
				pc.setf("nemere_dungeon", "runs", 0)
			end
			pc.setf("nemere_dungeon", "runs", pc.getf("nemere_dungeon", "runs") + 1)
			syschat("Op³ata za wejœcie: "..c.fee_text.." Yang. Dzisiejsza wyprawa "..pc.getf("nemere_dungeon", "runs").."/"..c.daily..".")
			return true
		end

		-- MT2009_PLUS_BOT_DUNGEONS_ALL_V1: a party a bot leads (a person's companion takes the person
		-- into its own party) is the person's to open - its leader is nobody to ask. The leader is
		-- looked at only among the members on this map (get_member_pids), as everywhere here.
		function bot_leads()
			local lp = party.get_leader_pid()
			if lp == nil or lp == 0 or lp == pc.get_player_id() then
				return false
			end
			local bot = false
			local pids = {party.get_member_pids()}
			for i, pid in next, pids, nil do
				if pid == lp then
					q.begin_other_pc_block(pid)
					bot = pc.get_player_id() == pid and pc.is_playerbot()
					q.end_other_pc_block()
				end
			end
			return bot
		end

		function inside()
			local idx = pc.get_map_index()
			return idx >= 352 * 10000 and idx < 353 * 10000
		end

		-- MT2009_PLUS_DUNGEON_GROUND_LOOT_V1 (the owner, 15 October: the boss's loot falls on the ground round him like
		-- any boss's drop, not into the bags): one set a kill - chests_min..chests_max (8-10) of Skrzynia Nemere (50271,
		-- special_item_group.dungeons.txt, never stacked: ANTI_STACK in apply.sh, each opened 3 times) plus the extra
		-- drop rolled once (boss_drop, up to 13) - on free spots round the boss (loot_spots, game.drop_item_at),
		-- each owned in turn by the people (not bots) of the killer's party inside this instance from a random one
		-- (get_member_pids gives the members on the killer's map index), or by the killer alone: the party share of a
		-- boss's many-item drop, the engine's 30 s ownership, a member may pick the others' share up for them
		-- (CHARACTER::PickupItem). No bot picks any of it up (people 1: char_item.cpp, playerbot_loot.h), so the bots'
		-- own runs (no person inside) drop none, as before. Was: one pool split round-robin into the bags with a chat
		-- line (MT2009_PLUS_DUNGEON_LOOT_POOL_V1), before that every person's own chests (MT2009_PLUS_BOSS_CHESTS_V1).
		-- Nemere himself drops only yang (item_manager.cpp).
		function loot_people()
			local here = pc.get_map_index()
			local pids = {}
			if party.is_party() then
				pids = {party.get_member_pids()}
			end
			if table.getn(pids) == 0 then
				pids = {pc.get_player_id()}
			end
			local people = {}
			for i, pid in next, pids, nil do
				q.begin_other_pc_block(pid)
				if not pc.is_playerbot() and pc.get_map_index() == here then
					table.insert(people, pid)
				end
				q.end_other_pc_block()
			end
			return people
		end

		-- MT2009_PLUS_DROP_EDIT_V1: the boss's own drop the owner added in the drop workbook
		-- (1 October). The boss gives no items (item_manager.cpp), so the quest rolls it once
		-- per kill: {vnum, count, percent}, each line on its own. Only rolled here - give_chests
		-- drops it on the ground with the chests (MT2009_PLUS_DUNGEON_GROUND_LOOT_V1).
		function boss_drop()
			-- MT2009_PLUS_AWAKENING_V1: no Kamien Przebudzenia here (the owner, 3 October).
			-- MT2009_PLUS_BELT_MATS_V1: Kamien Lodowego Plomienia (30525) x2 at 30% (the owner, 7 October: the
			-- flame stone has a drop of its own, beside the chests' belt materials, group 951102).
			local t = { {27987, 5, 10}, {50513, 1, 5}, {50255, 15, 5}, {25040, 3, 10}, {71084, 2, 10}, {71085, 1, 10}, {72067, 1, 70}, {30525, 2, 30} }
			-- MT2009_PLUS_RZNM_BOSS_DROP_V1 (the owner, 15 October, the pl-wiki's Nemere page since 17.3: "do 13
			-- dodatkowych dropow" beside the chests): the wiki's own drop list after the owner's lines - one line
			-- each, a herb one of the eight (rolled), quest items (Kamien Liderow, Notatka Przywodcy) left out.
			-- The wiki gives no chances: ours are 50% for consumables, 20-30% for materials, 10% for the rare.
			-- At most 13 items a kill, the owner's lines first.
			local wiki = { {27003, 30, 40}, {27002, 50, 40}, {27006, 30, 40}, {27005, 50, 40}, {0, 1, 50}, {30610, 1, 30},
				{95926, 200, 30}, {50300, 1, 10}, {70037, 1, 10}, {51001, 50, 50}, {72058, 5, 20}, {70038, 20, 30},
				{70005, 1, 10}, {70043, 1, 10}, {39076, 1, 30}, {39077, 1, 20}, {39080, 1, 20}, {11290, 1, 10},
				{11890, 1, 10} }
			for i, e in next, wiki, nil do
				table.insert(t, e)
			end
			local herbs = {50721, 50722, 50723, 50724, 50725, 50726, 50727, 50728}
			local out = {}
			for i, e in next, t, nil do
				if table.getn(out) < 13 and number(1, 100) <= e[3] then
					local v = e[1]
					if v == 0 then
						v = herbs[number(1, table.getn(herbs))]
					end
					table.insert(out, {v, e[2]})
				end
			end
			return out
		end

		-- MT2009_PLUS_DUNGEON_GROUND_LOOT_V1: the spots round the boss, n of them, in pixels from him - the eight
		-- around him 1.5 m away, then the sixteen of the next ring, each ring in a random order, so nothing
		-- lies on another item (game.drop_item_at moves a blocked spot to the nearest free one).
		function loot_spots(n)
			local out = {}
			local r = 1
			while table.getn(out) < n do
				local ring = {}
				for dx = -r, r do
					for dy = -r, r do
						if math.max(math.abs(dx), math.abs(dy)) == r then
							table.insert(ring, {dx * 150, dy * 150})
						end
					end
				end
				for i = table.getn(ring), 2, -1 do
					local j = number(1, i)
					local e = ring[i]
					ring[i] = ring[j]
					ring[j] = e
				end
				for i = 1, table.getn(ring) do
					table.insert(out, ring[i])
				end
				r = r + 1
			end
			return out
		end

		-- MT2009_PLUS_DUNGEON_GROUND_LOOT_V1: loot = {{vnum, count}, ...} on the ground round the boss (bx, by in
		-- pixels), one item a spot, owned in turn by the people of the run from a random one - the party share of a
		-- boss's many-item drop (char_battle.cpp, GetNextOwnership), bots left out. people 1: no bot picks them up.
		function drop_loot(people, loot, bx, by)
			local n = table.getn(people)
			local m = table.getn(loot)
			if n == 0 or m == 0 then
				return
			end
			local spots = nemere_dungeon.loot_spots(m)
			local first = number(1, n)
			for k = 1, m do
				q.begin_other_pc_block(people[math.mod(first - 1 + k - 1, n) + 1])
				game.drop_item_at(loot[k][1], loot[k][2], bx + spots[k][1], by + spots[k][2], 0, 0) -- the owner, 15 October: bots and the companion pick it up as any party drop
				q.end_other_pc_block()
			end
		end

		-- MT2009_PLUS_DUNGEON_GROUND_LOOT_V1: one set a kill on the ground round the boss (drop_loot) - the chests
		-- and the boss's extra drop (boss_drop); nothing in a bot-only run (no people inside). Returns how many people.
		function give_chests()
			local c = nemere_dungeon.cfg()
			-- The boss's spot, read before another player's block takes the quest's npc away.
			local nx = npc.get_x()
			local ny = npc.get_y()
			if nx < 0 or ny < 0 then
				nx = pc.get_x()
				ny = pc.get_y()
			end
			local people = nemere_dungeon.loot_people()
			if table.getn(people) == 0 then
				return 0
			end
			local loot = {}
			for k = 1, number(c.chests_min, c.chests_max) do
				table.insert(loot, {50271, 1})
			end
			local extra = nemere_dungeon.boss_drop()
			for k = 1, table.getn(extra) do
				table.insert(loot, extra[k])
			end
			nemere_dungeon.drop_loot(people, loot, nx * 100, ny * 100)
			return table.getn(people)
		end

		function purge_mobs()
			local c = nemere_dungeon.cfg()
			d.purge_area(c.base_x * 100, c.base_y * 100, (c.base_x + c.size_x) * 100, (c.base_y + c.size_y) * 100)
		end

		-- MT2009_PLUS_RZNM_OFFICIAL_V2 (the owner, 15 October: the official density): a "clear the room" step
		-- spawns its room once and counts what came - the room's total is the kills it takes (the
		-- official "pokonajcie wszystkich wrogow"), 20 only if the count failed. d.count_monster() counts the
		-- instance's living monsters and stones; what stood before the room (doors, stones) is left out.
		function spawn_room(file)
			local before = d.count_monster()
			d.regen_file(file)
			local n = d.count_monster() - before
			if n <= 0 then
				n = 20
			end
			d.setf("room", n)
			d.setf("room_base", before)
			nemere_dungeon.watch_start(0) -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
		end

		-- MT2009_PLUS_RZNM_OFFICIAL_V2: the minute's check of a "clear the room" step - a monster that died
		-- without a kill counted (no killer) must not hold the room open: none of the room's left alive
		-- (only what stood before it) closes the step as its last kill would.
		function room_check()
			if d.getf("ready") ~= 1 or (d.getf("step") ~= 1 and d.getf("step") ~= 3 and d.getf("step") ~= 4) then
				return
			end
			if d.getf("room") > 0 and d.count_monster() <= d.getf("room_base") then
				d.setf("kills", d.getf("room"))
				nemere_dungeon.go(d.getf("step") + 1)
			end
		end

		function step_text(step)
			if step == 1 or step == 3 or step == 4 then return "Pokonaj wszystkie potwory na tym piêtrze."
			elseif step == 2 then return "Zdob¹dŸ Lodowy Klucz z potworów i u¿yj go."
			elseif step == 5 then return "Zdob¹dŸ Kryszta³y Lodu z potworów i oddaj po jednym ka¿dej z piêciu pieczêci."
			elseif step == 6 then return "Zniszcz Metin Mrozu."
			elseif step == 7 then return "Pokonaj czterech Szelów."
			elseif step == 8 then return "Zdob¹dŸ Klucz Mrozu z potworów i u¿yj go."
			elseif step == 9 then return "Zniszcz Lodowy Filar."
			end
			return "Pokonaj Nemere!"
		end

		-- Next stage: clean the room, then after 5 s the next room (timer).
		function go(step)
			d.clear_regen()
			nemere_dungeon.purge_mobs()
			d.setf("step", step)
			d.setf("kills", 0)
			d.setf("ready", 0)
			d.notice("Nemere: Etap zaliczony. Za 5 sekund przejdziecie dalej.")
			server_timer("nemere_step", 5, d.get_map_index())
		end

		function finish()
			local c = nemere_dungeon.cfg()
			d.setf("closed", 1)
			d.setf("mt2009_keep_until", 0)
			d.set_warp_location(c.exit_map, c.exit_x, c.exit_y)
			d.exit_all()
		end

		-- MT2009_PLUS_DUNGEON_BOSS_EXIT_60S_V1: after the last boss a countdown, a second at a time, then everyone out
		-- (finish) - the owner, 15 October: a minute to pick the loot up off the ground (MT2009_PLUS_DUNGEON_GROUND_LOOT_V1),
		-- told at 60 and 30 seconds and then every second from 10 to 1 (was 10 s: MT2009_PLUS_DUNGEON_BOSS_EXIT_10S_V1,
		-- the owner, 5 October). The boss's dungeon stays ended (closed at the end, the boss flag at the kill).
		function end_text(n)
			if n == 1 then
				return "Za 1 sekundê zostaniesz teleportowany na Górê Sohan."
			elseif n >= 2 and n <= 4 then
				return "Za "..n.." sekundy zostaniesz teleportowany na Górê Sohan."
			end
			return "Za "..n.." sekund zostaniesz teleportowany na Górê Sohan."
		end

		function end_count(n)
			if n <= 0 then
				nemere_dungeon.finish()
				return
			end
			if n <= 10 or n == 30 or n == 60 then
				d.notice("Nemere: "..nemere_dungeon.end_text(n))
			end
			d.setf("end_in", n - 1)
			server_timer("nemere_end", 1, d.get_map_index())
		end

		-- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1 (the owner, 20 October: "popraw wszystkie dungi"; the pattern of
		-- MT2009_PLUS_WUKONG_TARGETS_V1): a step that counts kills is looked at every target_watch seconds while
		-- it runs.
		-- MT2009_PLUS_DUNGEON_TARGET_RESPAWN_V1 (the owner, 20 October: "jak nie jest dotkniêty, to respi siê nowy
		-- czy coœ, bo to za du¿e u³atwienie, jak same siê bêd¹ zbija³y"): a step ends only by its kills - the watch
		-- never lowers a count and never closes a step for want of hits:
		-- - a wave of a regen file (groups - too many to name; cfg().tw_waves): fewer of its monsters standing
		--   (above room_base) than the kills still wanted - the wave's regen file comes again;
		-- - a named target (an instance unique, target<i>: its VID while it stands, 0 once its kill counted,
		--   -1 after a failed spawn) not alive whose kill never counted comes back at its spot.
		function target_key(step, i)
			return "tw"..step.."_"..i
		end

		-- The watch from now on, for this step: n named targets (0 = a wave, or nothing named).
		function watch_start(n)
			d.setf("tw_step", d.getf("step"))
			d.setf("targets", n)
			clear_server_timer("nemere_watch", d.get_map_index())
			server_timer("nemere_watch", nemere_dungeon.cfg().target_watch, d.get_map_index())
		end

		function spawn_target(i, vnum, x, y)
			local vid = d.spawn_mob(vnum, x, y)
			if vid ~= 0 then
				d.set_unique(nemere_dungeon.target_key(d.getf("step"), i), vid)
			else
				vid = -1
			end
			d.setf("target"..i, vid)
			d.setf("tvnum"..i, vnum)
			d.setf("tx"..i, x)
			d.setf("ty"..i, y)
		end

		-- A kill event of a target: its kill counted, never brought back.
		function target_down(vid)
			for i = 1, d.getf("targets") do
				if d.getf("target"..i) == vid then
					d.setf("target"..i, 0)
				end
			end
		end

		-- true while the watch goes on
		function watch_targets()
			local c = nemere_dungeon.cfg()
			local step = d.getf("step")
			if d.getf("closed") == 1 or d.getf("ready") ~= 1 or d.getf("tw_step") ~= step then
				return false
			end
			local w = c.tw_waves[step]
			if d.getf("targets") > 0 then
				local n = 0
				for i = 1, d.getf("targets") do
					local v = d.getf("target"..i)
					if v ~= 0 and (v < 0 or d.is_unique_dead(nemere_dungeon.target_key(step, i))) then
						nemere_dungeon.spawn_target(i, d.getf("tvnum"..i), d.getf("tx"..i), d.getf("ty"..i))
						n = n + 1
					end
				end
				if n > 0 then
					d.notice("Nemere: Zaginione cele etapu pojawiaj¹ siê ponownie ("..n..").")
				end
			elseif w ~= nil then
				local need = d.getf("room") - d.getf("kills")
				if need > 0 and d.count_monster() - d.getf("room_base") < need then
					d.regen_file(c.path..w)
					d.notice("Nemere: Brakuj¹ce potwory komnaty pojawiaj¹ siê ponownie.")
				end
			else
				return false
			end
			return true
		end

		-- MT2009_PLUS_DUNGEON_ONE_WARP_V1: one loading screen (the owner, 29 September: the guard's
		-- warp to the lobby and then the lobby's warp into the instance were two). The guard
		-- (map 61, game1) asks for a new instance of 352 with d.new_jump_pids: game2, which
		-- hosts 352, makes it and warps the player - or the leader and the people of his party
		-- standing by the guard - straight into it (engine, server-patches/playerqol). The
		-- instance is set up by the first of them to log in (init below), and each player's
		-- cooldown starts when he enters it; the party's bots follow him in (MT2009_PLUS_BOT_DUNGEONS_ALL_V1).
		function init()
			local c = nemere_dungeon.cfg()
			d.setf("init", 1)
			d.setf("entered", 1)
			-- MT2009_PLUS_DUNGEON_RETURN_V1: the instance outlives its players until the time limit
			-- (dungeon.cpp), so "Wróæ do lochu" at the guard finds it after a disconnect.
			d.setf("mt2009_keep_until", get_global_time() + c.limit_min * 60 + 60)
			d.setf("step", 0)
			d.setf("left", c.limit_min)
			d.spawn_mob(20397, c.lion[1], c.lion[2])
			-- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1 (timers): an earlier instance with the same index may have
			-- left its timers behind; they would run this instance's clock and stages, and block its own.
			local idx = d.get_map_index()
			clear_server_timer("nemere_tick", idx)
			clear_server_timer("nemere_step", idx)
			clear_server_timer("nemere_watch", idx)
			clear_server_timer("nemere_end", idx)
			server_timer("nemere_tick", 60, idx)
		end

		function entry_xy()
			local c = nemere_dungeon.cfg()
			return (c.base_x + c.entry[1]) * 100, (c.base_y + c.entry[2]) * 100
		end

		when 20395.chat."Lodowa Kraina (Nemere)" begin
			local c = nemere_dungeon.cfg()
			say_title(mob_name(20395))
			if pc.is_playerbot() then
				return
			end
			say("Za tym przejœciem le¿y Lodowa Kraina, w której")
			say("czeka Nemere, pan mrozu. Nikt stamt¹d nie wróci³,")
			say("by o nim opowiedzieæ.")
			say("")
			say_reward("Wymagany poziom: "..c.min_level..". Bez czekania miêdzy wyprawami.") -- MT2009_PLUS_DUNGEON_NO_PLAYER_COOLDOWN_V1
			say_reward("Boty z Twojej dru¿yny wejd¹ do lochu razem z Tob¹.")
			say_reward("Wejœcie: "..c.fee_text.." Yang. Najwy¿ej "..c.daily.." wypraw dziennie (dziœ: "..nemere_dungeon.runs_today().."/"..c.daily..").") -- MT2009_PLUS_DUNGEON_FEE_V1
			say_reward("P³acisz tylko za siebie - boty z dru¿yny i towarzysz wchodz¹ bez op³aty.") -- MT2009_PLUS_DUNGEON_FEE_LEADER_V1
			if select("PrzejdŸ do Lodowej Krainy", "Nie teraz") ~= 1 then
				return
			end
			-- Open since client 2.0.28 carries the maps; "/eventflag mt2009_dungeons_closed 1"
			-- closes both dungeons to players; a GM may always enter.
			if not pc.is_gm() and game.get_event_flag("mt2009_dungeons_closed") > 0 then
				say_title(mob_name(20395))
				say("Przejœcie jest jeszcze zamkniête. Wróæ póŸniej.")
				return
			end
			local now = get_global_time()
			local x, y = nemere_dungeon.entry_xy()
			-- An expedition still running: back into it. d.find asks game2, which warps the
			-- player if the instance is still there (the cooldown equals the time limit).
			local idx = pc.getf("nemere_dungeon", "idx")
			if idx > 0 and now - pc.getf("nemere_dungeon", "entry") < c.limit_min * 60 then
				say_title(mob_name(20395))
				say("Twoja wyprawa wci¹¿ trwa. Czy chcesz do niej wróciæ?")
				-- MT2009_PLUS_DUNGEON_NO_PLAYER_COOLDOWN_V1: a new expedition for everybody (it was the GM's only), so the last one
				-- finished or left does not hold a player back until its time limit runs out.
				local s = select("Wróæ do lochu", "Nowa wyprawa", "Nie teraz")
				if s == 3 then
					return
				elseif s == 1 then
					if d.find(idx, x, y, pc.get_player_id()) then
						pc.warp(x, y, idx)
					else
						say_title(mob_name(20395))
						say("Jeœli wyprawa wci¹¿ trwa, przejœcie zaraz ciê zabierze.")
					end
					return
				end
			end
			if party.is_party() and not party.is_leader() and not nemere_dungeon.bot_leads() then
				say_title(mob_name(20395))
				say("Tylko przywódca dru¿yny mo¿e otworzyæ przejœcie.")
				say("Stañ przy mnie - przywódca zabierze dru¿ynê stoj¹c¹ obok.")
				return
			end
			if pc.get_level() < c.min_level then
				say_title(mob_name(20395))
				say("Jesteœ za s³aby. Wróæ, gdy osi¹gniesz poziom "..c.min_level..".")
				return
			end
			if not pc.can_warp() or pc.is_busy() then
				say_title(mob_name(20395))
				say("Poczekaj chwilê po handlu lub rozmowie i spróbuj ponownie.")
				return
			end
			if now - pc.getf("nemere_dungeon", "pending") < 10 then
				say_title(mob_name(20395))
				say("Przejœcie ju¿ siê otwiera. Poczekaj chwilê.")
				return
			end
			-- Who goes: the player, or the leader and the people of his party standing by
			-- the guard (c.near cells); the party's bots follow them in afterwards (MT2009_PLUS_BOT_DUNGEONS_ALL_V1,
			-- playerbot_party_dungeon.h) and pay nothing. Anyone too weak or not yet rested stops it.
			local me = pc.get_player_id()
			local humans = {me}
			local low = {}
			local wait = {}
			local full = {} -- MT2009_PLUS_DUNGEON_FEE_V1
			local poor = {}
			if nemere_dungeon.must_rest(now) then
				table.insert(wait, pc.get_name())
			end
			if nemere_dungeon.over_limit() then table.insert(full, pc.get_name()) end
			if nemere_dungeon.too_poor() then table.insert(poor, pc.get_name()) end
			if party.is_party() then
				local lmap, lx, ly = pc.get_map_index(), pc.get_x(), pc.get_y()
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					if pid ~= me then
						q.begin_other_pc_block(pid)
						local dx, dy = pc.get_x() - lx, pc.get_y() - ly
						if pc.get_player_id() == pid and not pc.is_playerbot() and pc.get_map_index() == lmap and dx * dx + dy * dy <= c.near * c.near and pc.can_warp() then
							table.insert(humans, pid)
							if pc.get_level() < c.min_level then
								table.insert(low, pc.get_name())
							end
							if nemere_dungeon.must_rest(now) then
								table.insert(wait, pc.get_name())
							end
							if nemere_dungeon.over_limit() then table.insert(full, pc.get_name()) end
							if nemere_dungeon.too_poor() then table.insert(poor, pc.get_name()) end
						end
						q.end_other_pc_block()
					end
				end
			end
			if table.getn(low) > 0 then
				say_title(mob_name(20395))
				say("Za s³abi, by wejœæ (poziom "..c.min_level.."+):")
				for i, n in next, low, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(full) > 0 then
				say("Dzisiejsze wyprawy do tego lochu ju¿ wykorzystane ("..c.daily.." dziennie):")
				for i, n in next, full, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(poor) > 0 then
				say("Wejœcie kosztuje "..c.fee_text.." Yang - za ma³o przy sobie:")
				for i, n in next, poor, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(wait) > 0 then
				say_title(mob_name(20395))
				say("Jeszcze nie odpoczêli po poprzedniej wyprawie:")
				for i, n in next, wait, nil do say(color(1,1,0).."    "..n) end
				local left = c.cooldown - (now - pc.getf("nemere_dungeon", "entry"))
				if left > 0 then
					say("")
					say("Ty mo¿esz wejœæ za "..math.ceil(left / 60).." min.")
				end
				return
			end
			local r = d.new_jump_pids(c.map, x, y, humans)
			if r < 0 then
				-- The request could not be made: the old way, through the lobby.
				nemere_dungeon.lobby()
				return
			end
			pc.setf("nemere_dungeon", "pending", now)
			if r == 0 then
				-- game2 makes the instance; a warp that has not come in 5 s means the request
				-- got lost (game2 down or restarting) - the lobby instead (fallback timer).
				timer("nemere_fallback", 5)
			end
		end

		-- The fallback (the path before MT2009_PLUS_DUNGEON_ONE_WARP_V1): the guard sends the
		-- player, or the leader with the people of his party standing by, to the public copy
		-- of the map on game2 - the lobby - where the statue/lion (or, for a player alone, the
		-- lobby's login timer) makes the instance with d.new_jump_pids, local there.
		function lobby()
			local c = nemere_dungeon.cfg()
			local x, y = nemere_dungeon.entry_xy()
			if party.is_party() then
				local me = pc.get_player_id()
				local lmap, lx, ly = pc.get_map_index(), pc.get_x(), pc.get_y()
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					if pid ~= me then
						q.begin_other_pc_block(pid)
						local dx, dy = pc.get_x() - lx, pc.get_y() - ly
						if pc.get_player_id() == pid and not pc.is_playerbot() and pc.get_map_index() == lmap and dx * dx + dy * dy <= c.near * c.near and pc.can_warp() then
							pc.warp(x, y)
						end
						q.end_other_pc_block()
					end
				end
			else
				pc.setf("nemere_dungeon", "auto", 1)
			end
			pc.setf("nemere_dungeon", "pending", 0)
			pc.warp(x, y)
		end

		when nemere_fallback.timer begin
			local c = nemere_dungeon.cfg()
			if pc.get_map_index() ~= c.exit_map or pc.getf("nemere_dungeon", "pending") == 0 then
				return
			end
			syschat("Lodowa Kraina: przejœcie prowadzi przez poczekalniê.")
			nemere_dungeon.lobby()
		end


		function lobby_create(humans)
			local c = nemere_dungeon.cfg()
			local x, y = nemere_dungeon.entry_xy()
			-- the leader first: the engine makes pids[1] the dungeon's "leader"
			local list = {pc.get_player_id()}
			for i, pid in next, humans, nil do
				if pid ~= list[1] then
					table.insert(list, pid)
				end
			end
			return d.new_jump_pids(c.map, x, y, list) > 0
		end

		-- The lobby (public map 352 on game2): the leader, or a player alone, opens the instance.
		when 20397.chat."Otwórz przejœcie do Lodowej Krainy" with pc.get_map_index() == 352 begin
			local c = nemere_dungeon.cfg()
			say_title(mob_name(20397))
			local now = get_global_time()
			local idx = pc.getf("nemere_dungeon", "idx")
			if idx > 0 and now - pc.getf("nemere_dungeon", "entry") < c.limit_min * 60 and d.find(idx) then
				say("Twoja wyprawa wci¹¿ trwa. Czy chcesz do niej wróciæ?")
				if select("Wróæ do lochu", "Nie teraz") == 1 then
					pc.warp((c.base_x + c.entry[1]) * 100, (c.base_y + c.entry[2]) * 100, idx)
				end
				return
			end
			if party.is_party() and not party.is_leader() and not nemere_dungeon.bot_leads() then
				say("Tylko przywódca dru¿yny mo¿e otworzyæ przejœcie.")
				say("Poczekaj tu na niego - zabierze ca³¹ dru¿ynê.")
				return
			end
			local humans = {}
			local low = {}
			local wait = {}
			local full = {} -- MT2009_PLUS_DUNGEON_FEE_V1
			local poor = {}
			if party.is_party() then
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					q.begin_other_pc_block(pid)
					if pc.get_player_id() == pid and not pc.is_playerbot() then
						table.insert(humans, pid)
						if pc.get_level() < c.min_level then
							table.insert(low, pc.get_name())
						end
						if nemere_dungeon.must_rest(now) then
							table.insert(wait, pc.get_name())
						end
						if nemere_dungeon.over_limit() then table.insert(full, pc.get_name()) end
						if nemere_dungeon.too_poor() then table.insert(poor, pc.get_name()) end
					end
					q.end_other_pc_block()
				end
			else
				table.insert(humans, pc.get_player_id())
				if pc.get_level() < c.min_level then
					table.insert(low, pc.get_name())
				end
				if nemere_dungeon.must_rest(now) then
					table.insert(wait, pc.get_name())
				end
				if nemere_dungeon.over_limit() then table.insert(full, pc.get_name()) end
				if nemere_dungeon.too_poor() then table.insert(poor, pc.get_name()) end
			end
			if table.getn(low) > 0 then
				say("Za s³abi, by wejœæ (poziom "..c.min_level.."+):")
				for i, n in next, low, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(full) > 0 then
				say("Dzisiejsze wyprawy do tego lochu ju¿ wykorzystane ("..c.daily.." dziennie):")
				for i, n in next, full, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(poor) > 0 then
				say("Wejœcie kosztuje "..c.fee_text.." Yang - za ma³o przy sobie:")
				for i, n in next, poor, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(wait) > 0 then
				say("Jeszcze nie odpoczêli po poprzedniej wyprawie:")
				for i, n in next, wait, nil do say(color(1,1,0).."    "..n) end
				local left = c.cooldown - (now - pc.getf("nemere_dungeon", "entry"))
				if left > 0 then
					say("")
					say("Ty mo¿esz wejœæ za "..math.ceil(left / 60).." min.")
				end
				return
			end
			say("Dru¿yna na tej mapie wejdzie razem z tob¹.")
			if select("Otwórz przejœcie", "Nie teraz") ~= 1 then
				return
			end
			if not nemere_dungeon.lobby_create(humans) then
				say_title(mob_name(20397))
				say("Nie uda³o siê otworzyæ przejœcia. Spróbuj ponownie za chwilê.")
			end
		end

		-- A player alone, sent by the guard, goes into a new instance a second after the lobby
		-- loads - no walk to the lion. Anything that stops it leaves him at the lion.
		when nemere_auto.timer begin
			local c = nemere_dungeon.cfg()
			if pc.get_map_index() ~= c.map or party.is_party() then
				return
			end
			local now = get_global_time()
			if pc.get_level() < c.min_level or (nemere_dungeon.must_rest(now)) then
				syschat("Lodowa Kraina: porozmawiaj z Kamiennym Lwem, aby otworzyæ przejœcie.")
				return
			end
			if not nemere_dungeon.lobby_create({pc.get_player_id()}) then
				syschat("Lodowa Kraina: nie uda³o siê otworzyæ przejœcia - porozmawiaj z Kamiennym Lwem.")
			end
		end

		when login begin
			local c = nemere_dungeon.cfg()
			local idx = pc.get_map_index()
			if idx == c.map then
				-- The lobby (fallback only).
				if pc.is_playerbot() then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
					return
				end
				pc.set_warp_location(c.exit_map, c.exit_x, c.exit_y)
				pc.setf("nemere_dungeon", "pending", 0)
				if pc.getf("nemere_dungeon", "auto") == 1 and not party.is_party() then
					pc.setf("nemere_dungeon", "auto", 0)
					syschat("Lodowa Kraina: przejœcie siê otwiera...")
					timer("nemere_auto", 1)
				else
					pc.setf("nemere_dungeon", "auto", 0)
					syschat("Lodowa Kraina: porozmawiaj z Kamiennym Lwem, aby otworzyæ przejœcie.")
				end
			elseif nemere_dungeon.inside() then
				if pc.is_playerbot() then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
					return
				end
				pc.set_warp_location(c.exit_map, c.exit_x, c.exit_y)
				pc.setf("nemere_dungeon", "inside", 1)
				pc.setf("nemere_dungeon", "pending", 0)
				if pc.getf("nemere_dungeon", "idx") ~= idx then
					if not nemere_dungeon.pay_entry() then -- MT2009_PLUS_DUNGEON_FEE_V1
						pc.warp(c.exit_x * 100, c.exit_y * 100)
						return
					end
					pc.setf("nemere_dungeon", "idx", idx)
					pc.setf("nemere_dungeon", "entry", get_global_time())
				end
				if d.getf("init") == 0 then
					nemere_dungeon.init()
				end
				if d.getf("closed") == 1 then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
				elseif d.getf("step") == 0 then
					d.notice("Nemere: Porozmawiaj z Kamiennym Lwem, aby rozpocz¹æ wyprawê.")
				end
			elseif pc.getf("nemere_dungeon", "inside") == 1 then
				pc.setf("nemere_dungeon", "inside", 0)
				for v = 30760, 30762 do
					if pc.count_item(v) > 0 then pc.remove_item(v, pc.count_item(v)) end
				end
			end
		end

		when 20397.chat."Rozpocznij wyprawê na Nemere" with nemere_dungeon.inside() and d.getf("step") == 0 begin
			local c = nemere_dungeon.cfg()
			say_title(mob_name(20397))
			if party.is_party() and d.getf("leader") ~= pc.get_player_id() then
				say("Tylko przywódca wyprawy mo¿e obudziæ lwa.")
				return
			end
			say("Lew budzi siê, a z mrozu wychodz¹ potwory...")
			npc.purge()
			d.setf("step", 1)
			d.setf("kills", 0)
			d.setf("ready", 1)
			nemere_dungeon.spawn_room(c.path.."zone_1.txt")
			d.notice("Nemere: "..nemere_dungeon.step_text(1))
		end

		when nemere_step.server_timer begin
			if d.select(get_server_timer_arg()) then
				local c = nemere_dungeon.cfg()
				local step = d.getf("step")
				local room = c.rooms[step]
				if room then
					d.jump_all(c.base_x + room[1], c.base_y + room[2])
				end
				if step == 2 then
					d.set_regen_file(c.path.."zone_2.txt")
				elseif step == 3 then
					nemere_dungeon.spawn_room(c.path.."zone_3.txt")
				elseif step == 4 then
					nemere_dungeon.spawn_room(c.path.."zone_4.txt")
				elseif step == 5 then
					for i = 1, table.getn(c.seals) do
						d.spawn_mob(20398, c.seals[i][1], c.seals[i][2])
					end
					d.setf("seals", table.getn(c.seals))
					d.set_regen_file(c.path.."zone_5.txt")
				elseif step == 6 then
					nemere_dungeon.spawn_target(1, 8058, c.metin6[1], c.metin6[2]) -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
					nemere_dungeon.watch_start(1)
					-- MT2009_PLUS_RZNM_OFFICIAL_V2: the official floors 6, 7, 9 and 10 have their monsters too
					-- (Owsap's sd_6/7/9/10, once); the step's goal is still its Metin / Szels / Pillar / Nemere.
					d.regen_file(c.path.."zone_6.txt")
				elseif step == 7 then
					d.regen_file(c.path.."zone_7.txt")
					for i = 1, table.getn(c.szel) do
						nemere_dungeon.spawn_target(i, 6151, c.szel[i][1], c.szel[i][2]) -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
					end
					nemere_dungeon.watch_start(table.getn(c.szel))
				elseif step == 8 then
					d.set_regen_file(c.path.."zone_8.txt")
				elseif step == 9 then
					nemere_dungeon.spawn_target(1, 20399, c.pillar[1], c.pillar[2]) -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
					nemere_dungeon.watch_start(1)
					d.regen_file(c.path.."zone_9.txt")
				elseif step == 10 then
					d.spawn_mob(6191, c.boss[1], c.boss[2])
					d.regen_file(c.path.."zone_10.txt")
				end
				d.setf("ready", 1)
				d.notice("Nemere: "..nemere_dungeon.step_text(step))
			end
		end

		when nemere_tick.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("closed") == 1 then
					return
				end
				local left = d.getf("left") - 1
				d.setf("left", left)
				nemere_dungeon.room_check()
				if left <= 0 then
					d.notice("Nemere: Czas min¹³. Mróz wyrzuca was z Lodowej Krainy.")
					nemere_dungeon.finish()
					return
				end
				if left == 30 or left == 15 or left == 10 or left == 5 or left == 1 then
					d.notice("Nemere: Pozosta³o "..left.." min.")
				end
				server_timer("nemere_tick", 60, get_server_timer_arg())
			end
		end

		-- MT2009_PLUS_BOT_DUNGEON_RUNS_V1: the start of an ordinary bot party's run (playerbot_dungeon_runs.h).
		-- The bots cannot answer the guard's dialog, so the core makes the instance itself, marks it with
		-- the dungeon flag mt2009_dgrun - nothing a player can set - and asks for this. Unlike the test
		-- cohort's (mt2009_dgbot) such a run keeps the player's time limit and the player's way out.
		when nemere_dgrun.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("mt2009_dgrun") == 1 and d.getf("init") == 0 then
					nemere_dungeon.init()
				end
			end
		end

		-- MT2009_PLUS_BOT_DUNGEON_RUNS_V1: the stone lion's start for a bots' run, asked by the core once the
		-- instance is set up: what the leader's "Rozpocznij wyprawê na Nemere" does, without the dialog (the
		-- lion stays standing - an NPC no bot looks at).
		when nemere_dgrun_next.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("mt2009_dgrun") ~= 1 or d.getf("init") == 0 or d.getf("closed") == 1 or d.getf("step") ~= 0 then
					return
				end
				local c = nemere_dungeon.cfg()
				d.setf("step", 1)
				d.setf("kills", 0)
				d.setf("ready", 1)
				nemere_dungeon.spawn_room(c.path.."zone_1.txt")
				d.notice("Nemere: "..nemere_dungeon.step_text(1))
			end
		end

		-- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1: the step's kills and targets, every target_watch seconds.
		when nemere_watch.server_timer begin
			if d.select(get_server_timer_arg()) then
				if nemere_dungeon.watch_targets() then
					clear_server_timer("nemere_watch", get_server_timer_arg()) -- MT2009_PLUS_QUEST_LOG_SPAM_V1: bez "already registered"
					server_timer("nemere_watch", nemere_dungeon.cfg().target_watch, get_server_timer_arg())
				end
			end
		end

		-- MT2009_PLUS_DUNGEON_BOSS_EXIT_10S_V1: the countdown after the last boss (end_count), a second at a time.
		when nemere_end.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("closed") == 1 then
					return
				end
				nemere_dungeon.end_count(d.getf("end_in"))
			end
		end

		when kill with nemere_dungeon.inside() and d.getf("ready") == 1 begin
			local c = nemere_dungeon.cfg()
			local step = d.getf("step")
			local race = npc.get_race()
			if race < 6101 or race > 6199 then
				return
			end
			if step == 1 or step == 3 or step == 4 then
				d.setf("kills", d.getf("kills") + 1)
				if d.getf("kills") >= d.getf("room") then
					nemere_dungeon.go(step + 1)
				end
			elseif step == 2 then
				if number(1, 1000) <= c.key_permille then
					game.drop_item_with_ownership(30760, 1, 60)
				end
			elseif step == 5 then
				if number(1, 1000) <= c.crystal_permille then
					game.drop_item_with_ownership(30761, 1, 60)
				end
			elseif step == 8 then
				if number(1, 1000) <= c.key_permille then
					game.drop_item_with_ownership(30762, 1, 60)
				end
			end
		end

		when 30760.use with nemere_dungeon.inside() begin
			if d.getf("step") == 2 and d.getf("ready") == 1 then
				pc.remove_item(30760, 1)
				d.notice("Nemere: Lodowy Klucz otworzy³ przejœcie.")
				nemere_dungeon.go(3)
			else
				syschat("Ten klucz nie pasuje teraz do niczego.")
			end
		end

		when 30762.use with nemere_dungeon.inside() begin
			if d.getf("step") == 8 and d.getf("ready") == 1 then
				pc.remove_item(30762, 1)
				d.notice("Nemere: Klucz Mrozu otworzy³ przejœcie.")
				nemere_dungeon.go(9)
			else
				syschat("Ten klucz nie pasuje teraz do niczego.")
			end
		end

		when 20398.take with nemere_dungeon.inside() and d.getf("step") == 5 and d.getf("ready") == 1 begin
			if item.vnum == 30761 then
				item.remove()
				npc.purge()
				d.setf("seals", d.getf("seals") - 1)
				if d.getf("seals") <= 0 then
					nemere_dungeon.go(6)
				else
					d.notice("Nemere: Pieczêæ z³amana. Pozosta³o: "..d.getf("seals"))
				end
			else
				say_title(mob_name(20398))
				say("Pieczêæ przyjmie tylko Kryszta³ Lodu.")
			end
		end

		when 8058.kill with nemere_dungeon.inside() and d.getf("step") == 6 and d.getf("ready") == 1 begin
			nemere_dungeon.target_down(npc.get_vid()) -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
			nemere_dungeon.go(7)
		end

		when 6151.kill with nemere_dungeon.inside() and d.getf("step") == 7 and d.getf("ready") == 1 begin
			nemere_dungeon.target_down(npc.get_vid()) -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
			d.setf("kills", d.getf("kills") + 1)
			if d.getf("kills") >= 4 then
				nemere_dungeon.go(8)
			else
				d.notice("Nemere: Szel pokonany ("..d.getf("kills").."/4).")
			end
		end

		when 20399.kill with nemere_dungeon.inside() and d.getf("step") == 9 and d.getf("ready") == 1 begin
			nemere_dungeon.target_down(npc.get_vid()) -- MT2009_PLUS_DUNGEON_TARGET_WATCH_V1
			nemere_dungeon.go(10)
		end

		when 6191.kill with nemere_dungeon.inside() and d.getf("step") == 10 and d.getf("ready") == 1 begin
			d.setf("step", 11)
			local people = nemere_dungeon.give_chests()
			d.update_ranking("nemere") -- MT2009_PLUS_DUNGEON_PANEL_V1: the dungeon panel's results
			d.clear_regen()
			nemere_dungeon.purge_mobs()
			d.notice("Nemere zosta³ pokonany!")
			-- MT2009_PLUS_DUNGEON_BOSS_EXIT_60S_V1: a minute to pick the loot up (was 10 seconds:
			-- MT2009_PLUS_DUNGEON_BOSS_EXIT_10S_V1); a bot-only run has no loot and keeps its 10 seconds.
			if people > 0 then
				nemere_dungeon.end_count(60)
			else
				nemere_dungeon.end_count(10)
			end
		end

		-- MT2009_PLUS_RZNM_BERAN_ANY_LEVEL_V1 (the owner, 15 October 2026, fix 6): Nemere killed outside her dungeon (a GM's
		-- /m - no map spawns her) drops the same set as in it (give_chests: the chests and the boss's extra drop on the
		-- ground round her, for the people of the killer's party on her map), at any level of the killer, Champion levels
		-- too. The engine gives her no items of its own (item_manager.cpp), so before this a /m Nemere dropped nothing.
		when 6191.kill with not nemere_dungeon.inside() begin
			nemere_dungeon.give_chests()
		end
	end
end
