-- MT2009_PLUS_YOHARA_CRACK_V1: Zaklêty Las (SZC) i Erebu (SZC) - loch Szczeliny Czasu z Jotunem Thrymem (SZC) (404,
-- metin2_map_boss_crack_dawnmist - teren lochu Zaklêtego Lasu w miejscu z Owsapa; pl-wiki "Zaklêty Las (SZC)",
-- "Erebu (SZC)", "Jotun Thrym (SZC)", "Bagjanamu (SZC)", "W³adca En-Tai (SZC)", "Kamieñ Driad (SZC)" i szeœæ misji
-- lasu: "Pierwszy rekonesans (SZC)", "ZnajdŸ apteczkê (SZC)", "Dostarcz apteczkê (SZC)", "Drugi rekonesans (SZC)",
-- "Zdob¹dŸ Rosy En-Tai (SZC)", "Zabij w³adcê En-Tai (SZC)"; przebieg i pozycje jak Owsap v6.2.6
-- crack_dawnmist_dungeon.quest i crack_dawnmist_dungeon_access.quest, liczby i nagrody wg wiki). Wejœcie: Statua
-- Szczeliny Czasu na P³askowy¿u Iluzji (quest szczelina_czasu).
--   Misje (ka¿dy gracz osobno, od nowa w ka¿dej wyprawie - jak Owsap; licznik zabójstw grupy siê liczy):
--   1. Pierwszy rekonesans (SZC) - Stra¿nik Lasu (SZC) (20519): zabij 50 Wojowników En-Tai (SZC-107) (4260);
--      776 600 PD;
--   2. ZnajdŸ apteczkê (SZC) - Druid En-Tai (SZC-111) (4262) ma Apteczkê (SZC) (31166, 1 na 25) - do Stra¿nika;
--      776 600 PD;
--   3. Dostarcz apteczkê (SZC) - od Stra¿nika do Zwiadowcy Lasu (SZC) (20520); 5 582 500 PD i 10 Korzeni Gango;
--   4. Drugi rekonesans (SZC) - Zwiadowca: zniszcz 5 Metinów Drzewnych Stworzeñ (SZC) (8126); 7 766 000 PD;
--   5. Zdob¹dŸ Rosy En-Tai (SZC) - 5 Niszczycieli En-Tai (SZC-113) (4264), ka¿dy daje Rosê (31163) - do Zwiadowcy;
--      7 766 000 PD i 10 Wody Young;
--   6. Zabij w³adcê En-Tai (SZC) - Badacz Lasu (SZC) (20521): Szlachetne Drewno (SZC) (31162) z W³adcy En-Tai (SZC)
--      (4265) - 11 650 000 PD; potem Drzewny Szmaragd (SZC) (31165) z W³adcy - 11 650 000 PD i Kamieñ Driad (SZC)
--      (31161).
--   Przywódca Stra¿y Lasu (SZC) (20522): "Pomieszczenie bossa" - przywódca grupy, ca³a grupa przy nim, ka¿dy ma Kamieñ
--   Driad (SZC) (zabierany) - Erebu: Bagjanamu (SZC) (4272), minutê po nim Jotun Thrym (SZC) (4403, wiatr, 135 poz.;
--   przywo³uje Niszczycieli En-Tai (SZC-125)).
-- Potwory nie daj¹ dropu (wiki) - silnik nie upuszcza niczego na mapie 404 poza Yangami Jotuna Thryma (SZC)
-- (server-patches/szczelina); daj¹ wiêcej PD (rzêdy "TR:" w bazie). 60 minut od wejœcia; po zwyciêstwie (minuta) lub po
-- czasie wszyscy wracaj¹ na P³askowy¿ Iluzji (obok Statuy Szczeliny Czasu). Zegarek Kieszonkowy znika przy pierwszym
-- wejœciu do nowej wyprawy. Panel lochów: jotun_szc. Boty nie wchodz¹ same - wyprawy botów (MT2009_PLUS_BOT_YOHARA_SZC_V1) przez jotun_szc_dgrun.
-- cp1250; ¿aden napis nie koñczy siê polsk¹ liter¹ (qc).
quest jotun_szc begin
	state start begin
		function cfg()
			return {
				map = 404, base_x = 3328, base_y = 18176,
				entry = {478, 970}, boss_room = {99, 941}, boss = {69, 941},
				path = "data/dungeon/jotun_szc/",
				warriors = 50, kit_chance = 25, stones = 5, destroyers = 5,
				exp = {776600, 776600, 5582500, 7766000, 7766000, 11650000, 11650000},
				gango = 50724, gango_count = 10, young = 50816, young_count = 10,
				dryad = 31161, timber = 31162, dew = 31163, emerald = 31165, kit = 31166,
				boss_delay = 60, limit = 3600, keep = 3600 + 300, ticket = 31147, end_sec = 60,
			}
		end

		function inside()
			local idx = pc.get_map_index()
			return idx >= 404 * 10000 and idx < 405 * 10000 and pc.in_dungeon()
		end

		function out()
			local m, x, y = pc.getf("szczelina_czasu", "ret_map"), pc.getf("szczelina_czasu", "ret_x"),
				pc.getf("szczelina_czasu", "ret_y")
			if m > 0 then
				pc.warp(x * 100, y * 100, m)
			else
				warp_to_village()
			end
		end

		function finish(text)
			d.setf("closed", 1)
			d.setf("mt2009_keep_until", 0)
			if text then
				d.notice(text)
			end
			d.exit_all()
		end

		function init()
			local c = jotun_szc.cfg()
			d.setf("init", 1)
			d.setf("start", get_global_time())
			d.setf("mt2009_keep_until", get_global_time() + c.keep)
			d.setf("level", 0)
			d.set_regen_file(c.path.."npc.txt")
			d.set_regen_file(c.path.."regen.txt")
			d.set_regen_file(c.path.."boss.txt")
			d.set_regen_file(c.path.."stone.txt")
			d.notice("Zaklêty Las (SZC): masz 60 minut. Stra¿nik Lasu (SZC) czeka na ciebie.")
			d.notice("Potwory Szczeliny Czasu nie daj¹ dropu, ale daj¹ wiêcej PD.")
			server_timer("jotun_szc_tick", 60, d.get_map_index())
		end

		-- a new expedition: the tasks from the beginning, the items of an old one gone
		function reset()
			local c = jotun_szc.cfg()
			pc.setqf("st", 10)
			pc.setqf("cnt", 0)
			for i, v in ipairs({c.dryad, c.timber, c.dew, c.emerald, c.kit}) do
				if pc.count_item(v) > 0 then
					pc.remove_item(v, pc.count_item(v))
				end
			end
		end

		function reward(n, text)
			local c = jotun_szc.cfg()
			pc.give_exp2(c.exp[n])
			say_reward("Nagroda: "..c.exp[n].." PD.")
			if text then
				say(text)
			end
		end

		function count(n, total, text)
			pc.setqf("cnt", n)
			if n < total then
				syschat(text..": "..n.." / "..total..".")
			end
		end

		-- MT2009_PLUS_BOT_SZC_BOSS_V1 (night 6/7 November 2026, the owner: "boty maja przejsc wszystkie dungeony, ktorych
		-- jeszcze nie robily"): a bots' run (mt2009_dgrun) with the event flag m2_bot_szc_boss = 1 does the six missions
		-- as one party - the same kills (50 Wojownikow En-Tai, the Druid's kit 1 in 25, 5 Metinow Drzewnych Stworzen,
		-- 5 Niszczycieli En-Tai, the Wladca En-Tai twice), counted on the dungeon (flags bm = the mission, bc = its count)
		-- instead of each man's quest state and the talks; then the boss room opens as at Przywodca Strazy Lasu (no
		-- Kamien Driad and no mission rewards for bots). The flag 0 (the default): the bots only hunt (21 October).
		-- Players: nothing changes.
		function bot_on()
			-- MT2009_PLUS_BOT_SZC_MODES_V1: a boss run of the bots carries mt2009_szc_boss (the pairs only hunt)
			return d.getf("mt2009_dgrun") == 1 and d.getf("mt2009_szc_boss") == 1 and d.getf("closed") == 0 and
				d.getf("level") == 0
		end

		function bot_next(m)
			d.setf("bm", m)
			d.setf("bc", 0)
			d.setf("bm_at", get_global_time())
		end

		function bot_kill(race)
			local c = jotun_szc.cfg()
			if not jotun_szc.bot_on() then
				return
			end
			local m = d.getf("bm")
			if m == 0 then
				m = 1
				jotun_szc.bot_next(1)
			end
			if m == 1 and race == 4260 then
				d.setf("bc", d.getf("bc") + 1)
				if d.getf("bc") >= c.warriors then
					jotun_szc.bot_next(2)
				end
			elseif m == 2 and race == 4262 then
				d.setf("bc", d.getf("bc") + 1)
				if number(1, c.kit_chance) == 1 then
					-- the kit to the Straznik and on to the Zwiadowca: missions 2 and 3 at once
					jotun_szc.bot_next(4)
				end
			elseif m == 4 and race == 8126 then
				d.setf("bc", d.getf("bc") + 1)
				if d.getf("bc") >= c.stones then
					jotun_szc.bot_next(5)
				end
			elseif m == 5 and race == 4264 then
				d.setf("bc", d.getf("bc") + 1)
				if d.getf("bc") >= c.destroyers then
					jotun_szc.bot_next(6)
				end
			elseif (m == 6 or m == 7) and race == 4265 then
				jotun_szc.bot_next(m + 1)
				if m + 1 == 8 then
					server_timer("jotun_szc_botboss", 5, d.get_map_index())
				end
			end
		end

		when login with jotun_szc.inside() begin
			local c = jotun_szc.cfg()
			local idx = pc.get_map_index()
			if pc.is_playerbot() then
				return
			end
			local m = pc.getf("szczelina_czasu", "ret_map")
			if m > 0 then
				pc.set_warp_location(m, pc.getf("szczelina_czasu", "ret_x"), pc.getf("szczelina_czasu", "ret_y"))
			end
			if d.getf("closed") == 1 then
				syschat("Zaklêty Las (SZC): ta wyprawa ju¿ siê skoñczy³a.")
				jotun_szc.out()
				return
			end
			if pc.getf("szczelina_czasu", "idx") ~= idx then
				if not pc.is_gm() then
					if pc.count_item(c.ticket) < 1 then
						syschat("Zaklêty Las (SZC): potrzebujesz Zegarka Kieszonkowego.")
						jotun_szc.out()
						return
					end
					pc.remove_item(c.ticket, 1)
				end
				pc.setf("szczelina_czasu", "idx", idx)
				pc.setf("szczelina_czasu", "entry", get_global_time())
				jotun_szc.reset()
			end
			d.setf("entered", 1)
			if d.getf("init") == 0 then
				jotun_szc.init()
			end
			if d.getf("level") == 2 and math.abs(pc.get_local_y() - c.boss_room[2]) > 80 then
				pc.warp((c.base_x + c.boss_room[1]) * 100, (c.base_y + c.boss_room[2]) * 100, idx)
			end
		end

		-- the time
		when jotun_szc_tick.server_timer begin
			local c = jotun_szc.cfg()
			if not d.select(get_server_timer_arg()) or d.getf("closed") == 1 then
				return
			end
			local left = d.getf("start") + c.limit - get_global_time()
			if left <= 0 then
				jotun_szc.finish("Zaklêty Las (SZC): czas min¹³ - wracacie na P³askowy¿ Iluzji.")
				return
			end
			local m = math.floor((left + 30) / 60)
			if m == 45 or m == 30 or m == 15 or m == 5 or m == 1 then
				d.notice("Zaklêty Las (SZC): zosta³o "..m.." min. Po czasie grupa wróci na P³askowy¿ Iluzji.")
			end
			server_timer("jotun_szc_tick", 60, get_server_timer_arg())
		end

		-- Stra¿nik Lasu (SZC): missions 1-3
		when 20519.chat."Rekonesans Szczeliny Czasu" with jotun_szc.inside() begin
			local c = jotun_szc.cfg()
			local st = pc.getqf("st")
			say_title(mob_name(20519)..":")
			if st == 10 then
				say("Zaklêty Las w Szczelinie Czasu zmieni³ swe oblicze,")
				say("a te zmiany s¹ bardzo niepokoj¹ce. Moi bracia")
				say("zaginêli, a z nimi apteczka. Podejrzewam wojowników")
				say("En-Tai, bo zachowuj¹ siê co najmniej dziwnie.")
				say_reward("Zabij "..c.warriors.." Wojowników En-Tai (SZC) i wróæ do mnie.")
				pc.setqf("st", 11)
				pc.setqf("cnt", 0)
			elseif st == 11 then
				say("Wojownicy En-Tai (SZC) wci¹¿ kr¹¿¹ po lesie. Pokonaj")
				say("ich: "..pc.getqf("cnt").." / "..c.warriors..".")
			elseif st == 12 then
				say("Pokona³eœ Wojowników En-Tai, ale apteczki nie mieli.")
				say("To dziwna kreatura jest wszystkiemu winna - Druid")
				say("En-Tai (SZC). Zabijaj druidów, a¿ zdobêdziesz")
				say("apteczkê.")
				jotun_szc.reward(1)
				pc.setqf("st", 21)
			elseif st == 21 then
				say("Druid En-Tai (SZC) musi byæ gdzieœ w pobli¿u. Zabierz")
				say("mu apteczkê.")
			elseif st == 22 then
				if pc.count_item(c.kit) < 1 then
					say("Gdzie jest apteczka? Odbierz j¹ Druidowi En-Tai.")
					pc.setqf("st", 21)
					return
				end
				pc.remove_item(c.kit, 1)
				say("Wszystko w niej jest. Odpocznij chwilê - zaraz")
				say("zaniesiesz j¹ moim braciom.")
				jotun_szc.reward(2)
				pc.setqf("st", 30)
			elseif st == 30 then
				say("Nadszed³ czas, by dostarczyæ apteczkê Zwiadowcy")
				say("Lasu (SZC). Uwa¿aj, by po drodze niczego nie zgubiæ!")
				if pc.count_item(c.kit) < 1 then
					pc.give_item2(c.kit, 1)
				end
				pc.setqf("st", 31)
			elseif st == 31 then
				say("Zanieœ apteczkê (SZC) Zwiadowcy Lasu (SZC).")
				if pc.count_item(c.kit) < 1 then
					pc.give_item2(c.kit, 1)
				end
			else
				say("Dziêkujê ci za pomoc, wojowniku. Las jest ci wdziêczny.")
			end
		end

		-- Zwiadowca Lasu (SZC): missions 3-5
		when 20520.chat."Rekonesans Szczeliny Czasu" with jotun_szc.inside() begin
			local c = jotun_szc.cfg()
			local st = pc.getqf("st")
			say_title(mob_name(20520)..":")
			if st == 31 then
				if pc.count_item(c.kit) < 1 then
					say("Stra¿nik Lasu mia³ mi przys³aæ apteczkê - wróæ po ni¹.")
					pc.setqf("st", 30)
					return
				end
				pc.remove_item(c.kit, 1)
				say("Apteczka! Podziwiam twoj¹ odwagê - jak ci siê uda³o")
				say("tutaj dotrzeæ? WeŸ te Korzenie Gango.")
				jotun_szc.reward(3)
				pc.give_item2(c.gango, c.gango_count)
				pc.setqf("st", 40)
			elseif st == 40 then
				say("Metiny Drzewnych Stworzeñ zatruwaj¹ ten las.")
				say_reward("Zniszcz "..c.stones.." Metinów Drzewnych Stworzeñ (SZC).")
				pc.setqf("st", 41)
				pc.setqf("cnt", 0)
			elseif st == 41 then
				say("Zniszczone Metiny: "..pc.getqf("cnt").." / "..c.stones..".")
			elseif st == 42 then
				say("Dobra robota. Las od razu oddycha l¿ej.")
				jotun_szc.reward(4)
				pc.setqf("st", 50)
			elseif st == 50 then
				say("Legenda g³osi, ¿e ros¹ En-Tai mo¿na przegnaæ z³e")
				say("demony. Najlepiej zdobyæ j¹ od Niszczycieli En-Tai.")
				say_reward("Zdob¹dŸ "..c.destroyers.." Ros En-Tai (SZC).")
				pc.setqf("st", 51)
				pc.setqf("cnt", 0)
			elseif st == 51 then
				say("Rosy En-Tai (SZC): "..pc.getqf("cnt").." / "..c.destroyers..".")
			elseif st == 52 then
				if pc.count_item(c.dew) < c.destroyers then
					say("Brakuje ci Ros En-Tai (SZC). Zdob¹dŸ je od")
					say("Niszczycieli En-Tai.")
					pc.setqf("st", 51)
					pc.setqf("cnt", pc.count_item(c.dew))
					return
				end
				pc.remove_item(c.dew, c.destroyers)
				say("Wspaniale! WeŸ tê Wodê Young. Badacz Lasu (SZC)")
				say("czeka na ciebie - on wie, gdzie szukaæ W³adców")
				say("En-Tai.")
				jotun_szc.reward(5)
				pc.give_item2(c.young, c.young_count)
				pc.setqf("st", 60)
			elseif st < 31 then
				say("Stra¿nik Lasu (SZC) potrzebuje twojej pomocy.")
			else
				say("Dziêkujê ci za pomoc, wojowniku.")
			end
		end

		-- Badacz Lasu (SZC): mission 6 (Zabij w³adcê En-Tai (SZC))
		when 20521.chat."Rekonesans Szczeliny Czasu" with jotun_szc.inside() begin
			local c = jotun_szc.cfg()
			local st = pc.getqf("st")
			say_title(mob_name(20521)..":")
			if st == 60 then
				say("Sam bym tego dokona³, ale mój miecz stêpi³ siê w")
				say("licznych walkach. OdnajdŸ W³adcê En-Tai (SZC) i")
				say("przynieœ mi jego szlachetne drewno.")
				pc.setqf("st", 61)
			elseif st == 61 then
				say("W³adca En-Tai (SZC) wci¹¿ ¿yje. Przynieœ mi jego")
				say("szlachetne drewno.")
			elseif st == 62 then
				if pc.count_item(c.timber) < 1 then
					say("Gdzie jest Szlachetne Drewno (SZC)? Pokonaj W³adcê.")
					pc.setqf("st", 61)
					return
				end
				pc.remove_item(c.timber, 1)
				say("To nie jest przedmiot, którego potrzebujê... Wróæ,")
				say("idŸ jeszcze raz do W³adców En-Tai i przynieœ mi Drzewny")
				say("Szmaragd (SZC).")
				jotun_szc.reward(6)
				pc.setqf("st", 71)
			elseif st == 71 then
				say("W³adcy En-Tai (SZC) nie zdradz¹ nam ³atwo, gdzie")
				say("przebywa ich król. Przynieœ mi Drzewny Szmaragd.")
			elseif st == 72 then
				if pc.count_item(c.emerald) < 1 then
					say("Gdzie jest Drzewny Szmaragd (SZC)? Pokonaj W³adcê.")
					pc.setqf("st", 71)
					return
				end
				pc.remove_item(c.emerald, 1)
				say("Oto on! WeŸ ten Kamieñ Driad (SZC) - driada zna")
				say("zaklête s³owa, które otworz¹ ci drogê do Erebu.")
				say("Przywódca Stra¿y Lasu (SZC) ciê tam zaprowadzi.")
				jotun_szc.reward(7)
				pc.give_item2(c.dryad, 1)
				pc.setqf("st", 80)
			elseif st < 60 then
				say("Najpierw pomó¿ Stra¿nikowi i Zwiadowcy Lasu (SZC).")
			else
				say("Przywódca Stra¿y Lasu (SZC) zaprowadzi was do Erebu.")
			end
		end

		-- the kills of the missions (the killer and his group)
		when 4260.kill or 4260.party_kill with jotun_szc.inside() and pc.getqf("st") == 11 begin
			local c = jotun_szc.cfg()
			local n = pc.getqf("cnt") + 1
			jotun_szc.count(n, c.warriors, "Wojownicy En-Tai (SZC)")
			if n >= c.warriors then
				pc.setqf("st", 12)
				syschat("Uda³o ci siê pokonaæ Wojowników En-Tai (SZC). Wróæ do Stra¿nika Lasu (SZC).")
			end
		end

		when 4262.kill or 4262.party_kill with jotun_szc.inside() and pc.getqf("st") == 21 begin
			local c = jotun_szc.cfg()
			if number(1, c.kit_chance) == 1 and pc.enough_inventory(c.kit) then
				pc.give_item2(c.kit, 1)
				pc.setqf("st", 22)
				syschat("Druid En-Tai mia³ przy sobie apteczkê (SZC). Zanieœ j¹ Stra¿nikowi Lasu (SZC).")
			end
		end

		when 8126.kill or 8126.party_kill with jotun_szc.inside() and pc.getqf("st") == 41 begin
			local c = jotun_szc.cfg()
			local n = pc.getqf("cnt") + 1
			jotun_szc.count(n, c.stones, "Metiny Drzewnych Stworzeñ (SZC)")
			if n >= c.stones then
				pc.setqf("st", 42)
				syschat("Metiny zniszczone. Wróæ do Zwiadowcy Lasu (SZC).")
			end
		end

		when 4264.kill or 4264.party_kill with jotun_szc.inside() and pc.getqf("st") == 51 begin
			local c = jotun_szc.cfg()
			if not pc.enough_inventory(c.dew) then
				return
			end
			pc.give_item2(c.dew, 1)
			local n = pc.getqf("cnt") + 1
			jotun_szc.count(n, c.destroyers, "Rosy En-Tai (SZC)")
			if n >= c.destroyers then
				pc.setqf("st", 52)
				syschat("Uda³o ci siê zdobyæ Rosy En-Tai (SZC). Zanieœ je Zwiadowcy Lasu (SZC).")
			end
		end

		when 4265.kill or 4265.party_kill with jotun_szc.inside() and (pc.getqf("st") == 61 or pc.getqf("st") == 71) begin
			local c = jotun_szc.cfg()
			local st = pc.getqf("st")
			local v = st == 61 and c.timber or c.emerald
			if not pc.enough_inventory(v) then
				return
			end
			pc.give_item2(v, 1)
			pc.setqf("st", st + 1)
			syschat("W³adca En-Tai (SZC) pokonany. Wróæ do Badacza Lasu (SZC).")
		end

		-- MT2009_PLUS_BOT_SZC_BOSS_V1: the bots' party's kills (a bots' run only - no man has a quest state there)
		when 4260.kill or 4262.kill or 8126.kill or 4264.kill or 4265.kill with jotun_szc.inside() and d.getf("mt2009_dgrun") == 1 begin
			jotun_szc.bot_kill(npc.get_race())
		end

		-- MT2009_PLUS_BOT_SZC_BOSS_V1: the six missions done - the boss room as the leader's talk opens it
		when jotun_szc_botboss.server_timer begin
			local c = jotun_szc.cfg()
			if d.select(get_server_timer_arg()) and d.getf("mt2009_dgrun") == 1 and d.getf("closed") == 0 and
					d.getf("level") == 0 and d.getf("bm") == 8 then
				d.setf("level", 2)
				d.clear_regen()
				d.kill_all()
				d.jump_all(c.base_x + c.boss_room[1], c.base_y + c.boss_room[2])
				d.spawn_mob(4272, c.boss[1], c.boss[2])
				d.notice("Erebu (SZC): Bagjanamu (SZC) strze¿e drogi do Jotuna Thryma!")
			end
		end

		-- Przywódca Stra¿y Lasu (SZC): Erebu
		when 20522.chat."Pomieszczenie bossa" with jotun_szc.inside() and d.getf("closed") == 0 and d.getf("level") == 0 and npc.lock() begin
			local c = jotun_szc.cfg()
			say_title(mob_name(20522)..":")
			if not pc.is_gm() and not party.is_party() then
				say("Do Erebu wchodzi siê tylko w grupie.")
				npc.unlock()
				return
			end
			if party.is_party() and not party.is_leader() and not pc.is_gm() then
				say("Tylko przywódca grupy mo¿e poprowadziæ was dalej.")
				npc.unlock()
				return
			end
			if party.is_party() and not d.all_near_to(pc.get_x(), pc.get_y()) then
				say("Cz³onek grupy jest za daleko. Zbierzcie siê przy mnie.")
				npc.unlock()
				return
			end
			say("Za t¹ bram¹ le¿y Erebu - kraina Jotuna Thryma. Ka¿dy")
			say("z was potrzebuje Kamienia Driad (SZC) od Badacza Lasu.")
			say_item_vnum(c.dryad)
			if select("WejdŸ do Erebu", "Nie teraz") ~= 1 then
				npc.unlock()
				return
			end
			local pids = {pc.get_player_id()}
			if party.is_party() then
				pids = {party.get_member_pids()}
			end
			local missing = {}
			local members = {}
			for i, pid in next, pids, nil do
				q.begin_other_pc_block(pid)
				if pc.get_player_id() == pid and not pc.is_playerbot() and pc.get_map_index() == d.get_map_index() then
					table.insert(members, pid)
					if pc.count_item(c.dryad) < 1 and not pc.is_gm() then
						table.insert(missing, pc.get_name())
					end
				end
				q.end_other_pc_block()
			end
			if table.getn(missing) > 0 then
				say_title(mob_name(20522)..":")
				say("Cz³onek grupy nie posiada przedmiotu potrzebnego,")
				say("by wejœæ:")
				say_item_vnum(c.dryad)
				for i, n in next, missing, nil do say(color(1, 1, 0).."    "..n) end
				npc.unlock()
				return
			end
			for i, pid in next, members, nil do
				q.begin_other_pc_block(pid)
				if pc.get_player_id() == pid and not pc.is_gm() then
					pc.remove_item(c.dryad, 1)
				end
				q.end_other_pc_block()
			end
			npc.unlock()
			d.setf("level", 2)
			d.clear_regen()
			d.kill_all()
			d.jump_all(c.base_x + c.boss_room[1], c.base_y + c.boss_room[2])
			d.spawn_mob(4272, c.boss[1], c.boss[2])
			d.notice("Erebu (SZC): Bagjanamu (SZC) strze¿e drogi do Jotuna Thryma!")
		end

		when 4272.kill with jotun_szc.inside() and d.getf("level") == 2 and d.getf("closed") == 0 begin
			local c = jotun_szc.cfg()
			d.notice("Bagjanamu (SZC) pokonany. Ziemia dr¿y - Jotun Thrym (SZC) nadchodzi!")
			server_timer("jotun_szc_spawn", c.boss_delay, d.get_map_index())
		end

		when jotun_szc_spawn.server_timer begin
			local c = jotun_szc.cfg()
			if d.select(get_server_timer_arg()) and d.getf("closed") == 0 then
				d.spawn_mob(4403, c.boss[1], c.boss[2])
				d.notice("Jotun Thrym (SZC) przyby³ do Erebu!")
			end
		end

		when 4403.kill with jotun_szc.inside() and d.getf("level") == 2 and d.getf("closed") == 0 begin
			local c = jotun_szc.cfg()
			d.setf("closed", 1)
			d.setf("won", 1) -- MT2009_PLUS_BOT_SZC_BOSS_V1: the bots' run reads it
			if d.getf("mt2009_dgrun") ~= 1 then
				d.update_ranking("jotun_szc", get_global_time() - d.getf("start"))
			end
			d.clear_regen()
			d.notice("Pokonaliœcie Jotuna Thryma (SZC)!")
			d.notice("Wszyscy wojownicy wróc¹ na P³askowy¿ Iluzji za minutê.")
			server_timer("jotun_szc_end", c.end_sec, d.get_map_index())
		end

		when jotun_szc_end.server_timer begin
			if d.select(get_server_timer_arg()) then
				d.setf("mt2009_keep_until", 0)
				d.exit_all()
			end
		end

		-- MT2009_PLUS_BOT_YOHARA_SZC_V1: start wyprawy botow (playerbot_dungeon_runs.h, wiersz jotun_szc): rdzen tworzy
		-- instancje, oznacza ja flaga mt2009_dgrun i prosi o init - boty tylko poluja (bez misji i kluczy, wlasciciel
		-- 21.10.2026), godzina i wyjscie jak u ludzi (jotun_szc_tick, d.exit_all).
		when jotun_szc_dgrun.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("mt2009_dgrun") == 1 and d.getf("init") == 0 then
					jotun_szc.init()
				end
			end
		end
	end
end
