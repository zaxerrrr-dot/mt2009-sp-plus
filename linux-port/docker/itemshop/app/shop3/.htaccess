Options +FollowSymLinks
RewriteEngine On
# MT2009_PLUS_ITEMSHOP_V3_V1: served under /shop3/ (the Dockerfile allows this file's overrides there only).
RewriteBase /shop3/

# The shop's code and data files are no pages.
RewriteRule ^(include|pages)/ - [F,L]

RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f

# MT2009_PLUS_ITEMSHOP_V3_V2: [B] - a search of two words ("Miecz Dokkaebi") has a space, which Apache refuses
# (403) in a rewritten query unless escaped.
RewriteRule ^search/(.*)/(.*)/ search.php?searchString=$1&max=$2 [B]
RewriteRule ^search/(.*)/(.*) search.php?searchString=$1&max=$2 [B]

RewriteRule ^search/(.*)/ index.php?p=items&searchString=$1 [B]
RewriteRule ^search/(.*) index.php?p=items&searchString=$1 [B]

# MT2009_PLUS_ITEMSHOP_V3_V1: items/<category, 0 = all>/<page>/ (header.php pages of 60)
RewriteRule ^items/([0-9]+)/([0-9]+)/ index.php?p=items&id=$1&n=$2
RewriteRule ^items/(.*)/ index.php?p=items&id=$1
RewriteRule ^items/(.*) index.php?p=items&id=$1

RewriteRule ^items/ index.php?p=items
RewriteRule ^items index.php?p=items

RewriteRule ^user/(.*)/(.*)/ index.php?p=$1&n=$2
RewriteRule ^user/(.*)/(.*) index.php?p=$1&n=$2

RewriteRule ^user/(.*)/ index.php?p=$1
RewriteRule ^user/(.*) index.php?p=$1

# MT2009_PLUS_ITEMSHOP_V3_V4: game/<window>/ - the client (exe CWebBrowser.c) opens that game window instead
# (wheel = Kolo Losu); a client or browser that cannot gets pages/shop/game.php.
RewriteRule ^game/([a-z0-9_]+) index.php?p=game&cmd=$1

RewriteRule ^home/ index.php
RewriteRule ^home index.php

RewriteRule ^logout/ index.php?p=logout
RewriteRule ^logout index.php?p=logout

RewriteRule ^wheel/(.*)/(.*)/ index.php?p=wheel&action=$1&key=$2
RewriteRule ^wheel/(.*)/(.*) index.php?p=wheel&action=$1&key=$2
RewriteRule ^wheel/(.*)/ index.php?p=wheel&action=$1
RewriteRule ^wheel/(.*) index.php?p=wheel&action=$1
RewriteRule ^wheel/ index.php?p=wheel
RewriteRule ^wheel index.php?p=wheel

# MT2009_PLUS_ITEMSHOP_V3_V2: [QSA] - the purchase link carries the quantity (?q=, pages/java/buy.php).
RewriteRule ^javascript/(.*)/(.*)/(.*)/(.*)/ index.php?p=javascript&type=$1&id=$2&new=$3&friend=$4 [QSA]
RewriteRule ^javascript/(.*)/(.*)/(.*)/(.*) index.php?p=javascript&type=$1&id=$2&new=$3&friend=$4 [QSA]
RewriteRule ^javascript/(.*)/(.*)/(.*)/ index.php?p=javascript&type=$1&id=$2&new=$3 [QSA]
RewriteRule ^javascript/(.*)/(.*)/(.*) index.php?p=javascript&type=$1&id=$2&new=$3 [QSA]
RewriteRule ^javascript/(.*)/(.*)/ index.php?p=javascript&type=$1&id=$2 [QSA]
RewriteRule ^javascript/(.*)/(.*) index.php?p=javascript&type=$1&id=$2 [QSA]

# MT2009_PLUS_ITEMSHOP_V3_V1: the package's admin panel is not shipped (our catalogue is itemshop.ishop_items).
